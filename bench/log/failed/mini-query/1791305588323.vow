let args_list = args()
if len(args_list) < 2 {
  print("error: bad query")
  return
}

let csv_text = args_list[0]
let query_text = args_list[1]

// Parse CSV
let csv_rows = lines(csv_text)
if len(csv_rows) == 0 {
  print("error: bad query")
  return
}

let header = split(csv_rows[0], ",")
let rows = []

for i in range(1, len(csv_rows)) {
  let parts = split(csv_rows[i], ",")
  if len(parts) == len(header) {
    let row = {}
    for j in range(0, len(header)) {
      row[header[j]] = parts[j]
    }
    push(rows, row)
  }
}

// Parse query
let query_parts = split(query_text, " ")
if len(query_parts) == 0 {
  print("error: bad query")
  return
}

if query_parts[0] != "SELECT" {
  print("error: bad query")
  return
}

if len(query_parts) < 2 {
  print("error: bad query")
  return
}

let select_cols = split(query_parts[1], ",")

// Validate columns in SELECT
for col in select_cols {
  let found = false
  for h in header {
    if h == col { found = true }
  }
  if not found {
    print("error: unknown column " + col)
    return
  }
}

// Parse WHERE, ORDER BY, LIMIT
let i = 2
let where_col = ""
let where_op = ""
let where_val = ""
let order_col = ""
let order_desc = false
let limit_n = 0

while i < len(query_parts) {
  let keyword = query_parts[i]

  if keyword == "WHERE" {
    if i + 3 >= len(query_parts) {
      print("error: bad query")
      return
    }
    where_col = query_parts[i + 1]
    where_op = query_parts[i + 2]
    where_val = query_parts[i + 3]

    // Validate WHERE column
    let found = false
    for h in header {
      if h == where_col { found = true }
    }
    if not found {
      print("error: unknown column " + where_col)
      return
    }

    i = i + 4
  } else if keyword == "ORDER" {
    if i + 2 >= len(query_parts) {
      print("error: bad query")
      return
    }
    if query_parts[i + 1] != "BY" {
      print("error: bad query")
      return
    }
    order_col = query_parts[i + 2]

    // Validate ORDER BY column
    let found = false
    for h in header {
      if h == order_col { found = true }
    }
    if not found {
      print("error: unknown column " + order_col)
      return
    }

    i = i + 3
    if i < len(query_parts) and query_parts[i] == "DESC" {
      order_desc = true
      i = i + 1
    }
  } else if keyword == "LIMIT" {
    if i + 1 >= len(query_parts) {
      print("error: bad query")
      return
    }
    match num(query_parts[i + 1]) {
      ok(n) => limit_n = n
      err(e) => {
        print("error: bad query")
        return
      }
    }
    i = i + 2
  } else {
    print("error: bad query")
    return
  }
}

// Filter rows based on WHERE clause
let filtered_rows = []
for row in rows {
  let include = true

  if where_col != "" {
    let cell_val = row[where_col]

    // Parse values as numbers if possible
    let cell_num = 0
    let cell_is_num = false
    let where_num = 0
    let where_is_num = false

    match num(cell_val) {
      ok(n) => { cell_num = n, cell_is_num = true }
      err(e) => {}
    }

    match num(where_val) {
      ok(n) => { where_num = n, where_is_num = true }
      err(e) => {}
    }

    // Perform comparison
    if cell_is_num and where_is_num {
      // Numeric comparison
      if where_op == "=" {
        include = cell_num == where_num
      } else if where_op == "!=" {
        include = cell_num != where_num
      } else if where_op == "<" {
        include = cell_num < where_num
      } else if where_op == ">" {
        include = cell_num > where_num
      } else if where_op == "<=" {
        include = cell_num <= where_num
      } else if where_op == ">=" {
        include = cell_num >= where_num
      }
    } else if not cell_is_num and not where_is_num {
      // String comparison
      if where_op == "=" {
        include = cell_val == where_val
      } else if where_op == "!=" {
        include = cell_val != where_val
      } else {
        // Non-numeric comparison on strings
        print("error: bad comparison")
        return
      }
    } else {
      // One is number, one is string
      if where_op == "=" {
        include = false
      } else if where_op == "!=" {
        include = true
      } else {
        print("error: bad comparison")
        return
      }
    }
  }

  if include {
    push(filtered_rows, row)
  }
}

// Sort rows based on ORDER BY clause
if order_col != "" {
  // Determine if column is numeric
  let is_numeric = true
  for row in filtered_rows {
    let cell_val = row[order_col]
    match num(cell_val) {
      ok(n) => {}
      err(e) => { is_numeric = false }
    }
  }

  if is_numeric {
    // Numeric sort
    if order_desc {
      filtered_rows = sortBy(filtered_rows, r => {
        let val = r[order_col]
        match num(val) {
          ok(n) => 0 - n
          err(e) => 0
        }
      })
    } else {
      filtered_rows = sortBy(filtered_rows, r => {
        let val = r[order_col]
        match num(val) {
          ok(n) => n
          err(e) => 0
        }
      })
    }
  } else {
    // String sort
    filtered_rows = sortBy(filtered_rows, r => r[order_col])
    if order_desc {
      filtered_rows = reverse(filtered_rows)
    }
  }
}

// Apply LIMIT
if limit_n > 0 {
  let limited = []
  for i in range(0, len(filtered_rows)) {
    if i < limit_n {
      push(limited, filtered_rows[i])
    }
  }
  filtered_rows = limited
}

// Output header
print(join(select_cols, ","))

// Output rows
for row in filtered_rows {
  let row_vals = []
  for col in select_cols {
    push(row_vals, row[col])
  }
  print(join(row_vals, ","))
}
