struct Query {
  columns,
  where_col,
  where_op,
  where_val,
  order_col,
  order_desc,
  limit_n
}

fn parseCSV(text) {
  let row_lines = lines(text)

  if len(row_lines) == 0 {
    return ok([[], []])
  }

  let columns = split(row_lines[0], ",")
  let rows = []

  for i in range(1, len(row_lines)) {
    let line = row_lines[i]
    if len(trim(line)) == 0 {
      continue
    }

    let fields = split(line, ",")
    let row = {" ": " "}
    for j in range(0, len(columns)) {
      let col = columns[j]
      let val = match get(fields, j) {
        ok(v) => v
        err(_) => ""
      }
      row[col] = val
    }
    push(rows, row)
  }

  return ok([columns, rows])
}

fn parseQuery(query_str) {
  let parts = split(query_str, " ")

  if len(parts) == 0 or parts[0] != "SELECT" {
    return err("bad query")
  }

  if len(parts) < 2 {
    return err("bad query")
  }

  let columns = split(parts[1], ",")

  let where_col = ""
  let where_op = ""
  let where_val = ""
  let order_col = ""
  let order_desc = false
  let limit_n = 0 - 1

  let i = 2

  if i < len(parts) and parts[i] == "WHERE" {
    if i + 3 >= len(parts) {
      return err("bad query")
    }
    where_col = parts[i + 1]
    where_op = parts[i + 2]
    where_val = parts[i + 3]
    i = i + 4
  }

  if i < len(parts) and parts[i] == "ORDER" {
    if i + 1 >= len(parts) or parts[i + 1] != "BY" {
      return err("bad query")
    }
    if i + 2 >= len(parts) {
      return err("bad query")
    }
    order_col = parts[i + 2]
    i = i + 3
    if i < len(parts) and parts[i] == "DESC" {
      order_desc = true
      i = i + 1
    }
  }

  if i < len(parts) and parts[i] == "LIMIT" {
    if i + 1 >= len(parts) {
      return err("bad query")
    }
    match num(parts[i + 1]) {
      ok(n) => {
        limit_n = n
        i = i + 2
      }
      err(_) => {
        return err("bad query")
      }
    }
  }

  if i != len(parts) {
    return err("bad query")
  }

  let q = Query {
    columns: columns,
    where_col: where_col,
    where_op: where_op,
    where_val: where_val,
    order_col: order_col,
    order_desc: order_desc,
    limit_n: limit_n
  }

  return ok(q)
}

fn isNumericColumn(rows, col) {
  for row in rows {
    match num(row[col]) {
      ok(_) => {}
      err(_) => { return false }
    }
  }
  return true
}

fn compareValues(val1, val2, is_numeric) {
  if is_numeric {
    let n1 = match num(val1) { ok(n) => n err(_) => 0 }
    let n2 = match num(val2) { ok(n) => n err(_) => 0 }
    if n1 < n2 { return 0 - 1 }
    if n1 > n2 { return 1 }
    return 0
  } else {
    if val1 < val2 { return 0 - 1 }
    if val1 > val2 { return 1 }
    return 0
  }
}

fn matchesWhere(row, where_col, where_op, where_val) {
  if where_col == "" {
    return ok(true)
  }

  let cell = row[where_col]
  let cell_is_num = match num(cell) { ok(_) => true err(_) => false }
  let val_is_num = match num(where_val) { ok(_) => true err(_) => false }

  if not cell_is_num or not val_is_num {
    if where_op != "=" and where_op != "!=" {
      return err("bad comparison")
    }
    let result = cell == where_val
    if where_op == "=" {
      return ok(result)
    } else {
      return ok(not result)
    }
  }

  let c1 = match num(cell) { ok(n) => n err(_) => 0 }
  let c2 = match num(where_val) { ok(n) => n err(_) => 0 }

  let result = match where_op {
    "=" => c1 == c2
    "!=" => c1 != c2
    "<" => c1 < c2
    ">" => c1 > c2
    "<=" => c1 <= c2
    ">=" => c1 >= c2
    _ => false
  }

  return ok(result)
}

fn insertionSort(rows, col, is_numeric, is_desc) {
  let sorted = []

  for row in rows {
    let insert_idx = len(sorted)

    for i in range(0, len(sorted)) {
      let val_row = row[col]
      let val_sorted_i = sorted[i][col]
      let cmp = compareValues(val_row, val_sorted_i, is_numeric)

      let should_insert = false
      if is_desc {
        should_insert = cmp > 0
      } else {
        should_insert = cmp < 0
      }

      if should_insert {
        insert_idx = i
        break
      }
    }

    let new_sorted = []
    for i in range(0, insert_idx) {
      push(new_sorted, sorted[i])
    }
    push(new_sorted, row)
    for i in range(insert_idx, len(sorted)) {
      push(new_sorted, sorted[i])
    }
    sorted = new_sorted
  }

  return sorted
}

fn hasInList(lst, val) {
  for item in lst {
    if item == val {
      return true
    }
  }
  return false
}

fn main() {
  let args_list = args()

  if len(args_list) < 2 {
    print("error: bad query")
    return
  }

  let csv_data = args_list[0]
  let query_str = args_list[1]

  let parsed_csv = match parseCSV(csv_data) {
    ok(p) => p
    err(e) => {
      print("error: bad query")
      return
    }
  }

  let columns = parsed_csv[0]
  let rows = parsed_csv[1]

  let q = match parseQuery(query_str) {
    ok(q) => q
    err(e) => {
      print("error: " + e)
      return
    }
  }

  for col in q.columns {
    if not hasInList(columns, col) {
      print("error: unknown column {col}")
      return
    }
  }

  if q.where_col != "" and not hasInList(columns, q.where_col) {
    print("error: unknown column {q.where_col}")
    return
  }

  if q.order_col != "" and not hasInList(columns, q.order_col) {
    print("error: unknown column {q.order_col}")
    return
  }

  let filtered = []
  for row in rows {
    match matchesWhere(row, q.where_col, q.where_op, q.where_val) {
      ok(matches) => {
        if matches {
          push(filtered, row)
        }
      }
      err(e) => {
        print("error: " + e)
        return
      }
    }
  }

  if q.order_col != "" {
    let is_numeric = isNumericColumn(filtered, q.order_col)
    filtered = insertionSort(filtered, q.order_col, is_numeric, q.order_desc)
  }

  if q.limit_n > 0 {
    let limited = []
    for i in range(0, q.limit_n) {
      match get(filtered, i) {
        ok(row) => push(limited, row)
        err(_) => break
      }
    }
    filtered = limited
  }

  print(join(q.columns, ","))
  for row in filtered {
    let values = []
    for col in q.columns {
      push(values, row[col])
    }
    print(join(values, ","))
  }
}

main()
