struct Query {
  selectCols,
  whereCol,
  whereOp,
  whereVal,
  orderByCol,
  orderByDesc,
  limitNum
}

fn parseCsv(text) {
  let rows = lines(text)
  let result = []
  for row in rows {
    push(result, split(row, ","))
  }
  return result
}

fn findColumnIndex(headers, col) {
  for i in range(0, len(headers)) {
    if headers[i] == col {
      return ok(i)
    }
  }
  return err("unknown")
}

fn parseQuery(queryStr) {
  let parts = split(queryStr, " ")

  if len(parts) < 2 or parts[0] != "SELECT" {
    return err("bad query")
  }

  let selectCols = split(parts[1], ",")
  let whereCol = ""
  let whereOp = ""
  let whereVal = ""
  let orderByCol = ""
  let orderByDesc = false
  let limitNum = 999999

  let i = 2
  while i < len(parts) {
    if parts[i] == "WHERE" {
      if i + 3 > len(parts) {
        return err("bad query")
      }
      whereCol = parts[i + 1]
      whereOp = parts[i + 2]
      whereVal = parts[i + 3]
      i = i + 4
    } else if parts[i] == "ORDER" {
      if i + 1 >= len(parts) or parts[i + 1] != "BY" {
        return err("bad query")
      }
      if i + 2 >= len(parts) {
        return err("bad query")
      }
      orderByCol = parts[i + 2]
      i = i + 3
      if i < len(parts) and parts[i] == "DESC" {
        orderByDesc = true
        i = i + 1
      }
    } else if parts[i] == "LIMIT" {
      if i + 1 >= len(parts) {
        return err("bad query")
      }
      match num(parts[i + 1]) {
        ok(n) => {
          limitNum = n
          i = i + 2
        }
        err(e) => {
          return err("bad query")
        }
      }
    } else {
      return err("bad query")
    }
  }

  return ok(Query {
    selectCols: selectCols,
    whereCol: whereCol,
    whereOp: whereOp,
    whereVal: whereVal,
    orderByCol: orderByCol,
    orderByDesc: orderByDesc,
    limitNum: limitNum
  })
}

fn isNumeric(s) {
  match num(s) {
    ok(n) => true
    err(e) => false
  }
}

fn compare(val1Str, val2Str, op) {
  let val1Num = match num(val1Str) { ok(n) => n err(e) => 0 }
  let val2Num = match num(val2Str) { ok(n) => n err(e) => 0 }

  let isVal1Num = isNumeric(val1Str)
  let isVal2Num = isNumeric(val2Str)

  if isVal1Num and isVal2Num {
    if op == "=" { return val1Num == val2Num }
    if op == "!=" { return val1Num != val2Num }
    if op == "<" { return val1Num < val2Num }
    if op == ">" { return val1Num > val2Num }
    if op == "<=" { return val1Num <= val2Num }
    if op == ">=" { return val1Num >= val2Num }
  } else {
    if op == "=" { return val1Str == val2Str }
    if op == "!=" { return val1Str != val2Str }
    return false
  }
  return false
}

fn filterRows(rows, headers, query) {
  if query.whereCol == "" {
    return ok(rows)
  }

  match findColumnIndex(headers, query.whereCol) {
    ok(colIdx) => {
      let filtered = []
      for row in rows {
        let cellVal = row[colIdx]
        if compare(cellVal, query.whereVal, query.whereOp) {
          push(filtered, row)
        }
      }
      return ok(filtered)
    }
    err(e) => {
      return err("unknown")
    }
  }
}

fn compareForSort(val1Str, val2Str, allNumeric) {
  if allNumeric {
    let v1 = match num(val1Str) { ok(n) => n err(e) => 0 }
    let v2 = match num(val2Str) { ok(n) => n err(e) => 0 }
    if v1 < v2 { return -1 }
    if v1 > v2 { return 1 }
    return 0
  } else {
    if val1Str < val2Str { return -1 }
    if val1Str > val2Str { return 1 }
    return 0
  }
}

fn sortRows(rows, headers, query) {
  if query.orderByCol == "" {
    return ok(rows)
  }

  match findColumnIndex(headers, query.orderByCol) {
    ok(colIdx) => {
      let allNumeric = true
      for row in rows {
        if not isNumeric(row[colIdx]) {
          allNumeric = false
        }
      }

      let sorted = sortBy(rows, r => {
        let cellVal = r[colIdx]
        if allNumeric {
          let v = match num(cellVal) { ok(n) => n err(e) => 0 }
          if query.orderByDesc { return 0 - v } else { return v }
        } else {
          if query.orderByDesc { return cellVal } else { return cellVal }
        }
      })

      if query.orderByDesc and not allNumeric {
        return ok(reverse(sorted))
      }

      return ok(sorted)
    }
    err(e) => {
      return err("unknown")
    }
  }
}

fn limitRows(rows, limit) {
  if limit >= len(rows) {
    return rows
  }
  return slice(rows, 0, limit)
}

fn main() {
  let args_list = args()

  if len(args_list) < 2 {
    print("error: bad query")
    return
  }

  let csvText = args_list[0]
  let queryStr = args_list[1]

  let rows = parseCsv(csvText)

  if len(rows) == 0 {
    print("error: bad query")
    return
  }

  let headers = rows[0]
  let dataRows = slice(rows, 1, len(rows))

  match parseQuery(queryStr) {
    ok(query) => {
      for col in query.selectCols {
        match findColumnIndex(headers, col) {
          ok(idx) => {}
          err(e) => {
            print("error: unknown column " + col)
            return
          }
        }
      }

      match filterRows(dataRows, headers, query) {
        ok(filtered) => {
          match sortRows(filtered, headers, query) {
            ok(sorted) => {
              let final = limitRows(sorted, query.limitNum)

              print(join(query.selectCols, ","))
              for row in final {
                let values = []
                for col in query.selectCols {
                  match findColumnIndex(headers, col) {
                    ok(idx) => {
                      push(values, row[idx])
                    }
                    err(e) => {}
                  }
                }
                print(join(values, ","))
              }
            }
            err(e) => {
              if e == "unknown" {
                print("error: unknown column " + query.orderByCol)
              } else {
                print("error: bad comparison")
              }
            }
          }
        }
        err(e) => {
          if e == "unknown" {
            print("error: unknown column " + query.whereCol)
          } else {
            print("error: bad comparison")
          }
        }
      }
    }
    err(e) => {
      print("error: bad query")
    }
  }
}

main()
