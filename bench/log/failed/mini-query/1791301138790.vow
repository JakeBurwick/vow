struct Query {
  select_cols,
  where_col,
  where_op,
  where_val,
  order_col,
  order_desc,
  limit_n
}

fn parseQuery(s) {
  let parts = split(s, " ")
  if len(parts) == 0 {
    return err("error: bad query")
  }

  let idx = 0
  if parts[idx] != "SELECT" {
    return err("error: bad query")
  }
  idx = idx + 1

  if idx >= len(parts) {
    return err("error: bad query")
  }

  let select_str = parts[idx]
  let select_cols = split(select_str, ",")
  if len(select_cols) == 0 {
    return err("error: bad query")
  }
  idx = idx + 1

  let where_col = ""
  let where_op = ""
  let where_val = ""

  if idx < len(parts) and parts[idx] == "WHERE" {
    idx = idx + 1
    if idx + 2 >= len(parts) {
      return err("error: bad query")
    }
    where_col = parts[idx]
    where_op = parts[idx + 1]
    where_val = parts[idx + 2]

    if where_op != "=" and where_op != "!=" and where_op != "<" and where_op != ">" and where_op != "<=" and where_op != ">=" {
      return err("error: bad query")
    }
    idx = idx + 3
  }

  let order_col = ""
  let order_desc = false

  if idx < len(parts) and parts[idx] == "ORDER" {
    idx = idx + 1
    if idx >= len(parts) or parts[idx] != "BY" {
      return err("error: bad query")
    }
    idx = idx + 1
    if idx >= len(parts) {
      return err("error: bad query")
    }
    order_col = parts[idx]
    idx = idx + 1

    if idx < len(parts) and parts[idx] == "DESC" {
      order_desc = true
      idx = idx + 1
    }
  }

  let limit_n = 0
  if idx < len(parts) and parts[idx] == "LIMIT" {
    idx = idx + 1
    if idx >= len(parts) {
      return err("error: bad query")
    }
    match num(parts[idx]) {
      ok(n) => {
        limit_n = n
        idx = idx + 1
      }
      err(e) => return err("error: bad query")
    }
  }

  if idx < len(parts) {
    return err("error: bad query")
  }

  return ok(Query {
    select_cols: select_cols,
    where_col: where_col,
    where_op: where_op,
    where_val: where_val,
    order_col: order_col,
    order_desc: order_desc,
    limit_n: limit_n
  })
}

fn findColIndex(headers, col) {
  for i in range(0, len(headers)) {
    if headers[i] == col {
      return ok(i)
    }
  }
  return err("error: unknown column " + col)
}

fn validateColumns(q, headers) {
  for col in q.select_cols {
    match findColIndex(headers, col) {
      ok(i) => {}
      err(e) => return err(e)
    }
  }

  if q.where_col != "" {
    match findColIndex(headers, q.where_col) {
      ok(i) => {}
      err(e) => return err(e)
    }
  }

  if q.order_col != "" {
    match findColIndex(headers, q.order_col) {
      ok(i) => {}
      err(e) => return err(e)
    }
  }

  return ok(true)
}

fn rowMatches(row, headers, where_col, where_op, where_val) {
  if where_col == "" {
    return true
  }

  match findColIndex(headers, where_col) {
    ok(col_idx) => {
      let cell_val = row[col_idx]

      let cell_num = match num(cell_val) {
        ok(n) => n
        err(e) => 0
      }
      let val_num = match num(where_val) {
        ok(n) => n
        err(e) => 0
      }

      let cell_is_num = match num(cell_val) {
        ok(n) => true
        err(e) => false
      }
      let val_is_num = match num(where_val) {
        ok(n) => true
        err(e) => false
      }

      if cell_is_num and val_is_num {
        if where_op == "=" {
          return cell_num == val_num
        } else if where_op == "!=" {
          return cell_num != val_num
        } else if where_op == "<" {
          return cell_num < val_num
        } else if where_op == ">" {
          return cell_num > val_num
        } else if where_op == "<=" {
          return cell_num <= val_num
        } else if where_op == ">=" {
          return cell_num >= val_num
        }
      } else {
        if where_op == "=" {
          return cell_val == where_val
        } else if where_op == "!=" {
          return cell_val != where_val
        } else {
          return false
        }
      }
    }
    err(e) => return false
  }
  return false
}

fn isAllNumeric(values) {
  for v in values {
    match num(v) {
      ok(n) => {}
      err(e) => return false
    }
  }
  return true
}

fn compareValues(a, b, numeric) {
  if numeric {
    let a_num = match num(a) {
      ok(n) => n
      err(e) => 0
    }
    let b_num = match num(b) {
      ok(n) => n
      err(e) => 0
    }
    if a_num < b_num {
      return -1
    } else if a_num > b_num {
      return 1
    } else {
      return 0
    }
  } else {
    if a < b {
      return -1
    } else if a > b {
      return 1
    } else {
      return 0
    }
  }
}

fn main() {
  let args_list = args()
  if len(args_list) < 2 {
    print("error: bad query")
    return
  }

  let csv = args_list[0]
  let query_str = args_list[1]

  let lines = lines(csv)
  if len(lines) == 0 {
    print("error: bad query")
    return
  }

  let headers = split(lines[0], ",")
  let rows = []
  for i in range(1, len(lines)) {
    if lines[i] != "" {
      push(rows, split(lines[i], ","))
    }
  }

  match parseQuery(query_str) {
    ok(q) => {
      match validateColumns(q, headers) {
        ok(v) => {
          let filtered_rows = []
          for row in rows {
            if rowMatches(row, headers, q.where_col, q.where_op, q.where_val) {
              push(filtered_rows, row)
            }
          }

          if q.order_col != "" {
            match findColIndex(headers, q.order_col) {
              ok(order_idx) => {
                let col_values = []
                for row in filtered_rows {
                  push(col_values, row[order_idx])
                }
                let is_numeric = isAllNumeric(col_values)

                filtered_rows = sortBy(filtered_rows, r => {
                  let key = r[order_idx]
                  if is_numeric {
                    let key_num = match num(key) {
                      ok(n) => n
                      err(e) => 0
                    }
                    if q.order_desc {
                      return 0 - key_num
                    } else {
                      return key_num
                    }
                  } else {
                    return key
                  }
                })

                if not q.order_desc {
                  filtered_rows = reverse(filtered_rows)
                }
              }
              err(e) => {}
            }
          }

          if q.limit_n > 0 and len(filtered_rows) > q.limit_n {
            filtered_rows = slice(filtered_rows, 0, q.limit_n)
          }

          let output_headers = []
          for col in q.select_cols {
            push(output_headers, col)
          }
          print(join(output_headers, ","))

          for row in filtered_rows {
            let output_row = []
            for col in q.select_cols {
              match findColIndex(headers, col) {
                ok(col_idx) => {
                  push(output_row, row[col_idx])
                }
                err(e) => {}
              }
            }
            print(join(output_row, ","))
          }
        }
        err(e) => print(e)
      }
    }
    err(e) => print(e)
  }
}

main()
