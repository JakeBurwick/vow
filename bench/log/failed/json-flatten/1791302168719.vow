fn escapeJsonString(s) {
  let result = ""
  let i = 0
  while i < len(s) {
    let c = s[i]
    if c == "\"" {
      result = result + "\\\""
    } else if c == "\\" {
      result = result + "\\\\"
    } else {
      result = result + c
    }
    i = i + 1
  }
  return result
}

fn flattenJson(j, path, result) {
  let jtype = jsonType(j)

  if jtype == "object" {
    let keys = jsonKeys(j)
    if len(keys) == 0 {
      // Empty object is a leaf
      result[path] = "{}"
      return
    }
    let sorted_keys = sort(keys)
    for key in sorted_keys {
      let child = get(j, key)
      match child {
        ok(c) => {
          let new_path = if path == "" {
            key
          } else {
            path + "." + key
          }
          flattenJson(c, new_path, result)
        }
        err(e) => {}
      }
    }
  } else if jtype == "array" {
    let items = jsonList(j)
    if len(items) == 0 {
      // Empty array is a leaf
      result[path] = "[]"
      return
    }
    let i = 0
    while i < len(items) {
      let item = items[i]
      let new_path = path + "[" + str(i) + "]"
      flattenJson(item, new_path, result)
      i = i + 1
    }
  } else if jtype == "string" {
    let str_val = match jsonStr(j) {
      ok(s) => s
      err(e) => ""
    }
    let escaped = escapeJsonString(str_val)
    result[path] = "\"" + escaped + "\""
  } else if jtype == "number" {
    let num_val = match jsonNum(j) {
      ok(n) => n
      err(e) => 0
    }
    let num_str = str(num_val)
    result[path] = num_str
  } else if jtype == "bool" {
    let bool_val = match jsonBool(j) {
      ok(b) => b
      err(e) => false
    }
    if bool_val {
      result[path] = "true"
    } else {
      result[path] = "false"
    }
  } else if jtype == "null" {
    result[path] = "null"
  }
}

fn main() {
  let args_list = args()
  if len(args_list) == 0 {
    print("{\"error\":\"bad json\"}")
    return ok(true)
  }

  let json_str = args_list[0]

  match parseJson(json_str) {
    ok(j) => {
      let jtype = jsonType(j)
      if jtype != "object" and jtype != "array" {
        print("{\"error\":\"not a container\"}")
        return ok(true)
      }

      let result = {}
      flattenJson(j, "", result)

      // Check if result is empty
      if len(keys(result)) == 0 {
        print("{}")
        return ok(true)
      }

      // Build output JSON
      let output = "\{"
      let keys_list = keys(result)
      let keys_sorted = sort(keys_list)

      let first = true
      for key in keys_sorted {
        if not first {
          output = output + ","
        }
        first = false

        let escaped_key = escapeJsonString(key)
        let value = result[key]
        output = output + "\"" + escaped_key + "\":" + value
      }

      output = output + "}"
      print(output)
      return ok(true)
    }
    err(e) => {
      print("{\"error\":\"bad json\"}")
      return ok(true)
    }
  }
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
