fn getValue(data, path) {
  let parts = split(path, ".")
  let current = data
  for part in parts {
    if jsonType(current) != "object" {
      return ok(parseJson("null")?)
    }
    match get(current, part) {
      ok(v) => current = v
      err(_) => return ok(parseJson("null")?)
    }
  }
  return ok(current)
}

fn isTruthy(j) {
  let t = jsonType(j)
  if t == "null" { return false }
  if t == "bool" {
    return match jsonBool(j) {
      ok(b) => b
      err(_) => false
    }
  }
  if t == "number" {
    return match jsonNum(j) {
      ok(n) => n != 0
      err(_) => false
    }
  }
  if t == "string" {
    return match jsonStr(j) {
      ok(s) => len(s) > 0
      err(_) => false
    }
  }
  if t == "array" {
    return len(jsonList(j)) > 0
  }
  if t == "object" {
    return len(jsonKeys(j)) > 0
  }
  return false
}

fn valueToString(j) {
  let t = jsonType(j)
  if t == "null" { return ok("") }
  if t == "string" {
    return match jsonStr(j) {
      ok(s) => ok(s)
      err(_) => err("not printable")
    }
  }
  if t == "number" {
    return match jsonNum(j) {
      ok(n) => ok(str(n))
      err(_) => err("not printable")
    }
  }
  if t == "bool" {
    return match jsonBool(j) {
      ok(b) => if b { ok("true") } else { ok("false") }
      err(_) => err("not printable")
    }
  }
  return err("not printable")
}

fn processTemplate(template, data) {
  let output = ""
  let i = 0
  while i < len(template) {
    if i + 1 < len(template) and template[i] == "{" and template[i + 1] == "{" {
      i = i + 2
      let tag = ""
      while i < len(template) and not (template[i] == "}" and i + 1 < len(template) and template[i + 1] == "}") {
        tag = tag + template[i]
        i = i + 1
      }
      if i + 1 >= len(template) {
        return err("unclosed tag")
      }
      i = i + 2

      let trimmedTag = trim(tag)
      if startsWith(trimmedTag, "#if ") {
        let condName = trim(slice(trimmedTag, 4, len(trimmedTag)))
        match processIf(template, data, parseJson("null")?, condName, i) {
          ok(result) => {
            output = output + result.content
            i = result.pos
          }
          err(e) => return err(e)
        }
      } else if startsWith(trimmedTag, "#each ") {
        let listName = trim(slice(trimmedTag, 6, len(trimmedTag)))
        match processEach(template, data, parseJson("null")?, listName, i) {
          ok(result) => {
            output = output + result.content
            i = result.pos
          }
          err(e) => return err(e)
        }
      } else if startsWith(trimmedTag, "/if") {
        return err("unexpected /if")
      } else if startsWith(trimmedTag, "/each") {
        return err("unexpected /each")
      } else {
        match interpolate(template, data, parseJson("null")?, trimmedTag) {
          ok(s) => output = output + s
          err(e) => return err(e)
        }
      }
    } else {
      output = output + template[i]
      i = i + 1
    }
  }
  return ok(output)
}

fn interpolate(template, data, current, varName) {
  if varName == "." {
    return valueToString(current)
  } else {
    let val = if jsonType(current) == "object" {
      match get(current, varName) {
        ok(v) => v
        err(_) => match getValue(data, varName) {
          ok(v) => v
          err(_) => parseJson("null")?
        }
      }
    } else {
      match getValue(data, varName) {
        ok(v) => v
        err(_) => parseJson("null")?
      }
    }
    return valueToString(val)
  }
}

struct Result { content, pos }

fn processIf(template, data, current, condName, startPos) {
  let condVal = if jsonType(current) == "object" {
    match get(current, condName) {
      ok(v) => v
      err(_) => match getValue(data, condName) {
        ok(v) => v
        err(_) => parseJson("null")?
      }
    }
  } else {
    match getValue(data, condName) {
      ok(v) => v
      err(_) => parseJson("null")?
    }
  }

  let endPos = findClosingTag(template, startPos, "if")

  if isTruthy(condVal) {
    match processBlock(template, data, current, startPos, endPos) {
      ok(content) => return ok(Result { content: content, pos: endPos })
      err(e) => return err(e)
    }
  } else {
    return ok(Result { content: "", pos: endPos })
  }
}

fn processEach(template, data, current, listName, startPos) {
  let listVal = if jsonType(current) == "object" {
    match get(current, listName) {
      ok(v) => v
      err(_) => match getValue(data, listName) {
        ok(v) => v
        err(_) => parseJson("null")?
      }
    }
  } else {
    match getValue(data, listName) {
      ok(v) => v
      err(_) => parseJson("null")?
    }
  }

  let endPos = findClosingTag(template, startPos, "each")

  if jsonType(listVal) != "array" {
    if jsonType(listVal) == "null" {
      return ok(Result { content: "", pos: endPos })
    } else {
      return err("not a list: " + listName)
    }
  }

  let items = jsonList(listVal)
  let output = ""
  for item in items {
    match processBlock(template, data, item, startPos, endPos) {
      ok(content) => output = output + content
      err(e) => return err(e)
    }
  }

  return ok(Result { content: output, pos: endPos })
}

fn processBlock(template, data, current, start, end) {
  let output = ""
  let i = start
  while i < end and i < len(template) {
    if i + 1 < len(template) and template[i] == "{" and template[i + 1] == "{" {
      i = i + 2
      let tag = ""
      while i < len(template) and not (template[i] == "}" and i + 1 < len(template) and template[i + 1] == "}") {
        tag = tag + template[i]
        i = i + 1
      }
      if i + 1 < len(template) {
        i = i + 2
      }

      let trimmedTag = trim(tag)
      if startsWith(trimmedTag, "#if ") {
        let condName = trim(slice(trimmedTag, 4, len(trimmedTag)))
        match processIf(template, data, current, condName, i) {
          ok(result) => {
            if result.pos <= end {
              output = output + result.content
              i = result.pos
            }
          }
          err(e) => return err(e)
        }
      } else if startsWith(trimmedTag, "#each ") {
        let listName = trim(slice(trimmedTag, 6, len(trimmedTag)))
        match processEach(template, data, current, listName, i) {
          ok(result) => {
            if result.pos <= end {
              output = output + result.content
              i = result.pos
            }
          }
          err(e) => return err(e)
        }
      } else if startsWith(trimmedTag, "/if") {
        return ok(output)
      } else if startsWith(trimmedTag, "/each") {
        return ok(output)
      } else {
        match interpolate(template, data, current, trimmedTag) {
          ok(s) => output = output + s
          err(e) => return err(e)
        }
      }
    } else {
      output = output + template[i]
      i = i + 1
    }
  }
  return ok(output)
}

fn findClosingTag(template, startPos, tagType) {
  let i = startPos
  let depth = 1
  while i < len(template) and depth > 0 {
    if i + 1 < len(template) and template[i] == "{" and template[i + 1] == "{" {
      i = i + 2
      let tag = ""
      while i < len(template) and not (template[i] == "}" and i + 1 < len(template) and template[i + 1] == "}") {
        tag = tag + template[i]
        i = i + 1
      }
      if i + 1 < len(template) {
        i = i + 2
      }
      let trimmedTag = trim(tag)
      if tagType == "if" and startsWith(trimmedTag, "#if ") {
        depth = depth + 1
      } else if tagType == "if" and startsWith(trimmedTag, "/if") {
        depth = depth - 1
      } else if tagType == "each" and startsWith(trimmedTag, "#each ") {
        depth = depth + 1
      } else if tagType == "each" and startsWith(trimmedTag, "/each") {
        depth = depth - 1
      }
    } else {
      i = i + 1
    }
  }
  return i
}

fn main() {
  let args_list = args()
  if len(args_list) < 2 {
    return ok(true)
  }

  let template = args_list[0]
  let dataStr = args_list[1]

  match parseJson(dataStr) {
    ok(dataJson) => {
      if jsonType(dataJson) != "object" {
        print("error: bad data")
        return ok(true)
      }
      match processTemplate(template, dataJson) {
        ok(output) => print(output)
        err(e) => print("error: " + e)
      }
    }
    err(_) => {
      print("error: bad data")
    }
  }
  return ok(true)
}

match main() {
  ok(_) => {}
  err(e) => print(e)
}
