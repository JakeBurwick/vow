fn findCloseIf(chars, pos) {
  let d = 1
  let i = pos
  while i < len(chars) {
    if i + 1 < len(chars) and chars[i] == "{" and chars[i + 1] == "{" {
      let j = i + 2
      while j + 1 < len(chars) and not (chars[j] == "}" and chars[j + 1] == "}") {
        j = j + 1
      }
      if j + 1 < len(chars) {
        let tagChars = slice(chars, i + 2, j)
        let tagStr = join(tagChars, "")
        let t = trim(tagStr)
        if startsWith(t, "#if ") {
          d = d + 1
        } else if t == "/if" {
          d = d - 1
          if d == 0 {
            return i
          }
        }
        i = j + 2
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  return 0 - 1
}

fn findCloseEach(chars, pos) {
  let d = 1
  let i = pos
  while i < len(chars) {
    if i + 1 < len(chars) and chars[i] == "{" and chars[i + 1] == "{" {
      let j = i + 2
      while j + 1 < len(chars) and not (chars[j] == "}" and chars[j + 1] == "}") {
        j = j + 1
      }
      if j + 1 < len(chars) {
        let tagChars = slice(chars, i + 2, j)
        let tagStr = join(tagChars, "")
        let t = trim(tagStr)
        if startsWith(t, "#each ") {
          d = d + 1
        } else if t == "/each" {
          d = d - 1
          if d == 0 {
            return i
          }
        }
        i = j + 2
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  return 0 - 1
}

fn isTruthy(v) {
  let t = jsonType(v)
  if t == "null" { return false }
  if t == "bool" {
    match jsonBool(v) {
      ok(b) => { return b }
      err(_) => { return false }
    }
  }
  if t == "number" {
    match jsonNum(v) {
      ok(n) => { return n != 0 }
      err(_) => { return false }
    }
  }
  if t == "string" {
    match jsonStr(v) {
      ok(s) => { return len(s) > 0 }
      err(_) => { return false }
    }
  }
  if t == "array" { return len(jsonList(v)) > 0 }
  if t == "object" { return len(jsonKeys(v)) > 0 }
  return false
}

fn fmt(v) {
  let t = jsonType(v)
  if t == "null" { return "" }
  if t == "bool" {
    match jsonBool(v) {
      ok(b) => { return if b { "true" } else { "false" } }
      err(_) => { return "" }
    }
  }
  if t == "number" {
    match jsonNum(v) {
      ok(n) => { return str(n) }
      err(_) => { return "" }
    }
  }
  if t == "string" {
    match jsonStr(v) {
      ok(s) => { return s }
      err(_) => { return "" }
    }
  }
  return ""
}

let args_list = args()
let template_str = args_list[0]
let data_str = args_list[1]

match parseJson(data_str) {
  ok(data) => {
    if jsonType(data) != "object" {
      print("error: bad data")
    } else {
      let result = ""
      let chars = split(template_str, "")
      let i = 0
      let hasError = false

      while i < len(chars) and not hasError {
        if i + 1 < len(chars) and chars[i] == "{" and chars[i + 1] == "{" {
          let j = i + 2
          while j + 1 < len(chars) and not (chars[j] == "}" and chars[j + 1] == "}") {
            j = j + 1
          }

          if j + 1 >= len(chars) {
            print("error: unclosed if")
            hasError = true
          } else {
            let tagChars = slice(chars, i + 2, j)
            let tagStr = join(tagChars, "")
            let tag = trim(tagStr)

            if startsWith(tag, "#if ") {
              let varname = trim(slice(tag, 4, len(tag)))
              let closePos = findCloseIf(chars, j + 2)

              if closePos < 0 {
                print("error: unclosed if")
                hasError = true
              } else {
                let bodyChars = slice(chars, j + 2, closePos)

                match get(data, varname) {
                  ok(v) => {
                    if isTruthy(v) {
                      let bi = 0
                      while bi < len(bodyChars) {
                        if bi + 1 < len(bodyChars) and bodyChars[bi] == "{" and bodyChars[bi + 1] == "{" {
                          let bj = bi + 2
                          while bj + 1 < len(bodyChars) and not (bodyChars[bj] == "}" and bodyChars[bj + 1] == "}") {
                            bj = bj + 1
                          }
                          if bj + 1 < len(bodyChars) {
                            let btagChars = slice(bodyChars, bi + 2, bj)
                            let btagStr = join(btagChars, "")
                            let btag = trim(btagStr)

                            if btag == "." {
                              result = result + fmt(data)
                            } else if not startsWith(btag, "#") and not startsWith(btag, "/") {
                              match get(data, btag) {
                                ok(bv) => {
                                  if jsonType(bv) == "array" or jsonType(bv) == "object" {
                                    print("error: not printable")
                                    hasError = true
                                    break
                                  } else {
                                    result = result + fmt(bv)
                                  }
                                }
                                err(_) => {}
                              }
                            }

                            bi = bj + 2
                          } else {
                            result = result + bodyChars[bi]
                            bi = bi + 1
                          }
                        } else {
                          result = result + bodyChars[bi]
                          bi = bi + 1
                        }
                      }
                    }
                  }
                  err(_) => {}
                }

                i = closePos
                while i < len(chars) and not (i + 1 < len(chars) and chars[i] == "{" and chars[i + 1] == "{") {
                  i = i + 1
                }
                if i + 1 < len(chars) {
                  let k = i + 2
                  while k + 1 < len(chars) and not (chars[k] == "}" and chars[k + 1] == "}") {
                    k = k + 1
                  }
                  if k + 1 < len(chars) {
                    let closingTag = join(slice(chars, i + 2, k), "")
                    if trim(closingTag) == "/if" {
                      i = k + 2
                    }
                  }
                }
              }
            } else if startsWith(tag, "#each ") {
              let varname = trim(slice(tag, 6, len(tag)))
              let closePos = findCloseEach(chars, j + 2)

              if closePos < 0 {
                print("error: unclosed each")
                hasError = true
              } else {
                let bodyChars = slice(chars, j + 2, closePos)

                match get(data, varname) {
                  ok(v) => {
                    if jsonType(v) != "array" {
                      print("error: not a list: " + varname)
                      hasError = true
                    } else {
                      let items = jsonList(v)
                      for item in items {
                        let bi = 0
                        while bi < len(bodyChars) {
                          if bi + 1 < len(bodyChars) and bodyChars[bi] == "{" and bodyChars[bi + 1] == "{" {
                            let bj = bi + 2
                            while bj + 1 < len(bodyChars) and not (bodyChars[bj] == "}" and bodyChars[bj + 1] == "}") {
                              bj = bj + 1
                            }
                            if bj + 1 < len(bodyChars) {
                              let btagChars = slice(bodyChars, bi + 2, bj)
                              let btagStr = join(btagChars, "")
                              let btag = trim(btagStr)

                              if btag == "." {
                                result = result + fmt(item)
                              } else if not startsWith(btag, "#") and not startsWith(btag, "/") {
                                if jsonType(item) == "object" {
                                  match get(item, btag) {
                                    ok(iv) => {
                                      if jsonType(iv) == "array" or jsonType(iv) == "object" {
                                        print("error: not printable")
                                        hasError = true
                                        break
                                      } else {
                                        result = result + fmt(iv)
                                      }
                                    }
                                    err(_) => {
                                      match get(data, btag) {
                                        ok(dv) => {
                                          if jsonType(dv) == "array" or jsonType(dv) == "object" {
                                            print("error: not printable")
                                            hasError = true
                                            break
                                          } else {
                                            result = result + fmt(dv)
                                          }
                                        }
                                        err(_) => {}
                                      }
                                    }
                                  }
                                } else {
                                  match get(data, btag) {
                                    ok(dv) => {
                                      if jsonType(dv) == "array" or jsonType(dv) == "object" {
                                        print("error: not printable")
                                        hasError = true
                                        break
                                      } else {
                                        result = result + fmt(dv)
                                      }
                                    }
                                    err(_) => {}
                                  }
                                }
                              }

                              bi = bj + 2
                            } else {
                              result = result + bodyChars[bi]
                              bi = bi + 1
                            }
                          } else {
                            result = result + bodyChars[bi]
                            bi = bi + 1
                          }
                        }
                      }
                    }
                  }
                  err(_) => {}
                }

                i = closePos
                while i < len(chars) and not (i + 1 < len(chars) and chars[i] == "{" and chars[i + 1] == "{") {
                  i = i + 1
                }
                if i + 1 < len(chars) {
                  let k = i + 2
                  while k + 1 < len(chars) and not (chars[k] == "}" and chars[k + 1] == "}") {
                    k = k + 1
                  }
                  if k + 1 < len(chars) {
                    let closingTag = join(slice(chars, i + 2, k), "")
                    if trim(closingTag) == "/each" {
                      i = k + 2
                    }
                  }
                }
              }
            } else if tag == "/if" {
              print("error: unexpected /if")
              hasError = true
            } else if tag == "/each" {
              print("error: unexpected /each")
              hasError = true
            } else {
              match get(data, tag) {
                ok(v) => {
                  if jsonType(v) == "array" or jsonType(v) == "object" {
                    print("error: not printable")
                    hasError = true
                  } else {
                    result = result + fmt(v)
                  }
                }
                err(_) => {}
              }
              i = j + 2
            }
          }
        } else {
          result = result + chars[i]
          i = i + 1
        }
      }

      if not hasError {
        print(result)
      }
    }
  }
  err(_) => {
    print("error: bad data")
  }
}
