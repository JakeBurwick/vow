fn findCloseIf(chars, pos) {
  let d = 1
  let i = pos
  while i < len(chars) {
    if i + 1 < len(chars) and chars[i] == "{" and chars[i + 1] == "{" {
      let j = i + 2
      while j + 1 < len(chars) and not (chars[j] == "}" and chars[j + 1] == "}") {
        j = j + 1
      }
      if j + 1 < len(chars) {
        let tagChars = slice(chars, i + 2, j)
        let tagStr = join(tagChars, "")
        let t = trim(tagStr)
        if startsWith(t, "#if ") {
          d = d + 1
        } else if t == "/if" {
          d = d - 1
          if d == 0 {
            return i
          }
        }
        i = j + 2
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  return 0 - 1
}

fn findCloseEach(chars, pos) {
  let d = 1
  let i = pos
  while i < len(chars) {
    if i + 1 < len(chars) and chars[i] == "{" and chars[i + 1] == "{" {
      let j = i + 2
      while j + 1 < len(chars) and not (chars[j] == "}" and chars[j + 1] == "}") {
        j = j + 1
      }
      if j + 1 < len(chars) {
        let tagChars = slice(chars, i + 2, j)
        let tagStr = join(tagChars, "")
        let t = trim(tagStr)
        if startsWith(t, "#each ") {
          d = d + 1
        } else if t == "/each" {
          d = d - 1
          if d == 0 {
            return i
          }
        }
        i = j + 2
      } else {
        i = i + 1
      }
    } else {
      i = i + 1
    }
  }
  return 0 - 1
}

fn fmt(v) {
  let t = jsonType(v)
  if t == "bool" {
    match jsonBool(v) {
      ok(b) => return if b { "true" } else { "false" }
      err(_) => {}
    }
  }
  if t == "number" {
    match jsonNum(v) {
      ok(n) => return str(n)
      err(_) => {}
    }
  }
  if t == "string" {
    match jsonStr(v) {
      ok(s) => return s
      err(_) => {}
    }
  }
  return ""
}

let args_list = args()
let template_str = args_list[0]
let data_str = args_list[1]

match parseJson(data_str) {
  ok(data) => {
    if jsonType(data) != "object" {
      print("error: bad data")
    } else {
      let result = ""
      let chars = split(template_str, "")
      let i = 0

      while i < len(chars) {
        if i + 1 < len(chars) and chars[i] == "{" and chars[i + 1] == "{" {
          let j = i + 2
          while j + 1 < len(chars) and not (chars[j] == "}" and chars[j + 1] == "}") {
            j = j + 1
          }

          if j + 1 >= len(chars) {
            print("error: unclosed if")
            return
          }

          let tagChars = slice(chars, i + 2, j)
          let tagStr = join(tagChars, "")
          let tag = trim(tagStr)

          if tag == "test" {
            print("match")
          }

          i = j + 2
        } else {
          result = result + chars[i]
          i = i + 1
        }
      }

      print(result)
    }
  }
  err(_) => {
    print("error: bad data")
  }
}
