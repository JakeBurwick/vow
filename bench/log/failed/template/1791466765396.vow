fn getValue(data, path) {
  let parts = split(path, ".")
  let current = data
  for part in parts {
    if jsonType(current) != "object" {
      return ok(parseJson("null")?)
    }
    match get(current, part) {
      ok(v) => current = v
      err(e) => return ok(parseJson("null")?)
    }
  }
  return ok(current)
}

fn isTruthy(j) {
  let t = jsonType(j)
  if t == "null" { return false }
  if t == "bool" {
    return match jsonBool(j) {
      ok(b) => b
      err(_) => false
    }
  }
  if t == "number" {
    return match jsonNum(j) {
      ok(n) => n != 0
      err(_) => false
    }
  }
  if t == "string" {
    return match jsonStr(j) {
      ok(s) => len(s) > 0
      err(_) => false
    }
  }
  if t == "array" {
    return len(jsonList(j)) > 0
  }
  if t == "object" {
    return len(jsonKeys(j)) > 0
  }
  return false
}

fn valueToString(j) {
  let t = jsonType(j)
  if t == "null" { return ok("") }
  if t == "string" {
    return match jsonStr(j) {
      ok(s) => ok(s)
      err(_) => err("not printable")
    }
  }
  if t == "number" {
    return match jsonNum(j) {
      ok(n) => ok(str(n))
      err(_) => err("not printable")
    }
  }
  if t == "bool" {
    return match jsonBool(j) {
      ok(b) => if b { ok("true") } else { ok("false") }
      err(_) => err("not printable")
    }
  }
  return err("not printable")
}

fn findBlockEnd(tmpl, startPos, blockType) {
  let pos = startPos
  let depth = 1
  while pos < len(tmpl) and depth > 0 {
    if pos + 1 < len(tmpl) and tmpl[pos] == "{" and tmpl[pos + 1] == "{" {
      pos = pos + 2
      let tag = ""
      while pos < len(tmpl) and not (tmpl[pos] == "}" and pos + 1 < len(tmpl) and tmpl[pos + 1] == "}") {
        tag = tag + tmpl[pos]
        pos = pos + 1
      }
      if pos + 1 < len(tmpl) {
        pos = pos + 2
      }
      let trimmedTag = trim(tag)
      if blockType == "if" and startsWith(trimmedTag, "#if ") {
        depth = depth + 1
      } else if blockType == "if" and startsWith(trimmedTag, "/if") {
        depth = depth - 1
      } else if blockType == "each" and startsWith(trimmedTag, "#each ") {
        depth = depth + 1
      } else if blockType == "each" and startsWith(trimmedTag, "/each") {
        depth = depth - 1
      }
    } else {
      pos = pos + 1
    }
  }
  return pos
}

fn parseBlock(tmpl, dataRoot, currentItem, pos) {
  let output = ""
  let i = pos
  while i < len(tmpl) {
    if i + 1 < len(tmpl) and tmpl[i] == "{" and tmpl[i + 1] == "{" {
      i = i + 2
      let tag = ""
      while i < len(tmpl) and not (tmpl[i] == "}" and i + 1 < len(tmpl) and tmpl[i + 1] == "}") {
        tag = tag + tmpl[i]
        i = i + 1
      }
      if i + 1 >= len(tmpl) {
        return err("unclosed tag")
      }
      i = i + 2
      let trimmedTag = trim(tag)
      if startsWith(trimmedTag, "#if ") {
        let condName = trim(slice(trimmedTag, 4, len(trimmedTag)))
        match parseIfBlock(tmpl, dataRoot, currentItem, condName, i) {
          ok(result) => {
            output = output + result.content
            i = result.newPos
          }
          err(e) => return err(e)
        }
      } else if startsWith(trimmedTag, "#each ") {
        let listName = trim(slice(trimmedTag, 6, len(trimmedTag)))
        match parseEachBlock(tmpl, dataRoot, currentItem, listName, i) {
          ok(result) => {
            output = output + result.content
            i = result.newPos
          }
          err(e) => return err(e)
        }
      } else if startsWith(trimmedTag, "/if") {
        return err("unexpected /if")
      } else if startsWith(trimmedTag, "/each") {
        return err("unexpected /each")
      } else {
        let varName = trimmedTag
        if varName == "." {
          match valueToString(currentItem) {
            ok(s) => output = output + s
            err(e) => return err(e)
          }
        } else {
          let val = if jsonType(currentItem) == "object" {
            match get(currentItem, varName) {
              ok(v) => v
              err(_) => match getValue(dataRoot, varName) {
                ok(v) => v
                err(_) => parseJson("null")?
              }
            }
          } else {
            match getValue(dataRoot, varName) {
              ok(v) => v
              err(_) => parseJson("null")?
            }
          }
          match valueToString(val) {
            ok(s) => output = output + s
            err(e) => return err(e)
          }
        }
      }
    } else {
      output = output + tmpl[i]
      i = i + 1
    }
  }
  return ok(output)
}

struct IfResult { content, newPos }
struct EachResult { content, newPos }

fn parseIfBlock(tmpl, dataRoot, currentItem, condName, startPos) {
  let condVal = if jsonType(currentItem) == "object" {
    match get(currentItem, condName) {
      ok(v) => v
      err(_) => match getValue(dataRoot, condName) {
        ok(v) => v
        err(_) => parseJson("null")?
      }
    }
  } else {
    match getValue(dataRoot, condName) {
      ok(v) => v
      err(_) => parseJson("null")?
    }
  }

  if isTruthy(condVal) {
    let blockEnd = findBlockEnd(tmpl, startPos, "if")
    let blockTemplate = slice(tmpl, startPos, blockEnd - 5)
    match parseBlock(blockTemplate, dataRoot, currentItem, 0) {
      ok(content) => {
        return ok(IfResult { content: content, newPos: blockEnd })
      }
      err(e) => return err(e)
    }
  } else {
    let blockEnd = findBlockEnd(tmpl, startPos, "if")
    return ok(IfResult { content: "", newPos: blockEnd })
  }
}

fn parseEachBlock(tmpl, dataRoot, currentItem, listName, startPos) {
  let listVal = if jsonType(currentItem) == "object" {
    match get(currentItem, listName) {
      ok(v) => v
      err(_) => match getValue(dataRoot, listName) {
        ok(v) => v
        err(_) => parseJson("null")?
      }
    }
  } else {
    match getValue(dataRoot, listName) {
      ok(v) => v
      err(_) => parseJson("null")?
    }
  }

  let t = jsonType(listVal)
  if t != "array" {
    if t == "null" {
      let blockEnd = findBlockEnd(tmpl, startPos, "each")
      return ok(EachResult { content: "", newPos: blockEnd })
    } else {
      return err("not a list: " + listName)
    }
  }

  let items = jsonList(listVal)
  let blockEnd = findBlockEnd(tmpl, startPos, "each")
  let blockTemplate = slice(tmpl, startPos, blockEnd - 7)

  let output = ""
  for item in items {
    match parseBlock(blockTemplate, dataRoot, item, 0) {
      ok(content) => output = output + content
      err(e) => return err(e)
    }
  }

  return ok(EachResult { content: output, newPos: blockEnd })
}

fn parseTemplate(template, data) {
  match parseBlock(template, data, parseJson("null")?, 0) {
    ok(result) => return ok(result)
    err(e) => return err(e)
  }
}

fn main() {
  let args_list = args()
  if len(args_list) < 2 {
    return ok(true)
  }

  let template = args_list[0]
  let dataStr = args_list[1]

  match parseJson(dataStr) {
    ok(dataJson) => {
      if jsonType(dataJson) != "object" {
        print("error: bad data")
        return ok(true)
      }
      match parseTemplate(template, dataJson) {
        ok(output) => print(output)
        err(e) => print("error: " + e)
      }
    }
    err(_) => {
      print("error: bad data")
    }
  }
  return ok(true)
}

match main() {
  ok(_) => {}
  err(e) => print(e)
}
