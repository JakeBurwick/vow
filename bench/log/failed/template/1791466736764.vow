fn getValue(data, path) {
  if jsonType(data) != "object" {
    return err("not an object")
  }
  let parts = split(path, ".")
  let current = data
  for part in parts {
    if jsonType(current) != "object" {
      return ok(parseJson("null")?)
    }
    match get(current, part) {
      ok(v) => current = v
      err(e) => return ok(parseJson("null")?)
    }
  }
  return ok(current)
}

fn isTruthy(j) {
  let t = jsonType(j)
  if t == "null" { return false }
  if t == "bool" {
    return match jsonBool(j) {
      ok(b) => b
      err(e) => false
    }
  }
  if t == "number" {
    return match jsonNum(j) {
      ok(n) => n != 0
      err(e) => false
    }
  }
  if t == "string" {
    return match jsonStr(j) {
      ok(s) => len(s) > 0
      err(e) => false
    }
  }
  if t == "array" {
    return len(jsonList(j)) > 0
  }
  if t == "object" {
    return len(jsonKeys(j)) > 0
  }
  return false
}

fn valueToString(j) {
  let t = jsonType(j)
  if t == "null" { return ok("") }
  if t == "string" {
    return match jsonStr(j) {
      ok(s) => ok(s)
      err(e) => err("not printable")
    }
  }
  if t == "number" {
    return match jsonNum(j) {
      ok(n) => {
        if isInt(n) {
          ok(str(n))
        } else {
          ok(str(n))
        }
      }
      err(e) => err("not printable")
    }
  }
  if t == "bool" {
    return match jsonBool(j) {
      ok(b) => if b { ok("true") } else { ok("false") }
      err(e) => err("not printable")
    }
  }
  return err("not printable")
}

struct ParseState {
  template,
  pos,
  data,
  current_item
}

fn findBlockEnd(template, startPos, blockType) {
  let pos = startPos
  let depth = 1
  while pos < len(template) and depth > 0 {
    if pos + 1 < len(template) and template[pos] == "{" and template[pos + 1] == "{" {
      pos = pos + 2
      let tag = ""
      while pos < len(template) and not (template[pos] == "}" and pos + 1 < len(template) and template[pos + 1] == "}") {
        tag = tag + template[pos]
        pos = pos + 1
      }
      if pos + 1 < len(template) {
        pos = pos + 2
      }
      let trimmedTag = trim(tag)
      if blockType == "if" and startsWith(trimmedTag, "#if ") {
        depth = depth + 1
      } else if blockType == "if" and startsWith(trimmedTag, "/if") {
        depth = depth - 1
      } else if blockType == "each" and startsWith(trimmedTag, "#each ") {
        depth = depth + 1
      } else if blockType == "each" and startsWith(trimmedTag, "/each") {
        depth = depth - 1
      }
    } else {
      pos = pos + 1
    }
  }
  return pos
}

fn parseTemplate(template, data) {
  let state = ParseState {
    template: template,
    pos: 0,
    data: data,
    current_item: parseJson("null")?
  }
  match parseBlock(state, "") {
    ok(result) => return ok(result)
    err(e) => return err(e)
  }
}

fn parseBlock(state, endTag) {
  let output = ""
  while state.pos < len(state.template) {
    if state.pos + 1 < len(state.template) and state.template[state.pos] == "{" and state.template[state.pos + 1] == "{" {
      state.pos = state.pos + 2
      let tag = ""
      while state.pos < len(state.template) and not (state.template[state.pos] == "}" and state.pos + 1 < len(state.template) and state.template[state.pos + 1] == "}") {
        tag = tag + state.template[state.pos]
        state.pos = state.pos + 1
      }
      if state.pos + 1 >= len(state.template) {
        return err("unclosed tag")
      }
      state.pos = state.pos + 2
      let trimmedTag = trim(tag)
      if startsWith(trimmedTag, "#if ") {
        let condName = trim(slice(trimmedTag, 4, len(trimmedTag)))
        match parseIfBlock(state, condName) {
          ok(content) => output = output + content
          err(e) => return err(e)
        }
      } else if startsWith(trimmedTag, "#each ") {
        let listName = trim(slice(trimmedTag, 6, len(trimmedTag)))
        match parseEachBlock(state, listName) {
          ok(content) => output = output + content
          err(e) => return err(e)
        }
      } else if startsWith(trimmedTag, "/if") {
        if endTag == "if" {
          return ok(output)
        } else {
          return err("unexpected /if")
        }
      } else if startsWith(trimmedTag, "/each") {
        if endTag == "each" {
          return ok(output)
        } else {
          return err("unexpected /each")
        }
      } else {
        let varName = trimmedTag
        if varName == "." {
          match valueToString(state.current_item) {
            ok(s) => output = output + s
            err(e) => return err(e)
          }
        } else {
          let lookupData = state.current_item
          if jsonType(state.current_item) == "object" {
            match get(state.current_item, varName) {
              ok(val) => {
                match valueToString(val) {
                  ok(s) => output = output + s
                  err(e) => return err(e)
                }
              }
              err(e) => {
                match getValue(state.data, varName) {
                  ok(val) => {
                    match valueToString(val) {
                      ok(s) => output = output + s
                      err(e) => return err(e)
                    }
                  }
                  err(e) => return err(e)
                }
              }
            }
          } else {
            match getValue(state.data, varName) {
              ok(val) => {
                match valueToString(val) {
                  ok(s) => output = output + s
                  err(e) => return err(e)
                }
              }
              err(e) => return err(e)
            }
          }
        }
      }
    } else {
      output = output + state.template[state.pos]
      state.pos = state.pos + 1
    }
  }
  if endTag != "" {
    if endTag == "if" {
      return err("unclosed if")
    } else if endTag == "each" {
      return err("unclosed each")
    }
  }
  return ok(output)
}

fn parseIfBlock(state, condName) {
  let condVal = if jsonType(state.current_item) == "object" {
    match get(state.current_item, condName) {
      ok(v) => v
      err(e) => match getValue(state.data, condName) {
        ok(v) => v
        err(e) => parseJson("null")?
      }
    }
  } else {
    match getValue(state.data, condName) {
      ok(v) => v
      err(e) => parseJson("null")?
    }
  }

  if isTruthy(condVal) {
    match parseBlock(state, "if") {
      ok(content) => return ok(content)
      err(e) => return err(e)
    }
  } else {
    let startPos = state.pos
    let endPos = findBlockEnd(state.template, state.pos, "if")
    state.pos = endPos
    return ok("")
  }
}

fn parseEachBlock(state, listName) {
  let listVal = if jsonType(state.current_item) == "object" {
    match get(state.current_item, listName) {
      ok(v) => v
      err(e) => match getValue(state.data, listName) {
        ok(v) => v
        err(e) => parseJson("null")?
      }
    }
  } else {
    match getValue(state.data, listName) {
      ok(v) => v
      err(e) => parseJson("null")?
    }
  }

  let t = jsonType(listVal)
  if t != "array" {
    if t == "null" {
      let endPos = findBlockEnd(state.template, state.pos, "each")
      state.pos = endPos
      return ok("")
    } else {
      return err("not a list: " + listName)
    }
  }

  let items = jsonList(listVal)
  let blockStart = state.pos
  let blockEnd = findBlockEnd(state.template, blockStart, "each")
  let blockTemplate = slice(state.template, blockStart, blockEnd - 7)

  let output = ""
  for item in items {
    let itemState = ParseState {
      template: blockTemplate,
      pos: 0,
      data: state.data,
      current_item: item
    }
    match parseBlock(itemState, "each") {
      ok(content) => output = output + content
      err(e) => return err(e)
    }
  }

  state.pos = blockEnd
  return ok(output)
}

fn main() {
  let args_list = args()
  if len(args_list) < 2 {
    return ok(true)
  }

  let template = args_list[0]
  let dataStr = args_list[1]

  match parseJson(dataStr) {
    ok(dataJson) => {
      if jsonType(dataJson) != "object" {
        print("error: bad data")
        return ok(true)
      }
      match parseTemplate(template, dataJson) {
        ok(output) => print(output)
        err(e) => print("error: " + e)
      }
    }
    err(e) => {
      print("error: bad data")
    }
  }
  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
