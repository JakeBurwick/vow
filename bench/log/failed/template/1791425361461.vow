struct Context {
  data,
  stack
}

fn isTruthy(v) {
  let t = jsonType(v)
  if t == "null" { return false }
  if t == "bool" { return jsonBool(v) }
  if t == "number" { return jsonNum(v) != 0 }
  if t == "string" { return jsonStr(v) != "" }
  if t == "array" { return len(jsonList(v)) > 0 }
  if t == "object" { return len(jsonKeys(v)) > 0 }
  return false
}

fn getValue(ctx, name) {
  let i = len(ctx.stack) - 1
  while i >= 0 {
    let scope = ctx.stack[i]
    let v = get(scope, name)
    if match v { ok(val) => true err(_) => false } {
      return match v { ok(val) => ok(val) err(_) => err("") }
    }
    i = i - 1
  }
  return err("missing")
}

fn formatValue(v) {
  let t = jsonType(v)
  if t == "string" { return ok(jsonStr(v)?) }
  if t == "number" {
    let n = jsonNum(v)?
    return ok(str(n))
  }
  if t == "bool" {
    let b = jsonBool(v)?
    return ok(if b { "true" } else { "false" })
  }
  if t == "null" { return ok("") }
  return err("not printable")
}

fn findClosingTag(template, start, tag) {
  let depth = 1
  let pos = start
  while pos < len(template) {
    if pos + 2 < len(template) and template[pos] == "{" and template[pos + 1] == "{" {
      let rest = slice(template, pos + 2, len(template))
      if startsWith(rest, "#${tag}") or startsWith(rest, "#each") or startsWith(rest, "#if") {
        depth = depth + 1
      } else if startsWith(rest, "/${tag}") {
        depth = depth - 1
        if depth == 0 {
          return ok(pos)
        }
      }
    }
    pos = pos + 1
  }
  return err("unclosed")
}

fn parseTemplate(template, ctx) {
  let result = ""
  let pos = 0

  while pos < len(template) {
    if pos + 2 < len(template) and template[pos] == "{" and template[pos + 1] == "{" {
      let endBrace = pos + 2
      while endBrace + 1 < len(template) and not (template[endBrace] == "}" and template[endBrace + 1] == "}") {
        endBrace = endBrace + 1
      }
      if endBrace + 1 < len(template) {
        let tag = slice(template, pos + 2, endBrace)
        let trimmedTag = trim(tag)

        if startsWith(trimmedTag, "#if ") {
          let name = trim(slice(trimmedTag, 4, len(trimmedTag)))
          match findClosingTag(template, endBrace + 2, "if") {
            ok(closePos) => {
              let v = getValue(ctx, name)
              match v {
                ok(val) => {
                  if isTruthy(val) {
                    let body = slice(template, endBrace + 2, closePos)
                    match parseTemplate(body, ctx) {
                      ok(inner) => result = result + inner
                      err(e) => return err(e)
                    }
                  }
                }
                err(_) => {
                  // missing values are falsy in if
                }
              }
              pos = closePos + 6
            }
            err(e) => return err("error: unclosed if")
          }
        } else if startsWith(trimmedTag, "#each ") {
          let name = trim(slice(trimmedTag, 6, len(trimmedTag)))
          match getValue(ctx, name) {
            ok(listVal) => {
              if jsonType(listVal) != "array" {
                return err("error: not a list: ${name}")
              }
              let items = jsonList(listVal)
              match findClosingTag(template, endBrace + 2, "each") {
                ok(closePos) => {
                  let body = slice(template, endBrace + 2, closePos)
                  for item in items {
                    let newStack = []
                    push(newStack, toJson(item))
                    for scope in ctx.stack {
                      push(newStack, scope)
                    }
                    let itemCtx = Context { data: ctx.data, stack: newStack }
                    match parseTemplate(body, itemCtx) {
                      ok(inner) => result = result + inner
                      err(e) => return err(e)
                    }
                  }
                  pos = closePos + 8
                }
                err(e) => return err("error: unclosed each")
              }
            }
            err(_) => {
              // missing names in #each render nothing
              match findClosingTag(template, endBrace + 2, "each") {
                ok(closePos) => {
                  pos = closePos + 8
                }
                err(e) => return err("error: unclosed each")
              }
            }
          }
        } else if startsWith(trimmedTag, "/if") {
          return err("error: unexpected /if")
        } else if startsWith(trimmedTag, "/each") {
          return err("error: unexpected /each")
        } else {
          let name = trimmedTag
          match getValue(ctx, name) {
            ok(val) => {
              match formatValue(val) {
                ok(s) => result = result + s
                err(e) => return err("error: ${e}")
              }
            }
            err(_) => {
              // missing name renders nothing
            }
          }
          pos = endBrace + 2
        }
      } else {
        result = result + template[pos]
        pos = pos + 1
      }
    } else {
      result = result + template[pos]
      pos = pos + 1
    }
  }

  return ok(result)
}

fn main() {
  let args_list = args()
  if len(args_list) < 2 {
    print("error: missing args")
    return ok(true)
  }

  let template = args_list[0]
  let dataStr = args_list[1]

  match parseJson(dataStr) {
    ok(j) => {
      if jsonType(j) != "object" {
        print("error: bad data")
      } else {
        let stack = [j]
        let ctx = Context { data: j, stack: stack }
        match parseTemplate(template, ctx) {
          ok(result) => print(result)
          err(e) => print(e)
        }
      }
    }
    err(e) => {
      print("error: bad data")
    }
  }
  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
