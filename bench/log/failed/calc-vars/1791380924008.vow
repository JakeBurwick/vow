struct Token {
  type,  // "num", "var", "op", "lparen", "rparen", "eof"
  value
}

struct Parser {
  tokens,
  pos
}

let vars = {}

fn isValidVarName(s) {
  if len(s) == 0 {
    return false
  }
  let first = s[0]
  if not ((first >= "a" and first <= "z") or (first >= "A" and first <= "Z") or first == "_") {
    return false
  }
  for i in range(1, len(s)) {
    let c = s[i]
    if not ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_") {
      return false
    }
  }
  return true
}

fn tokenize(s) {
  let tokens = []
  let i = 0
  while i < len(s) {
    let c = s[i]
    if c == " " {
      i = i + 1
    } else if c == "(" {
      push(tokens, Token { type: "lparen", value: "(" })
      i = i + 1
    } else if c == ")" {
      push(tokens, Token { type: "rparen", value: ")" })
      i = i + 1
    } else if c == "+" or c == "*" or c == "/" {
      push(tokens, Token { type: "op", value: c })
      i = i + 1
    } else if c == "-" {
      push(tokens, Token { type: "op", value: "-" })
      i = i + 1
    } else if (c >= "0" and c <= "9") or c == "." {
      let num_str = ""
      while i < len(s) and ((s[i] >= "0" and s[i] <= "9") or s[i] == ".") {
        num_str = num_str + s[i]
        i = i + 1
      }
      push(tokens, Token { type: "num", value: num_str })
    } else if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" {
      let var_str = ""
      while i < len(s) and ((s[i] >= "a" and s[i] <= "z") or (s[i] >= "A" and s[i] <= "Z") or (s[i] >= "0" and s[i] <= "9") or s[i] == "_") {
        var_str = var_str + s[i]
        i = i + 1
      }
      push(tokens, Token { type: "var", value: var_str })
    } else {
      return err("syntax")
    }
  }
  push(tokens, Token { type: "eof", value: "" })
  return ok(tokens)
}

fn peek(p) {
  return p.tokens[p.pos]
}

fn advance(p) {
  p.pos = p.pos + 1
}

fn parseExpr(p) {
  let left = parseTerm(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "+" or tok.value == "-") {
      let op = tok.value
      advance(p)
      let right = parseTerm(p)?
      if op == "+" {
        left = left + right
      } else {
        left = left - right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseTerm(p) {
  let left = parseFactor(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "*" or tok.value == "/") {
      let op = tok.value
      advance(p)
      let right = parseFactor(p)?
      if op == "*" {
        left = left * right
      } else {
        if right == 0 {
          return err("division by zero")
        }
        left = left / right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseFactor(p) {
  let tok = peek(p)
  if tok.type == "op" and tok.value == "-" {
    advance(p)
    let val = parseFactor(p)?
    return ok(0 - val)
  } else if tok.type == "num" {
    advance(p)
    let val = num(tok.value)?
    return ok(val)
  } else if tok.type == "var" {
    advance(p)
    let var_name = tok.value
    match get(vars, var_name) {
      ok(v) => return ok(v)
      err(e) => return err("unknown variable " + var_name)
    }
  } else if tok.type == "lparen" {
    advance(p)
    let val = parseExpr(p)?
    let close = peek(p)
    if close.type != "rparen" {
      return err("syntax")
    }
    advance(p)
    return ok(val)
  } else {
    return err("syntax")
  }
}

fn formatNumber(n) {
  let is_whole = n == floor(n)
  if is_whole {
    return str(n)
  } else {
    return fixed(round(n, 10), 10)
  }
}

fn main() {
  let input = args()[0]
  let lines = lines(input)

  for line_num in range(1, len(lines) + 1) {
    let line = lines[line_num - 1]
    let trimmed = trim(line)

    // Skip blank lines
    if len(trimmed) == 0 {
      continue
    }

    // Find equals sign
    match indexOf(trimmed, "=") {
      ok(eq_pos) => {
        let name_part = trim(slice(trimmed, 0, eq_pos))
        let expr_part = trim(slice(trimmed, eq_pos + 1, len(trimmed)))

        // Validate variable name
        if not isValidVarName(name_part) {
          print("error line " + str(line_num) + ": syntax")
          return ok(true)
        }

        // Parse and evaluate expression
        match tokenize(expr_part) {
          ok(tokens) => {
            let p = Parser { tokens: tokens, pos: 0 }
            match parseExpr(p) {
              ok(result) => {
                let final = peek(p)
                if final.type != "eof" {
                  print("error line " + str(line_num) + ": syntax")
                  return ok(true)
                }
                // Store variable
                vars[name_part] = result
              }
              err(e) => {
                if startsWith(e, "unknown variable") {
                  let var_name = slice(e, len("unknown variable "), len(e))
                  print("error line " + str(line_num) + ": unknown variable " + var_name)
                } else if e == "division by zero" {
                  print("error line " + str(line_num) + ": division by zero")
                } else {
                  print("error line " + str(line_num) + ": syntax")
                }
                return ok(true)
              }
            }
          }
          err(e) => {
            print("error line " + str(line_num) + ": syntax")
            return ok(true)
          }
        }
      }
      err(e) => {
        print("error line " + str(line_num) + ": syntax")
        return ok(true)
      }
    }
  }

  // Print variables sorted by name
  let var_names = sort(keys(vars))
  for name in var_names {
    let value = vars[name]
    print("{name} = {formatNumber(value)}")
  }

  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
