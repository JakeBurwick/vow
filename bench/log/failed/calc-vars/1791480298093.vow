struct Token {
  type,
  value
}

struct Parser {
  tokens,
  pos,
  variables
}

fn tokenize(s) {
  let tokens = []
  let chars = split(s, "")
  let i = 0

  while i < len(chars) {
    let c = chars[i]

    if c == " " {
      i = i + 1
    } else if c == "(" {
      push(tokens, Token { type: "lparen", value: "(" })
      i = i + 1
    } else if c == ")" {
      push(tokens, Token { type: "rparen", value: ")" })
      i = i + 1
    } else if c == "+" or c == "*" or c == "/" {
      push(tokens, Token { type: "op", value: c })
      i = i + 1
    } else if c == "-" {
      push(tokens, Token { type: "minus", value: "-" })
      i = i + 1
    } else if c >= "0" and c <= "9" {
      let num_str = ""
      while i < len(chars) and ((chars[i] >= "0" and chars[i] <= "9") or chars[i] == ".") {
        num_str = num_str + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "num", value: num_str })
    } else if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" {
      let var_name = ""
      while i < len(chars) and ((chars[i] >= "a" and chars[i] <= "z") or (chars[i] >= "A" and chars[i] <= "Z") or (chars[i] >= "0" and chars[i] <= "9") or chars[i] == "_") {
        var_name = var_name + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "var", value: var_name })
    } else {
      return err("syntax")
    }
  }

  push(tokens, Token { type: "eof", value: "" })
  return ok(tokens)
}

fn peek(p) {
  return p.tokens[p.pos]
}

fn advance(p) {
  p.pos = p.pos + 1
}

fn parseExpr(p) {
  let left = parseTerm(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "+" or tok.value == "-") {
      let op = tok.value
      advance(p)
      let right = parseTerm(p)?
      if op == "+" {
        left = left + right
      } else {
        left = left - right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseTerm(p) {
  let left = parseUnary(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "*" or tok.value == "/") {
      let op = tok.value
      advance(p)
      let right = parseUnary(p)?
      if op == "*" {
        left = left * right
      } else {
        if right == 0 {
          return err("division by zero")
        }
        left = left / right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseUnary(p) {
  let tok = peek(p)
  if tok.type == "minus" {
    advance(p)
    let val = parseUnary(p)?
    return ok(0 - val)
  } else {
    return parsePrimary(p)
  }
}

fn parsePrimary(p) {
  let tok = peek(p)
  if tok.type == "num" {
    advance(p)
    let val = num(tok.value)?
    return ok(val)
  } else if tok.type == "var" {
    advance(p)
    if has(p.variables, tok.value) {
      return ok(p.variables[tok.value])
    } else {
      return err("unknown variable " + tok.value)
    }
  } else if tok.type == "lparen" {
    advance(p)
    let val = parseExpr(p)?
    let close = peek(p)
    if close.type != "rparen" {
      return err("syntax")
    }
    advance(p)
    return ok(val)
  } else {
    return err("syntax")
  }
}

fn formatValue(n) {
  if isInt(n) {
    return str(n)
  } else {
    return sig(n, 10)
  }
}

fn main() {
  let args_list = args()
  let input = match get(args_list, 0) { ok(s) => s err(e) => "" }

  let lines = split(input, "\n")
  let variables = {}
  let line_num = 0

  for line in lines {
    line_num = line_num + 1

    if len(trim(line)) == 0 {
      continue
    }

    let eq_pos = indexOf(line, "=")
    match eq_pos {
      err(e) => {
        print("error line " + str(line_num) + ": syntax")
        return
      }
      ok(pos) => {
        let name = trim(slice(line, 0, pos))
        let expr_str = trim(slice(line, pos + 1, len(line)))

        if len(name) == 0 {
          print("error line " + str(line_num) + ": syntax")
          return
        }

        let first = name[0]
        if (first >= "0" and first <= "9") {
          print("error line " + str(line_num) + ": syntax")
          return
        }

        match tokenize(expr_str) {
          err(e) => {
            print("error line " + str(line_num) + ": " + e)
            return
          }
          ok(tokens) => {
            let p = Parser { tokens: tokens, pos: 0, variables: variables }
            match parseExpr(p) {
              err(e) => {
                print("error line " + str(line_num) + ": " + e)
                return
              }
              ok(result) => {
                let final = peek(p)
                if final.type != "eof" {
                  print("error line " + str(line_num) + ": syntax")
                  return
                }
                variables[name] = result
              }
            }
          }
        }
      }
    }
  }

  let var_names = keys(variables)
  var_names = sort(var_names)

  for name in var_names {
    let value = variables[name]
    let value_str = formatValue(value)
    print(name + " = " + value_str)
  }
}

main()
