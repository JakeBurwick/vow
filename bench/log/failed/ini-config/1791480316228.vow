fn main() {
  let args_list = args()

  if len(args_list) < 1 {
    return ok(true)
  }

  let ini_content = args_list[0]
  let ini_lines = lines(ini_content)

  let sections = {}
  let current_section = ""

  for i in range(0, len(ini_lines)) {
    let line_num = i + 1
    let line = ini_lines[i]
    let trimmed = trim(line)

    if len(trimmed) == 0 {
      continue
    }

    if startsWith(trimmed, ";") or startsWith(trimmed, "#") {
      continue
    }

    if startsWith(trimmed, "[") and endsWith(trimmed, "]") {
      let section_name = slice(trimmed, 1, len(trimmed) - 1)
      let section_lower = lower(section_name)
      current_section = section_lower
      if not has(sections, section_lower) {
        sections[section_lower] = {}
      }
      continue
    }

    let eq_pos = indexOf(trimmed, "=")
    match eq_pos {
      ok(pos) => {
        if current_section == "" {
          print("error line ${line_num}: key outside section")
          return ok(true)
        }

        let key_part = trim(slice(trimmed, 0, pos))
        let value_part = trim(slice(trimmed, pos + 1, len(trimmed)))

        if not isValidKeyName(key_part) {
          print("error line ${line_num}: bad line")
          return ok(true)
        }

        let key_lower = lower(key_part)
        let section_map = sections[current_section]
        section_map[key_lower] = value_part
      }
      err(_) => {
        print("error line ${line_num}: bad line")
        return ok(true)
      }
    }
  }

  for j in range(1, len(args_list)) {
    let query = args_list[j]
    match parseQuery(query) {
      ok(sq) => {
        let section_name = sq.section
        let key_name = sq.key

        if has(sections, section_name) {
          let section_map = sections[section_name]
          if has(section_map, key_name) {
            let value = section_map[key_name]
            print("${query} = ${value}")
          } else {
            print("${query} missing")
          }
        } else {
          print("${query} missing")
        }
      }
      err(_) => {
        print("${query} missing")
      }
    }
  }

  return ok(true)
}

struct SectionQuery {
  section,
  key
}

fn parseQuery(query) {
  match indexOf(query, ".") {
    ok(pos) => {
      let section_part = slice(query, 0, pos)
      let key_part = slice(query, pos + 1, len(query))

      let section_lower = lower(section_part)
      let key_lower = lower(key_part)

      return ok(SectionQuery { section: section_lower, key: key_lower })
    }
    err(_) => {
      return err("no dot")
    }
  }
}

fn isValidKeyName(name) {
  if len(name) == 0 {
    return false
  }

  for c in split(name, "") {
    if not ((c >= "a" and c <= "z") or (c >= "0" and c <= "9") or c == "_") {
      return false
    }
  }

  return true
}

match main() {
  ok(_) => {}
  err(e) => print(e)
}
