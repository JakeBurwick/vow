fn isLowercase(s) {
  if len(s) == 0 { return false }
  for c in split(s, "") {
    if not (c >= "a" and c <= "z") { return false }
  }
  return true
}

fn main() {
  let args_list = args()
  let input = match get(args_list, 0) { ok(s) => s err(e) => "" }

  if input == "" {
    print("")
    return
  }

  let entries = split(input, ";")
  let deps_map = {}
  let all_packages = []

  for entry in entries {
    if len(trim(entry)) == 0 { continue }

    let parts = split(entry, ":")
    if len(parts) != 2 {
      print("error: bad entry " + entry)
      return
    }

    let name = parts[0]
    let deps_str = parts[1]

    if not isLowercase(name) {
      print("error: bad entry " + entry)
      return
    }

    if not has(deps_map, name) {
      push(all_packages, name)
    }

    let deps = if len(deps_str) == 0 { [] } else { split(deps_str, ",") }

    for dep in deps {
      if not isLowercase(dep) {
        print("error: bad entry " + entry)
        return
      }
      if not has(deps_map, name) {
        deps_map[name] = []
      }
    }

    if has(deps_map, name) {
      deps_map[name] = deps
    } else {
      deps_map[name] = deps
    }

    for dep in deps {
      if not has(deps_map, dep) {
        push(all_packages, dep)
        deps_map[dep] = []
      }
    }
  }

  all_packages = sort(all_packages)

  let in_degree = {}
  for pkg in all_packages {
    in_degree[pkg] = 0
  }

  for pkg in all_packages {
    let pkg_deps = deps_map[pkg]
    for dep in pkg_deps {
      if has(in_degree, dep) {
        in_degree[dep] = in_degree[dep] + 1
      } else {
        in_degree[dep] = 1
      }
    }
  }

  let queue = []
  for pkg in all_packages {
    if in_degree[pkg] == 0 {
      push(queue, pkg)
    }
  }

  queue = sort(queue)

  let result = []
  let processed = 0

  while len(queue) > 0 {
    let current = queue[0]
    queue = slice(queue, 1, len(queue))
    push(result, current)
    processed = processed + 1

    let pkg_deps = deps_map[current]
    let ready = []

    for dep in pkg_deps {
      in_degree[dep] = in_degree[dep] - 1
      if in_degree[dep] == 0 {
        push(ready, dep)
      }
    }

    for pkg in ready {
      push(queue, pkg)
    }
    queue = sort(queue)
  }

  if processed != len(all_packages) {
    print("error: cycle")
  } else {
    print(join(result, " "))
  }
}

main()
