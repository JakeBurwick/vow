struct TableData {
  header,
  rows
}

fn parseTable(csv) {
  let lines = split(csv, "\n")
  let non_blank_lines = []
  for line in lines {
    if len(trim(line)) > 0 {
      push(non_blank_lines, line)
    }
  }

  if len(non_blank_lines) == 0 {
    return err("empty")
  }

  let header = split(non_blank_lines[0], ",")
  let rows = {}

  for i in range(1, len(non_blank_lines)) {
    let row = split(non_blank_lines[i], ",")
    if len(row) > 0 {
      let key = row[0]
      rows[key] = row
    }
  }

  return ok(TableData { header: header, rows: rows })
}

fn compareTables(old_data, new_data) {
  let all_keys = {}
  for k in keys(old_data.rows) {
    all_keys[k] = true
  }
  for k in keys(new_data.rows) {
    all_keys[k] = true
  }

  let sorted_keys = sort(keys(all_keys))
  let has_changes = false

  for key in sorted_keys {
    let old_has = has(old_data.rows, key)
    let new_has = has(new_data.rows, key)

    if old_has and not new_has {
      print("- ${key}")
      has_changes = true
    } else if not old_has and new_has {
      print("+ ${key}")
      has_changes = true
    } else if old_has and new_has {
      let old_row = old_data.rows[key]
      let new_row = new_data.rows[key]

      for col_idx in range(1, len(old_data.header)) {
        let old_val = match get(old_row, col_idx) { ok(v) => v err(e) => "" }
        let new_val = match get(new_row, col_idx) { ok(v) => v err(e) => "" }

        if old_val != new_val {
          let col_name = old_data.header[col_idx]
          print("~ ${key}: ${col_name} ${old_val} -> ${new_val}")
          has_changes = true
        }
      }
    }
  }

  if not has_changes {
    print("no changes")
  }
}

fn main() {
  let args_list = args()
  let old_csv = match get(args_list, 0) { ok(s) => s err(e) => "" }
  let new_csv = match get(args_list, 1) { ok(s) => s err(e) => "" }

  match parseTable(old_csv) {
    ok(old_data) => {
      match parseTable(new_csv) {
        ok(new_data) => {
          if old_data.header != new_data.header {
            print("error: headers differ")
          } else {
            compareTables(old_data, new_data)
          }
        }
        err(e) => {
          print("error: headers differ")
        }
      }
    }
    err(e) => {
      print("error: headers differ")
    }
  }
}

main()
