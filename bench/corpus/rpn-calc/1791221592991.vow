let arg = args()[0]
let tokens = split(arg, " ")
let stack = []
let errored = false

for token in tokens {
  if not errored {
    if token == "+" or token == "-" or token == "*" or token == "/" {
      if len(stack) < 2 {
        errored = true
      } else {
        match pop(stack) {
          ok(b) => {
            match pop(stack) {
              ok(a) => {
                if token == "+" {
                  push(stack, a + b)
                } else if token == "-" {
                  push(stack, a - b)
                } else if token == "*" {
                  push(stack, a * b)
                } else {
                  if b == 0 {
                    errored = true
                  } else {
                    push(stack, a / b)
                  }
                }
              }
              err(e) => errored = true
            }
          }
          err(e) => errored = true
        }
      }
    } else {
      match num(token) {
        ok(n) => push(stack, n)
        err(e) => errored = true
      }
    }
  }
}

if errored {
  print("error")
} else if len(stack) == 1 {
  print(str(stack[0]))
} else {
  print("error")
}
