fn evaluateRPN(expr) {
  let tokens = split(expr, " ")
  let stack = []

  for token in tokens {
    if token == "+" or token == "-" or token == "*" or token == "/" {
      if len(stack) < 2 {
        return err("error")
      }

      match pop(stack) {
        ok(b_str) => {
          match pop(stack) {
            ok(a_str) => {
              match num(a_str) {
                ok(a) => {
                  match num(b_str) {
                    ok(b) => {
                      let result = 0
                      if token == "+" {
                        result = a + b
                      } else if token == "-" {
                        result = a - b
                      } else if token == "*" {
                        result = a * b
                      } else {
                        if b == 0 {
                          return err("error")
                        }
                        result = a / b
                      }
                      push(stack, str(result))
                    }
                    err(e) => { return err("error") }
                  }
                }
                err(e) => { return err("error") }
              }
            }
            err(e) => { return err("error") }
          }
        }
        err(e) => { return err("error") }
      }
    } else {
      match num(token) {
        ok(n) => {
          push(stack, token)
        }
        err(e) => { return err("error") }
      }
    }
  }

  if len(stack) == 1 {
    let result_str = stack[0]
    match num(result_str) {
      ok(n) => {
        return ok(floor(n))
      }
      err(e) => { return err("error") }
    }
  } else {
    return err("error")
  }
}

let input = args()[0]
match evaluateRPN(input) {
  ok(result) => {
    print(str(result))
  }
  err(e) => {
    print("error")
  }
}
