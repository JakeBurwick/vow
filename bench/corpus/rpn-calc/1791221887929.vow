fn isOperator(token) {
  return token == "+" or token == "-" or token == "*" or token == "/"
}

fn evaluateRPN(expr) {
  let tokens = split(expr, " ")
  let stack = []

  for token in tokens {
    if token == "" {
      continue
    }

    if isOperator(token) {
      if len(stack) < 2 {
        return err("error")
      }

      match pop(stack) {
        ok(b_val) => {
          match pop(stack) {
            ok(a_val) => {
              let result = 0

              if token == "+" {
                result = a_val + b_val
              } else if token == "-" {
                result = a_val - b_val
              } else if token == "*" {
                result = a_val * b_val
              } else if token == "/" {
                if b_val == 0 {
                  return err("error")
                }
                result = a_val / b_val
              }

              push(stack, result)
            }
            err(e) => return err("error")
          }
        }
        err(e) => return err("error")
      }
    } else {
      match num(token) {
        ok(n) => push(stack, n)
        err(e) => return err("error")
      }
    }
  }

  if len(stack) != 1 {
    return err("error")
  }

  return ok(stack[0])
}

let args_list = args()
let input = match get(args_list, 0) {
  ok(s) => s
  err(e) => ""
}

match evaluateRPN(input) {
  ok(result) => {
    let result_int = floor(result)
    print(str(result_int))
  }
  err(e) => print("error")
}
