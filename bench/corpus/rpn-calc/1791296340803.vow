fn evaluate(expr) {
  let tokens = split(expr, " ")
  let stack = []

  for token in tokens {
    match num(token) {
      ok(n) => {
        push(stack, n)
      }
      err(_) => {
        if token == "+" or token == "-" or token == "*" or token == "/" {
          if len(stack) < 2 {
            return err("not enough operands")
          }
          match pop(stack) {
            ok(b) => {
              match pop(stack) {
                ok(a) => {
                  let result = 0
                  if token == "+" {
                    result = a + b
                  } else if token == "-" {
                    result = a - b
                  } else if token == "*" {
                    result = a * b
                  } else if token == "/" {
                    if b == 0 {
                      return err("division by zero")
                    }
                    result = a / b
                  }
                  push(stack, result)
                }
                err(_) => {
                  return err("not enough operands")
                }
              }
            }
            err(_) => {
              return err("not enough operands")
            }
          }
        } else {
          return err("unknown token")
        }
      }
    }
  }

  if len(stack) == 1 {
    match pop(stack) {
      ok(n) => {
        return ok(n)
      }
      err(_) => {
        return err("empty stack")
      }
    }
  } else {
    return err("leftover operands")
  }
}

let expr = args()[0]
match evaluate(expr) {
  ok(result) => {
    print(str(result))
  }
  err(_) => {
    print("error")
  }
}
