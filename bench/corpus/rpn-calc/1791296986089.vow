fn evaluateRPN(s) {
  let tokens = split(s, " ")
  let stack = []

  for token in tokens {
    if token == "" {
      continue
    }

    if token == "+" or token == "-" or token == "*" or token == "/" {
      // We need at least 2 operands on the stack
      if len(stack) < 2 {
        return err("error")
      }

      match pop(stack) {
        ok(b) => {
          match pop(stack) {
            ok(a) => {
              let result = 0
              if token == "+" {
                result = a + b
              } else if token == "-" {
                result = a - b
              } else if token == "*" {
                result = a * b
              } else if token == "/" {
                if b == 0 {
                  return err("error")
                }
                result = a / b
              }
              push(stack, result)
            }
            err(_) => {
              return err("error")
            }
          }
        }
        err(_) => {
          return err("error")
        }
      }
    } else {
      // Try to parse as a number
      match num(token) {
        ok(n) => {
          push(stack, n)
        }
        err(_) => {
          return err("error")
        }
      }
    }
  }

  // At the end, there should be exactly 1 value on the stack
  if len(stack) != 1 {
    return err("error")
  }

  return ok(stack[0])
}

let input = args()[0]
match evaluateRPN(input) {
  ok(result) => {
    // Convert to integer and print without decimal point
    let intResult = floor(result)
    print(str(intResult))
  }
  err(_) => {
    print("error")
  }
}
