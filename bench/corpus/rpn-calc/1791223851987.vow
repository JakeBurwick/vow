let input = args()[0]
let tokens = split(input, " ")
let stack = []
let error = false

for token in tokens {
  if token == "+" or token == "-" or token == "*" or token == "/" {
    match pop(stack) {
      ok(b) => {
        match pop(stack) {
          ok(a) => {
            if token == "+" {
              push(stack, a + b)
            } else if token == "-" {
              push(stack, a - b)
            } else if token == "*" {
              push(stack, a * b)
            } else if token == "/" {
              if b == 0 {
                error = true
              } else {
                push(stack, a / b)
              }
            }
          }
          err(e) => {
            error = true
          }
        }
      }
      err(e) => {
        error = true
      }
    }
  } else {
    match num(token) {
      ok(n) => {
        push(stack, n)
      }
      err(e) => {
        error = true
      }
    }
  }
}

if error or len(stack) != 1 {
  print("error")
} else {
  let result = stack[0]
  print(str(round(result, 0)))
}
