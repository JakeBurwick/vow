fn evaluateRpn(expr) {
  let tokens = split(expr, " ")
  let stack = []

  for token in tokens {
    if token == "+" or token == "-" or token == "*" or token == "/" {
      if len(stack) < 2 {
        return err("error")
      }

      let b_result = pop(stack)
      let a_result = pop(stack)

      match b_result {
        ok(b) => {
          match a_result {
            ok(a) => {
              let result = 0
              if token == "+" {
                result = a + b
              } else if token == "-" {
                result = a - b
              } else if token == "*" {
                result = a * b
              } else if token == "/" {
                if b == 0 {
                  return err("error")
                }
                result = a / b
              }
              push(stack, result)
            }
            err(e) => {
              return err("error")
            }
          }
        }
        err(e) => {
          return err("error")
        }
      }
    } else {
      match num(token) {
        ok(n) => {
          push(stack, n)
        }
        err(e) => {
          return err("error")
        }
      }
    }
  }

  if len(stack) == 1 {
    return ok(stack[0])
  } else {
    return err("error")
  }
}

let input = args()[0]
match evaluateRpn(input) {
  ok(result) => {
    print(str(result))
  }
  err(e) => {
    print("error")
  }
}
