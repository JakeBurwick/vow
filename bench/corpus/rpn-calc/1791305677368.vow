let expr = args()[0]
let tokens = split(expr, " ")
let stack = []
let valid = true

for token in tokens {
  if token == "+" or token == "-" or token == "*" or token == "/" {
    if len(stack) < 2 {
      valid = false
      break
    }

    match pop(stack) {
      ok(b) => {
        match pop(stack) {
          ok(a) => {
            if token == "+" {
              push(stack, a + b)
            } else if token == "-" {
              push(stack, a - b)
            } else if token == "*" {
              push(stack, a * b)
            } else if token == "/" {
              if b == 0 {
                valid = false
                break
              }
              push(stack, a / b)
            }
          }
          err(e) => {
            valid = false
            break
          }
        }
      }
      err(e) => {
        valid = false
        break
      }
    }
  } else {
    match num(token) {
      ok(n) => {
        push(stack, n)
      }
      err(e) => {
        valid = false
        break
      }
    }
  }
}

if valid and len(stack) == 1 {
  let result = stack[0]
  print(str(result))
} else {
  print("error")
}
