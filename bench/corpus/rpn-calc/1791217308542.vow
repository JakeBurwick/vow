fn main() {
  let args_list = args()
  let expr = match get(args_list, 0) { ok(str) => str err(e) => "" }

  if expr == "" {
    print("error")
    return ok(true)
  }

  let tokens = split(expr, " ")
  let stack = []

  for token in tokens {
    if token == "+" or token == "-" or token == "*" or token == "/" {
      if len(stack) < 2 {
        print("error")
        return ok(true)
      }

      match pop(stack) {
        ok(right) => {
          match pop(stack) {
            ok(left) => {
              let result = 0
              if token == "+" {
                result = left + right
              } else if token == "-" {
                result = left - right
              } else if token == "*" {
                result = left * right
              } else if token == "/" {
                if right == 0 {
                  print("error")
                  return ok(true)
                }
                result = left / right
              }
              push(stack, result)
            }
            err(e) => {
              print("error")
              return ok(true)
            }
          }
        }
        err(e) => {
          print("error")
          return ok(true)
        }
      }
    } else {
      match num(token) {
        ok(n) => {
          push(stack, n)
        }
        err(e) => {
          print("error")
          return ok(true)
        }
      }
    }
  }

  if len(stack) != 1 {
    print("error")
    return ok(true)
  }

  let result = stack[0]
  print(str(result))
  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
