fn main() {
  let args_list = args()
  let text = args_list[0]
  let widthStr = args_list[1]

  // Check if width is valid
  match num(widthStr) {
    ok(w) => {
      if w <= 0 {
        print("error: bad width")
        return
      }

      let width = w
      let words = split(text, " ")
      let filteredWords = []

      // Filter out empty words (from multiple spaces)
      for word in words {
        if word != "" {
          push(filteredWords, word)
        }
      }

      if len(filteredWords) == 0 {
        return
      }

      let lineNum = 1
      let currentLine = ""

      for i in range(0, len(filteredWords)) {
        let word = filteredWords[i]

        if currentLine == "" {
          // Start a new line
          currentLine = word
        } else {
          // Try to add word to current line
          let testLine = currentLine + " " + word
          if len(testLine) <= width {
            currentLine = testLine
          } else {
            // Word doesn't fit, print current line and start new one
            print("${lineNum}: ${currentLine}")
            lineNum = lineNum + 1
            currentLine = word
          }
        }
      }

      // Print last line if it exists
      if currentLine != "" {
        print("${lineNum}: ${currentLine}")
      }
    }
    err(e) => {
      print("error: bad width")
    }
  }
}

main()
