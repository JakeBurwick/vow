fn bfs(graph, start, goal) {
  if start == goal {
    return ok([start])
  }

  let queue = [[start]]
  let visited = {}
  visited[start] = true

  while len(queue) > 0 {
    let path = queue[0]
    queue = slice(queue, 1, len(queue))
    let node = path[len(path) - 1]

    if has(graph, node) {
      let neighbors = graph[node]
      neighbors = sort(neighbors)
      for neighbor in neighbors {
        if neighbor == goal {
          let result = []
          for n in path {
            push(result, n)
          }
          push(result, neighbor)
          return ok(result)
        }
        if not has(visited, neighbor) {
          visited[neighbor] = true
          let new_path = []
          for n in path {
            push(new_path, n)
          }
          push(new_path, neighbor)
          push(queue, new_path)
        }
      }
    }
  }

  return err("no path")
}

fn main() {
  let args_list = args()
  let edges_str = args_list[0]
  let start = args_list[1]
  let goal = args_list[2]

  let edges = split(edges_str, ",")
  let graph = {}

  for edge in edges {
    let parts = split(edge, "-")
    let a = parts[0]
    let b = parts[1]

    if not has(graph, a) {
      graph[a] = []
    }
    push(graph[a], b)

    if not has(graph, b) {
      graph[b] = []
    }
    push(graph[b], a)
  }

  if not has(graph, start) or not has(graph, goal) {
    print("no path")
    return
  }

  match bfs(graph, start, goal) {
    ok(path) => {
      print(join(path, " -> "))
    }
    err(e) => print("no path")
  }
}

main()
