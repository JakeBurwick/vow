fn findShortestPath(edges, start, goal) {
  // Build adjacency list
  let graph = {}
  for edge in edges {
    let parts = split(edge, "-")
    if len(parts) != 2 {
      continue
    }
    let a = parts[0]
    let b = parts[1]

    // Ensure both nodes are in graph
    if not has(graph, a) {
      graph[a] = []
    }
    if not has(graph, b) {
      graph[b] = []
    }

    // Add edges (undirected)
    push(graph[a], b)
    push(graph[b], a)
  }

  // Check if start and goal exist
  if not has(graph, start) or not has(graph, goal) {
    return err("no path")
  }

  // If start equals goal
  if start == goal {
    return ok(start)
  }

  // BFS to find shortest path
  let queue = []
  push(queue, start)

  let visited = {}
  visited[start] = true

  let parent = {}
  parent[start] = ""

  let found = false
  while len(queue) > 0 {
    let current = queue[0]
    queue = slice(queue, 1, len(queue))

    let neighbors = graph[current]
    // Sort neighbors alphabetically to ensure we explore in order
    let sorted_neighbors = sort(neighbors)

    for neighbor in sorted_neighbors {
      if not has(visited, neighbor) {
        visited[neighbor] = true
        parent[neighbor] = current
        push(queue, neighbor)

        if neighbor == goal {
          found = true
          break
        }
      }
    }

    if found {
      break
    }
  }

  if not found {
    return err("no path")
  }

  // Reconstruct path
  let path = []
  let node = goal
  while node != "" {
    push(path, node)
    node = parent[node]
  }

  // Reverse path
  let result = []
  let i = len(path) - 1
  while i >= 0 {
    push(result, path[i])
    i = i - 1
  }

  let pathStr = join(result, " -> ")
  return ok(pathStr)
}

let args_list = args()
if len(args_list) < 3 {
  print("no path")
} else {
  let edges_str = args_list[0]
  let start = args_list[1]
  let goal = args_list[2]

  let edges = split(edges_str, ",")

  match findShortestPath(edges, start, goal) {
    ok(path) => print(path)
    err(e) => print(e)
  }
}
