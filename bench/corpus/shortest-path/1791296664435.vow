fn main() {
  let args_list = args()

  let edges_str = args_list[0]
  let start = args_list[1]
  let goal = args_list[2]

  if start == goal {
    print(start)
    return ok(true)
  }

  // Build graph
  let graph = {}
  let nodes = {}
  let edges = split(edges_str, ",")

  for edge in edges {
    let parts = split(edge, "-")
    if len(parts) == 2 {
      let a = parts[0]
      let b = parts[1]
      nodes[a] = true
      nodes[b] = true

      if not has(graph, a) {
        graph[a] = []
      }
      if not has(graph, b) {
        graph[b] = []
      }
      push(graph[a], b)
      push(graph[b], a)
    }
  }

  // Check if nodes exist
  if not has(nodes, start) or not has(nodes, goal) {
    print("no path")
    return ok(true)
  }

  // BFS
  let queue = [start]
  let visited = {}
  visited[start] = true
  let parent = {}
  let found = false

  while len(queue) > 0 and not found {
    let current = queue[0]
    queue = slice(queue, 1, len(queue))

    if current == goal {
      found = true
      break
    }

    let neighbors = sort(graph[current])

    for neighbor in neighbors {
      if not has(visited, neighbor) {
        visited[neighbor] = true
        parent[neighbor] = current
        push(queue, neighbor)
      }
    }
  }

  if not found {
    print("no path")
  } else {
    let path = []
    let node = goal
    while true {
      push(path, node)
      if node == start {
        break
      }
      node = parent[node]
    }
    path = reverse(path)
    print(join(path, " -> "))
  }

  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
