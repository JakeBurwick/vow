fn main() {
  let argv = args()
  if len(argv) < 3 {
    print("no path")
    return ok(true)
  }

  let edges_str = argv[0]
  let start = argv[1]
  let goal = argv[2]

  if start == goal {
    print(start)
    return ok(true)
  }

  // Parse edges and build adjacency list
  let graph = {}
  let edges = split(edges_str, ",")

  for edge in edges {
    let parts = split(edge, "-")
    if len(parts) == 2 {
      let a = parts[0]
      let b = parts[1]

      // Ensure both nodes exist in graph
      if not has(graph, a) {
        graph[a] = []
      }
      if not has(graph, b) {
        graph[b] = []
      }

      // Add edges (undirected)
      push(graph[a], b)
      push(graph[b], a)
    }
  }

  // Check if start and goal exist
  if not has(graph, start) or not has(graph, goal) {
    print("no path")
    return ok(true)
  }

  // BFS to find shortest path
  let queue = [[start]]
  let visited = {"": true}
  visited[start] = true
  let found_path = []

  while len(queue) > 0 {
    let path = queue[0]
    queue = slice(queue, 1, len(queue))

    let current = path[len(path) - 1]

    if current == goal {
      // Found a path - save it if we haven't found one or if it's lexicographically smaller
      if len(found_path) == 0 or isLexSmaller(path, found_path) {
        found_path = path
      }
      continue
    }

    let neighbors = graph[current]
    let sorted_neighbors = sort(neighbors)

    for neighbor in sorted_neighbors {
      if not has(visited, neighbor) {
        visited[neighbor] = true
        let new_path = []
        for p in path {
          push(new_path, p)
        }
        push(new_path, neighbor)
        push(queue, new_path)
      }
    }
  }

  if len(found_path) > 0 {
    let result = ""
    for i in range(0, len(found_path)) {
      if i > 0 {
        result = result + " -> "
      }
      result = result + found_path[i]
    }
    print(result)
  } else {
    print("no path")
  }

  return ok(true)
}

fn isLexSmaller(a, b) {
  let min_len = if len(a) < len(b) { len(a) } else { len(b) }

  for i in range(0, min_len) {
    if a[i] < b[i] {
      return true
    } else if a[i] > b[i] {
      return false
    }
  }

  // If all compared elements are equal, shorter is smaller
  return len(a) < len(b)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
