fn main() {
  let args_list = args()
  let edges_str = args_list[0]
  let start = args_list[1]
  let goal = args_list[2]

  // Parse edges into a graph (map from node to list of neighbors)
  let graph = {}
  let all_nodes = {}
  let edges_list = split(edges_str, ",")
  
  for edge in edges_list {
    if len(trim(edge)) > 0 {
      let parts = split(edge, "-")
      let a = parts[0]
      let b = parts[1]
      
      // Track all nodes
      all_nodes[a] = true
      all_nodes[b] = true
      
      // Add bidirectional edges
      if has(graph, a) {
        push(graph[a], b)
      } else {
        graph[a] = [b]
      }
      if has(graph, b) {
        push(graph[b], a)
      } else {
        graph[b] = [a]
      }
    }
  }
  
  // Check if start and goal exist in the graph
  if not has(all_nodes, start) or not has(all_nodes, goal) {
    print("no path")
    return
  }
  
  // If start equals goal
  if start == goal {
    print(start)
    return
  }
  
  // BFS to find shortest path
  let current_level = [start]
  let visited = {}
  let parent = {}
  
  visited[start] = true
  
  let found = false
  while len(current_level) > 0 and not found {
    let next_level = []
    let next_set = {}
    
    for node in current_level {
      // Get neighbors, or empty list if node not in graph
      let neighbors = match get(graph, node) {
        ok(n) => n
        err(e) => []
      }
      
      // Sort neighbors to ensure we visit in alphabetical order
      neighbors = sort(neighbors)
      
      for neighbor in neighbors {
        if not has(visited, neighbor) {
          visited[neighbor] = true
          parent[neighbor] = node
          
          if not has(next_set, neighbor) {
            push(next_level, neighbor)
            next_set[neighbor] = true
          }
          
          if neighbor == goal {
            found = true
          }
        }
      }
    }
    
    current_level = next_level
  }
  
  if found {
    // Reconstruct path by following parent pointers
    let path = []
    let current = goal
    while current != start {
      push(path, current)
      current = parent[current]
    }
    push(path, start)
    path = reverse(path)
    print(join(path, " -> "))
  } else {
    print("no path")
  }
}

main()
