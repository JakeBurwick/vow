fn main() {
  let argv = args()

  if len(argv) < 3 {
    print("no path")
    return ok(true)
  }

  let graph_str = argv[0]
  let start = argv[1]
  let goal = argv[2]

  // Parse edges
  let edges = split(graph_str, ",")
  let graph = {}

  for edge in edges {
    if edge != "" {
      let parts = split(edge, "-")
      if len(parts) == 2 {
        let a = parts[0]
        let b = parts[1]

        if not has(graph, a) {
          graph[a] = []
        }
        if not has(graph, b) {
          graph[b] = []
        }

        push(graph[a], b)
        push(graph[b], a)
      }
    }
  }

  // Sort each neighbor list for alphabetical ordering
  for node in keys(graph) {
    let neighbors = graph[node]
    neighbors = sort(neighbors)
    graph[node] = neighbors
  }

  // Check if nodes exist in graph
  if not has(graph, start) or not has(graph, goal) {
    print("no path")
    return ok(true)
  }

  // If start equals goal
  if start == goal {
    print(start)
    return ok(true)
  }

  // BFS to find shortest path
  let queue = []
  push(queue, start)

  let visited = {}
  visited[start] = true
  let parent = {}

  let found = false
  while len(queue) > 0 and not found {
    let current = queue[0]
    queue = slice(queue, 1, len(queue))

    if current == goal {
      found = true
      break
    }

    let neighbors = graph[current]
    for neighbor in neighbors {
      if not has(visited, neighbor) {
        visited[neighbor] = true
        parent[neighbor] = current
        push(queue, neighbor)

        if neighbor == goal {
          found = true
          break
        }
      }
    }
  }

  if not found {
    print("no path")
    return ok(true)
  }

  // Reconstruct path
  let path = []
  let curr = goal
  while curr != start {
    push(path, curr)
    curr = parent[curr]
  }
  push(path, start)
  path = reverse(path)

  print(join(path, " -> "))
  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
