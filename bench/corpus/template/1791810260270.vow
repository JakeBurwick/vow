fn processTemplate(template, data, context) {
  let result = ""
  let i = 0
  let len_t = len(template)

  while i < len_t {
    if i + 1 < len_t and template[i] == "{" and template[i + 1] == "{" {
      // Found opening {{
      let j = i + 2
      // Find closing }}
      while j + 1 < len_t and not (template[j] == "}" and template[j + 1] == "}") {
        j = j + 1
      }

      if j + 1 >= len_t {
        return err("error: unclosed if")
      }

      let tagContent = slice(template, i + 2, j)
      let trimmed = trim(tagContent)

      if startsWith(trimmed, "#if ") {
        let varName = trim(slice(trimmed, 4, len(trimmed)))
        let value = field(context, varName)

        // Find matching {{/if}}
        let searchPos = j + 2
        let depth = 1
        let endPos = -1

        while searchPos < len_t and depth > 0 {
          if searchPos + 1 < len_t and template[searchPos] == "{" and template[searchPos + 1] == "{" {
            let k = searchPos + 2
            while k + 1 < len_t and not (template[k] == "}" and template[k + 1] == "}") {
              k = k + 1
            }
            if k + 1 >= len_t {
              return err("error: unclosed if")
            }

            let innerTag = slice(template, searchPos + 2, k)
            let innerTrimmed = trim(innerTag)

            if startsWith(innerTrimmed, "#if ") or startsWith(innerTrimmed, "#each ") {
              depth = depth + 1
            } else if innerTrimmed == "/if" {
              depth = depth - 1
              if depth == 0 {
                endPos = searchPos
              }
            } else if innerTrimmed == "/each" {
              depth = depth - 1
            }

            searchPos = k + 2
          } else {
            searchPos = searchPos + 1
          }
        }

        if endPos == -1 {
          return err("error: unclosed if")
        }

        let blockContent = slice(template, j + 2, endPos)

        if truthy(value) {
          match processTemplate(blockContent, data, context) {
            ok(blockResult) => result = result + blockResult
            err(e) => return err(e)
          }
        }

        i = endPos + 7
      } else if startsWith(trimmed, "#each ") {
        let varName = trim(slice(trimmed, 6, len(trimmed)))
        let value = field(context, varName)

        // Find matching {{/each}}
        let searchPos = j + 2
        let depth = 1
        let endPos = -1

        while searchPos < len_t and depth > 0 {
          if searchPos + 1 < len_t and template[searchPos] == "{" and template[searchPos + 1] == "{" {
            let k = searchPos + 2
            while k + 1 < len_t and not (template[k] == "}" and template[k + 1] == "}") {
              k = k + 1
            }
            if k + 1 >= len_t {
              return err("error: unclosed each")
            }

            let innerTag = slice(template, searchPos + 2, k)
            let innerTrimmed = trim(innerTag)

            if startsWith(innerTrimmed, "#each ") or startsWith(innerTrimmed, "#if ") {
              depth = depth + 1
            } else if innerTrimmed == "/each" {
              depth = depth - 1
              if depth == 0 {
                endPos = searchPos
              }
            } else if innerTrimmed == "/if" {
              depth = depth - 1
            }

            searchPos = k + 2
          } else {
            searchPos = searchPos + 1
          }
        }

        if endPos == -1 {
          return err("error: unclosed each")
        }

        let blockContent = slice(template, j + 2, endPos)

        if jsonType(value) == "array" {
          let items = jsonList(value)
          for item in items {
            match processTemplate(blockContent, data, item) {
              ok(blockResult) => result = result + blockResult
              err(e) => return err(e)
            }
          }
        } else if not isNull(value) {
          return err("error: not a list: " + varName)
        }

        i = endPos + 9
      } else if startsWith(trimmed, "/if") {
        return err("error: unexpected /if")
      } else if startsWith(trimmed, "/each") {
        return err("error: unexpected /each")
      } else {
        // Variable substitution
        let str_value = ""
        if trimmed == "." {
          if jsonType(context) == "array" or jsonType(context) == "object" {
            return err("error: not printable")
          }
          if not isNull(context) {
            str_value = str(context)
          }
        } else {
          let v = field(context, trimmed)
          if jsonType(v) == "array" or jsonType(v) == "object" {
            return err("error: not printable")
          }
          if not isNull(v) {
            str_value = str(v)
          }
        }

        result = result + str_value
        i = j + 2
      }
    } else {
      result = result + template[i]
      i = i + 1
    }
  }

  return ok(result)
}

let args_list = args()
if len(args_list) < 2 {
  print("error: bad data")
} else {
  let template = args_list[0]
  let data_str = args_list[1]

  match parseJson(data_str) {
    ok(data) => {
      if jsonType(data) != "object" {
        print("error: bad data")
      } else {
        match processTemplate(template, data, data) {
          ok(result) => print(result)
          err(e) => print(e)
        }
      }
    }
    err(e) => print("error: bad data")
  }
}
