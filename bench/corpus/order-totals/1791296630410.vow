fn processOrders(s) {
  let j = parseJson(s)?
  if jsonType(j) != "array" { return err("bad order") }
  let items = jsonList(j)
  let totals = {}

  for order in items {
    if jsonType(order) != "object" { return err("bad order") }
    let item = jsonStr(get(order, "item")?)?
    let qty = jsonNum(get(order, "qty")?)?
    let price = jsonNum(get(order, "price")?)?

    if has(totals, item) {
      totals[item] = totals[item] + (qty * price)
    } else {
      totals[item] = qty * price
    }
  }

  return ok(totals)
}

fn main() {
  let s = get(args(), 0)?
  let totals = processOrders(s)?

  let keys = sort(keys(totals))
  let json_parts = []

  for key in keys {
    push(json_parts, "\"" + key + "\":" + toJson(totals[key]))
  }

  print("{" + join(json_parts, ",") + "}")
  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print("{\"error\":\"bad order\"}")
}
