fn run() {
  let input = args()[0]
  let j = parseJson(input)?

  if jsonType(j) != "array" { return err("bad order") }

  let items = jsonList(j)
  let totals = {}

  for order in items {
    if jsonType(order) != "object" { return err("bad order") }

    let item_val = get(order, "item")?
    let qty_val = get(order, "qty")?
    let price_val = get(order, "price")?

    let item = jsonStr(item_val)?
    let qty = jsonNum(qty_val)?
    let price = jsonNum(price_val)?

    let revenue = qty * price

    if has(totals, item) {
      totals[item] = totals[item] + revenue
    } else {
      totals[item] = revenue
    }
  }

  // Sort the keys and build JSON output
  let sorted_keys = sort(keys(totals))
  let parts = []
  for key in sorted_keys {
    let val = totals[key]
    push(parts, "\"" + key + "\":" + str(val))
  }

  print("{" + join(parts, ",") + "}")
  return ok(true)
}

match run() {
  ok(v) => {}
  err(e) => print("{\"error\":\"bad order\"}")
}
