struct Query {
  columns,
  where_col,
  where_op,
  where_val,
  order_col,
  order_desc,
  limit_n
}

fn parseQuery(query_str) {
  let tokens = split(query_str, " ")

  if len(tokens) < 2 { return err("bad query") }
  if tokens[0] != "SELECT" { return err("bad query") }

  let columns = split(tokens[1], ",")
  let pos = 2

  let where_col = ""
  let where_op = ""
  let where_val = ""
  let order_col = ""
  let order_desc = false
  let limit_n = 0

  while pos < len(tokens) {
    let keyword = tokens[pos]

    if keyword == "WHERE" {
      if pos + 3 >= len(tokens) { return err("bad query") }
      where_col = tokens[pos + 1]
      where_op = tokens[pos + 2]
      where_val = tokens[pos + 3]
      pos = pos + 4
    } else if keyword == "ORDER" {
      if pos + 1 >= len(tokens) { return err("bad query") }
      if tokens[pos + 1] != "BY" { return err("bad query") }
      if pos + 2 >= len(tokens) { return err("bad query") }
      order_col = tokens[pos + 2]
      pos = pos + 3
      if pos < len(tokens) and tokens[pos] == "DESC" {
        order_desc = true
        pos = pos + 1
      }
    } else if keyword == "LIMIT" {
      if pos + 1 >= len(tokens) { return err("bad query") }
      limit_n = num(tokens[pos + 1])?
      pos = pos + 2
    } else {
      return err("bad query")
    }
  }

  return ok(Query {
    columns: columns,
    where_col: where_col,
    where_op: where_op,
    where_val: where_val,
    order_col: order_col,
    order_desc: order_desc,
    limit_n: limit_n
  })
}

fn parseCsv(csv_str) {
  let lines_list = lines(csv_str)
  let rows = []
  for line in lines_list {
    let cells = split(line, ",")
    push(rows, cells)
  }
  return rows
}

fn getColIndex(header, col) {
  for i in range(0, len(header)) {
    if header[i] == col {
      return ok(i)
    }
  }
  return err("unknown")
}

fn validateColumns(header, query) {
  for col in query.columns {
    match getColIndex(header, col) {
      ok(idx) => {}
      err(e) => { return err(col) }
    }
  }

  if query.where_col != "" {
    match getColIndex(header, query.where_col) {
      ok(idx) => {}
      err(e) => { return err(query.where_col) }
    }
  }

  if query.order_col != "" {
    match getColIndex(header, query.order_col) {
      ok(idx) => {}
      err(e) => { return err(query.order_col) }
    }
  }

  return ok(true)
}

fn isNumber(s) {
  match num(s) {
    ok(n) => { return true }
    err(e) => { return false }
  }
}

fn compareValues(val1_str, op, val2_str) {
  let val1_is_num = isNumber(val1_str)
  let val2_is_num = isNumber(val2_str)

  if val1_is_num and val2_is_num {
    let val1 = num(val1_str)?
    let val2 = num(val2_str)?

    let result = match op {
      "=" => { val1 == val2 }
      "!=" => { val1 != val2 }
      "<" => { val1 < val2 }
      ">" => { val1 > val2 }
      "<=" => { val1 <= val2 }
      ">=" => { val1 >= val2 }
      _ => { false }
    }
    return ok(result)
  } else {
    if op == "=" { return ok(val1_str == val2_str) }
    if op == "!=" { return ok(val1_str != val2_str) }
    return err("bad comparison")
  }
}

fn filterRow(row, header, query) {
  if query.where_col == "" {
    return ok(true)
  }

  let where_idx = getColIndex(header, query.where_col)?
  let row_val = row[where_idx]

  return compareValues(row_val, query.where_op, query.where_val)
}

fn allNumeric(values) {
  for val in values {
    if not isNumber(val) {
      return false
    }
  }
  return true
}

fn main() {
  let args_list = args()
  if len(args_list) < 2 {
    print("error: bad query")
    return
  }

  let csv = args_list[0]
  let query_str = args_list[1]

  match parseQuery(query_str) {
    ok(query) => {
      let all_rows = parseCsv(csv)
      if len(all_rows) == 0 {
        print("error: bad query")
        return
      }

      let header = all_rows[0]
      let data_rows = slice(all_rows, 1, len(all_rows))

      match validateColumns(header, query) {
        ok(v) => {
          // Filter rows
          let filtered = []
          let has_error = false
          for row in data_rows {
            if not has_error {
              match filterRow(row, header, query) {
                ok(keep) => {
                  if keep { push(filtered, row) }
                }
                err(e) => {
                  print("error: bad comparison")
                  has_error = true
                }
              }
            }
          }

          if not has_error {
            // Sort rows if needed
            let sorted = if query.order_col != "" {
              match getColIndex(header, query.order_col) {
                ok(order_idx) => {
                  let col_values = []
                  for row in filtered {
                    push(col_values, row[order_idx])
                  }
                  let is_numeric = allNumeric(col_values)

                  if is_numeric {
                    sortBy(filtered, row => {
                      let val_str = row[order_idx]
                      match num(val_str) {
                        ok(val) => {
                          if query.order_desc { 0 - val } else { val }
                        }
                        err(e) => { 0 }
                      }
                    })
                  } else {
                    sortBy(filtered, row => {
                      let val = row[order_idx]
                      if query.order_desc { "\{z}" + val } else { val }
                    })
                  }
                }
                err(e) => { filtered }
              }
            } else {
              filtered
            }

            // Limit rows
            let limited = if query.limit_n > 0 {
              slice(sorted, 0, query.limit_n)
            } else {
              sorted
            }

            // Select columns and output
            let selected_indices = []
            for col in query.columns {
              match getColIndex(header, col) {
                ok(idx) => { push(selected_indices, idx) }
                err(e) => {}
              }
            }

            // Output header
            print(join(query.columns, ","))

            // Output rows
            for row in limited {
              let output_cells = []
              for idx in selected_indices {
                push(output_cells, row[idx])
              }
              print(join(output_cells, ","))
            }
          }
        }
        err(col) => {
          print("error: unknown column " + col)
        }
      }
    }
    err(e) => {
      print("error: bad query")
    }
  }
}

main()
