struct Query {
  select_cols,
  where_col,
  where_op,
  where_val,
  order_by_col,
  order_desc,
  limit_n
}

fn parseQuery(q) {
  let tokens = split(q, " ")
  let i = 0

  // Expect SELECT
  if i >= len(tokens) or tokens[i] != "SELECT" {
    return err("error: bad query")
  }
  i = i + 1

  // Parse select columns
  if i >= len(tokens) {
    return err("error: bad query")
  }
  let select_cols = split(tokens[i], ",")
  i = i + 1

  // Initialize optional fields
  let where_col = ""
  let where_op = ""
  let where_val = ""
  let order_by_col = ""
  let order_desc = false
  let limit_n = 0 - 1

  // Parse optional clauses
  while i < len(tokens) {
    if tokens[i] == "WHERE" {
      i = i + 1
      if i + 2 >= len(tokens) {
        return err("error: bad query")
      }
      where_col = tokens[i]
      i = i + 1
      where_op = tokens[i]
      i = i + 1
      where_val = tokens[i]
      i = i + 1
    } else if tokens[i] == "ORDER" {
      i = i + 1
      if i >= len(tokens) or tokens[i] != "BY" {
        return err("error: bad query")
      }
      i = i + 1
      if i >= len(tokens) {
        return err("error: bad query")
      }
      order_by_col = tokens[i]
      i = i + 1
      if i < len(tokens) and tokens[i] == "DESC" {
        order_desc = true
        i = i + 1
      }
    } else if tokens[i] == "LIMIT" {
      i = i + 1
      if i >= len(tokens) {
        return err("error: bad query")
      }
      match num(tokens[i]) {
        ok(n) => {
          limit_n = n
          i = i + 1
        }
        err(e) => return err("error: bad query")
      }
    } else {
      return err("error: bad query")
    }
  }

  return ok(Query {
    select_cols: select_cols,
    where_col: where_col,
    where_op: where_op,
    where_val: where_val,
    order_by_col: order_by_col,
    order_desc: order_desc,
    limit_n: limit_n
  })
}

fn getColIndex(header, col) {
  for i in range(0, len(header)) {
    if header[i] == col {
      return ok(i)
    }
  }
  return err("error: unknown column " + col)
}

fn main() {
  let argv = args()
  let csv_data = argv[0]
  let query_str = argv[1]

  // Parse query
  let query = parseQuery(query_str)?

  // Parse CSV
  let csv_lines = lines(csv_data)
  if len(csv_lines) == 0 {
    return err("error: bad query")
  }

  let header = split(csv_lines[0], ",")
  let rows = []

  for i in range(1, len(csv_lines)) {
    let row = split(csv_lines[i], ",")
    push(rows, row)
  }

  // Validate columns in query order
  for col in query.select_cols {
    if not contains(header, col) {
      return err("error: unknown column " + col)
    }
  }

  if query.where_col != "" and not contains(header, query.where_col) {
    return err("error: unknown column " + query.where_col)
  }

  if query.order_by_col != "" and not contains(header, query.order_by_col) {
    return err("error: unknown column " + query.order_by_col)
  }

  // Filter rows based on WHERE clause
  let filtered_rows = []
  if query.where_col != "" {
    let where_col_idx = getColIndex(header, query.where_col)?

    for row in rows {
      let cell_val = row[where_col_idx]
      let matches = false

      // Check if both parse as numbers
      match num(cell_val) {
        ok(cell_num) => {
          match num(query.where_val) {
            ok(cmp_num) => {
              // Both are numbers - numeric comparison
              if query.where_op == "=" and cell_num == cmp_num {
                matches = true
              } else if query.where_op == "!=" and cell_num != cmp_num {
                matches = true
              } else if query.where_op == "<" and cell_num < cmp_num {
                matches = true
              } else if query.where_op == ">" and cell_num > cmp_num {
                matches = true
              } else if query.where_op == "<=" and cell_num <= cmp_num {
                matches = true
              } else if query.where_op == ">=" and cell_num >= cmp_num {
                matches = true
              }
            }
            err(e) => {
              // One is number, one is string - string comparison
              if query.where_op != "=" and query.where_op != "!=" {
                return err("error: bad comparison")
              }
              if query.where_op == "=" and cell_val == query.where_val {
                matches = true
              } else if query.where_op == "!=" and cell_val != query.where_val {
                matches = true
              }
            }
          }
        }
        err(e) => {
          // Cell is not a number - string comparison
          if query.where_op != "=" and query.where_op != "!=" {
            return err("error: bad comparison")
          }
          if query.where_op == "=" and cell_val == query.where_val {
            matches = true
          } else if query.where_op == "!=" and cell_val != query.where_val {
            matches = true
          }
        }
      }

      if matches {
        push(filtered_rows, row)
      }
    }
  } else {
    filtered_rows = rows
  }

  // Sort if ORDER BY specified
  if query.order_by_col != "" {
    let order_col_idx = getColIndex(header, query.order_by_col)?

    // Check if column is all numeric
    let all_numeric = true
    for row in filtered_rows {
      match num(row[order_col_idx]) {
        ok(n) => {}
        err(e) => {
          all_numeric = false
          break
        }
      }
    }

    // Sort using sortBy
    if all_numeric {
      filtered_rows = sortBy(filtered_rows, row => {
        match num(row[order_col_idx]) {
          ok(n) => n
          err(e) => 0
        }
      })
    } else {
      filtered_rows = sortBy(filtered_rows, row => row[order_col_idx])
    }

    // Reverse if DESC
    if query.order_desc {
      filtered_rows = reverse(filtered_rows)
    }
  }

  // Apply LIMIT
  if query.limit_n > 0 {
    let limited = []
    for i in range(0, len(filtered_rows)) {
      if i >= query.limit_n {
        break
      }
      push(limited, filtered_rows[i])
    }
    filtered_rows = limited
  }

  // Output results
  print(join(query.select_cols, ","))

  // Get indices of selected columns
  let select_indices = []
  for col in query.select_cols {
    let idx = getColIndex(header, col)?
    push(select_indices, idx)
  }

  // Output rows
  for row in filtered_rows {
    let values = []
    for idx in select_indices {
      push(values, row[idx])
    }
    print(join(values, ","))
  }

  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
