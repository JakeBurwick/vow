struct Query {
  selectCols,
  whereCol,
  whereOp,
  whereVal,
  orderCol,
  orderDesc,
  limitN
}

fn parseQuery(q) {
  let parts = split(q, " ")
  let i = 0

  // Parse SELECT
  if i >= len(parts) or parts[i] != "SELECT" { return err("bad query") }
  i = i + 1

  if i >= len(parts) { return err("bad query") }
  let selectStr = parts[i]
  let selectCols = split(selectStr, ",")
  i = i + 1

  // Parse optional WHERE
  let whereCol = ""
  let whereOp = ""
  let whereVal = ""
  if i < len(parts) and parts[i] == "WHERE" {
    i = i + 1
    if i >= len(parts) { return err("bad query") }
    whereCol = parts[i]
    i = i + 1
    if i >= len(parts) { return err("bad query") }
    whereOp = parts[i]
    i = i + 1
    if i >= len(parts) { return err("bad query") }
    whereVal = parts[i]
    i = i + 1
  }

  // Parse optional ORDER BY
  let orderCol = ""
  let orderDesc = false
  if i < len(parts) and parts[i] == "ORDER" {
    i = i + 1
    if i >= len(parts) or parts[i] != "BY" { return err("bad query") }
    i = i + 1
    if i >= len(parts) { return err("bad query") }
    orderCol = parts[i]
    i = i + 1
    if i < len(parts) and parts[i] == "DESC" {
      orderDesc = true
      i = i + 1
    }
  }

  // Parse optional LIMIT
  let limitN = 999999
  if i < len(parts) and parts[i] == "LIMIT" {
    i = i + 1
    if i >= len(parts) { return err("bad query") }
    match num(parts[i]) {
      ok(n) => limitN = n
      err(e) => { return err("bad query") }
    }
    i = i + 1
  }

  // Check for leftover tokens
  if i != len(parts) { return err("bad query") }

  return ok(Query {
    selectCols: selectCols,
    whereCol: whereCol,
    whereOp: whereOp,
    whereVal: whereVal,
    orderCol: orderCol,
    orderDesc: orderDesc,
    limitN: limitN
  })
}

fn isNumeric(s) {
  match num(s) {
    ok(n) => { return true }
    err(e) => { return false }
  }
}

fn compareValues(a, b, op) {
  let aIsNum = isNumeric(a)
  let bIsNum = isNumeric(b)

  if aIsNum and bIsNum {
    let aNum = 0
    let bNum = 0
    match num(a) {
      ok(n) => { aNum = n }
      err(e) => { return false }
    }
    match num(b) {
      ok(n) => { bNum = n }
      err(e) => { return false }
    }

    if op == "=" { return aNum == bNum }
    if op == "!=" { return aNum != bNum }
    if op == "<" { return aNum < bNum }
    if op == ">" { return aNum > bNum }
    if op == "<=" { return aNum <= bNum }
    if op == ">=" { return aNum >= bNum }
    return false
  } else {
    if op == "=" { return a == b }
    if op == "!=" { return a != b }
    return false
  }
}

fn main() {
  let argv = args()
  if len(argv) < 2 { return err("not enough args") }

  let csv = argv[0]
  let queryStr = argv[1]

  match parseQuery(queryStr) {
    ok(query) => {
      let rows = split(csv, "\n")
      if len(rows) == 0 { return err("no rows") }

      // Parse header
      let header = split(rows[0], ",")

      // Build a map of column name to index
      let colIndex = {}
      for i in range(0, len(header)) {
        colIndex[header[i]] = i
      }

      // Validate select columns
      for col in query.selectCols {
        if not has(colIndex, col) {
          print("error: unknown column " + col)
          return ok(true)
        }
      }

      // Validate WHERE column if present
      if query.whereCol != "" {
        if not has(colIndex, query.whereCol) {
          print("error: unknown column " + query.whereCol)
          return ok(true)
        }
      }

      // Validate ORDER BY column if present
      if query.orderCol != "" {
        if not has(colIndex, query.orderCol) {
          print("error: unknown column " + query.orderCol)
          return ok(true)
        }
      }

      // Validate WHERE operator on strings
      if query.whereCol != "" {
        if query.whereOp != "=" and query.whereOp != "!=" {
          if not isNumeric(query.whereVal) {
            print("error: bad comparison")
            return ok(true)
          }
        }
      }

      // Process rows
      let matchedRows = []
      for i in range(1, len(rows)) {
        let rowStr = rows[i]
        if rowStr == "" { continue }

        let cells = split(rowStr, ",")
        if len(cells) != len(header) { continue }

        // Check WHERE clause
        if query.whereCol != "" {
          let colIdx = colIndex[query.whereCol]
          let cellVal = cells[colIdx]

          // For string comparisons on non-numeric, check operator validity
          if not isNumeric(cellVal) and query.whereOp != "=" and query.whereOp != "!=" {
            print("error: bad comparison")
            return ok(true)
          }

          if not compareValues(cellVal, query.whereVal, query.whereOp) {
            continue
          }
        }

        push(matchedRows, cells)
      }

      // Sort if needed
      if query.orderCol != "" {
        let orderIdx = colIndex[query.orderCol]

        // Determine if column is numeric
        let isNumCol = true
        for row in matchedRows {
          if not isNumeric(row[orderIdx]) {
            isNumCol = false
            break
          }
        }

        if isNumCol {
          // Numeric sort
          matchedRows = sortBy(matchedRows, row => {
            match num(row[orderIdx]) {
              ok(n) => {
                if query.orderDesc { return 0 - n }
                return n
              }
              err(e) => { return 0 }
            }
          })
        } else {
          // String sort
          matchedRows = sortBy(matchedRows, row => {
            return row[orderIdx]
          })

          if query.orderDesc {
            matchedRows = reverse(matchedRows)
          }
        }
      }

      // Limit rows
      if len(matchedRows) > query.limitN {
        matchedRows = slice(matchedRows, 0, query.limitN)
      }

      // Output header
      let headerOutput = []
      for col in query.selectCols {
        push(headerOutput, col)
      }
      print(join(headerOutput, ","))

      // Output rows
      for row in matchedRows {
        let rowOutput = []
        for col in query.selectCols {
          let idx = colIndex[col]
          push(rowOutput, row[idx])
        }
        print(join(rowOutput, ","))
      }

      return ok(true)
    }
    err(e) => {
      print("error: bad query")
      return ok(true)
    }
  }
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
