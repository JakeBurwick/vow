fn isValidName(s) {
  if len(s) == 0 {
    return false
  }
  for c in split(s, "") {
    let isLower = c >= "a" and c <= "z"
    let isDigit = c >= "0" and c <= "9"
    let isUnderscore = c == "_"
    if not (isLower or isDigit or isUnderscore) {
      return false
    }
  }
  return true
}

let args_list = args()

if len(args_list) < 1 {
  return
}

let ini_str = args_list[0]
let ini_lines = lines(ini_str)

let sections = {}
let currentSection = ""
let hasError = false
let errorMsg = ""
let lineNum = 0

for line in ini_lines {
  lineNum = lineNum + 1
  let trimmed = trim(line)

  if trimmed == "" {
    continue
  }

  if startsWith(trimmed, ";") or startsWith(trimmed, "#") {
    continue
  }

  if startsWith(trimmed, "[") and endsWith(trimmed, "]") {
    let sectionName = slice(trimmed, 1, len(trimmed) - 1)
    if isValidName(sectionName) {
      currentSection = sectionName
      if not has(sections, currentSection) {
        sections[currentSection] = {}
      }
    } else {
      print("error line " + str(lineNum) + ": bad line")
      hasError = true
      break
    }
  } else if contains(trimmed, "=") {
    if currentSection == "" {
      print("error line " + str(lineNum) + ": key outside section")
      hasError = true
      break
    }

    match indexOf(trimmed, "=") {
      ok(idx) => {
        let key = trim(slice(trimmed, 0, idx))
        let value = trim(slice(trimmed, idx + 1, len(trimmed)))

        if isValidName(key) {
          let section_map = sections[currentSection]
          section_map[key] = value
        } else {
          print("error line " + str(lineNum) + ": bad line")
          hasError = true
          break
        }
      }
      err(_) => {
        print("error line " + str(lineNum) + ": bad line")
        hasError = true
        break
      }
    }
  } else {
    print("error line " + str(lineNum) + ": bad line")
    hasError = true
    break
  }
}

if not hasError {
  let query_idx = 1

  while query_idx < len(args_list) {
    let query = args_list[query_idx]

    match indexOf(query, ".") {
      ok(idx) => {
        let sect = slice(query, 0, idx)
        let key = slice(query, idx + 1, len(query))

        if has(sections, sect) {
          let sect_map = sections[sect]
          if has(sect_map, key) {
            print(query + " = " + sect_map[key])
          } else {
            print(query + " missing")
          }
        } else {
          print(query + " missing")
        }
      }
      err(_) => {}
    }

    query_idx = query_idx + 1
  }
}
