struct Token {
  type,
  value
}

struct Parser {
  tokens,
  pos,
  variables
}

fn tokenize(expr) {
  let tokens = []
  let chars = split(expr, "")
  let i = 0

  while i < len(chars) {
    let c = chars[i]

    if c == " " {
      i = i + 1
    } else if c == "+" {
      push(tokens, Token { type: "op", value: "+" })
      i = i + 1
    } else if c == "-" {
      push(tokens, Token { type: "op", value: "-" })
      i = i + 1
    } else if c == "*" {
      push(tokens, Token { type: "op", value: "*" })
      i = i + 1
    } else if c == "/" {
      push(tokens, Token { type: "op", value: "/" })
      i = i + 1
    } else if c == "(" {
      push(tokens, Token { type: "lparen", value: "(" })
      i = i + 1
    } else if c == ")" {
      push(tokens, Token { type: "rparen", value: ")" })
      i = i + 1
    } else if c >= "0" and c <= "9" {
      let num_str = ""
      while i < len(chars) and ((chars[i] >= "0" and chars[i] <= "9") or chars[i] == ".") {
        num_str = num_str + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "num", value: num_str })
    } else if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" {
      let name = ""
      while i < len(chars) and ((chars[i] >= "a" and chars[i] <= "z") or (chars[i] >= "A" and chars[i] <= "Z") or (chars[i] >= "0" and chars[i] <= "9") or chars[i] == "_") {
        name = name + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "var", value: name })
    } else {
      return err("syntax")
    }
  }

  push(tokens, Token { type: "eof", value: "" })
  return ok(tokens)
}

fn peek(p) {
  return p.tokens[p.pos]
}

fn advance(p) {
  p.pos = p.pos + 1
}

fn parseExpr(p) {
  let left = parseTerm(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "+" or tok.value == "-") {
      let op = tok.value
      advance(p)
      let right = parseTerm(p)?
      if op == "+" {
        left = left + right
      } else {
        left = left - right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseTerm(p) {
  let left = parseUnary(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "*" or tok.value == "/") {
      let op = tok.value
      advance(p)
      let right = parseUnary(p)?
      if op == "*" {
        left = left * right
      } else {
        if right == 0 {
          return err("division by zero")
        }
        left = left / right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseUnary(p) {
  let tok = peek(p)
  if tok.type == "op" and tok.value == "-" {
    advance(p)
    let val = parseUnary(p)?
    return ok(0 - val)
  } else {
    return parseFactor(p)
  }
}

fn parseFactor(p) {
  let tok = peek(p)
  if tok.type == "num" {
    advance(p)
    match num(tok.value) {
      ok(n) => {
        return ok(n)
      }
      err(_) => {
        return err("syntax")
      }
    }
  } else if tok.type == "var" {
    advance(p)
    let varName = tok.value
    match get(p.variables, varName) {
      ok(val) => {
        return ok(val)
      }
      err(_) => {
        return err("unknown variable " + varName)
      }
    }
  } else if tok.type == "lparen" {
    advance(p)
    let val = parseExpr(p)?
    let close = peek(p)
    if close.type != "rparen" {
      return err("syntax")
    }
    advance(p)
    return ok(val)
  } else {
    return err("syntax")
  }
}

fn formatNumber(val) {
  if val == floor(val) {
    return str(floor(val))
  } else {
    return str(val)
  }
}

fn main() {
  let input = args()[0]
  let lines_list = lines(input)
  let variables = {}
  let lineNum = 0

  for line in lines_list {
    lineNum = lineNum + 1

    // Skip blank lines
    if len(trim(line)) == 0 {
      continue
    }

    // Parse "name = expression"
    let parts = split(line, "=")
    if len(parts) != 2 {
      print("error line " + str(lineNum) + ": syntax")
      return
    }

    let name = trim(parts[0])
    let expr = trim(parts[1])

    // Validate name
    if len(name) == 0 {
      print("error line " + str(lineNum) + ": syntax")
      return
    }

    let first = name[0]
    if first >= "0" and first <= "9" {
      print("error line " + str(lineNum) + ": syntax")
      return
    }

    for c in split(name, "") {
      if not ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_") {
        print("error line " + str(lineNum) + ": syntax")
        return
      }
    }

    // Parse and evaluate expression
    match tokenize(expr) {
      ok(tokens) => {
        let p = Parser { tokens: tokens, pos: 0, variables: variables }
        match parseExpr(p) {
          ok(result) => {
            let final = peek(p)
            if final.type != "eof" {
              print("error line " + str(lineNum) + ": syntax")
              return
            }
            variables[name] = result
          }
          err(e) => {
            if startsWith(e, "unknown variable") {
              let parts2 = split(e, " ")
              let varName = parts2[2]
              print("error line " + str(lineNum) + ": unknown variable " + varName)
            } else if e == "division by zero" {
              print("error line " + str(lineNum) + ": division by zero")
            } else {
              print("error line " + str(lineNum) + ": syntax")
            }
            return
          }
        }
      }
      err(e) => {
        print("error line " + str(lineNum) + ": syntax")
        return
      }
    }
  }

  // Print variables sorted by name
  let names = sort(keys(variables))
  for name in names {
    let val = variables[name]
    print(name + " = " + formatNumber(val))
  }
}

main()
