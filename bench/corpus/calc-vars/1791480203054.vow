struct Token {
  type,
  value
}

fn tokenize(line) {
  let tokens = []
  let i = 0
  let line_trimmed = trim(line)

  while i < len(line_trimmed) {
    let c = line_trimmed[i]

    if c == " " {
      i = i + 1
    } else if c == "=" {
      push(tokens, Token { type: "eq", value: "=" })
      i = i + 1
    } else if c == "+" {
      push(tokens, Token { type: "op", value: "+" })
      i = i + 1
    } else if c == "-" {
      push(tokens, Token { type: "op", value: "-" })
      i = i + 1
    } else if c == "*" {
      push(tokens, Token { type: "op", value: "*" })
      i = i + 1
    } else if c == "/" {
      push(tokens, Token { type: "op", value: "/" })
      i = i + 1
    } else if c == "(" {
      push(tokens, Token { type: "lparen", value: "(" })
      i = i + 1
    } else if c == ")" {
      push(tokens, Token { type: "rparen", value: ")" })
      i = i + 1
    } else if c >= "0" and c <= "9" {
      let num_str = ""
      while i < len(line_trimmed) and ((line_trimmed[i] >= "0" and line_trimmed[i] <= "9") or line_trimmed[i] == ".") {
        num_str = num_str + line_trimmed[i]
        i = i + 1
      }
      push(tokens, Token { type: "num", value: num_str })
    } else if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" {
      let var_str = ""
      while i < len(line_trimmed) and ((line_trimmed[i] >= "a" and line_trimmed[i] <= "z") or (line_trimmed[i] >= "A" and line_trimmed[i] <= "Z") or (line_trimmed[i] >= "0" and line_trimmed[i] <= "9") or line_trimmed[i] == "_") {
        var_str = var_str + line_trimmed[i]
        i = i + 1
      }
      push(tokens, Token { type: "var", value: var_str })
    } else {
      return err("syntax")
    }
  }

  return ok(tokens)
}

struct Parser {
  tokens,
  pos,
  vars
}

fn peek(p) {
  if p.pos < len(p.tokens) {
    return p.tokens[p.pos]
  }
  return Token { type: "eof", value: "" }
}

fn advance(p) {
  p.pos = p.pos + 1
}

fn parseExpr(p) {
  let left = parseTerm(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "+" or tok.value == "-") {
      let op = tok.value
      advance(p)
      let right = parseTerm(p)?
      if op == "+" {
        left = left + right
      } else {
        left = left - right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseTerm(p) {
  let left = parseUnary(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "*" or tok.value == "/") {
      let op = tok.value
      advance(p)
      let right = parseUnary(p)?
      if op == "*" {
        left = left * right
      } else {
        if right == 0 {
          return err("division by zero")
        }
        left = left / right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseUnary(p) {
  let tok = peek(p)
  if tok.type == "op" and tok.value == "-" {
    advance(p)
    let val = parseUnary(p)?
    return ok(0 - val)
  }
  return parsePrimary(p)
}

fn parsePrimary(p) {
  let tok = peek(p)
  if tok.type == "num" {
    advance(p)
    match num(tok.value) {
      ok(n) => return ok(n)
      err(e) => return err("syntax")
    }
  } else if tok.type == "var" {
    advance(p)
    if has(p.vars, tok.value) {
      return ok(p.vars[tok.value])
    } else {
      return err("unknown variable " + tok.value)
    }
  } else if tok.type == "lparen" {
    advance(p)
    let val = parseExpr(p)?
    let close = peek(p)
    if close.type != "rparen" {
      return err("syntax")
    }
    advance(p)
    return ok(val)
  } else {
    return err("syntax")
  }
}

fn formatNumber(n) {
  if isInt(n) {
    return str(n)
  }

  let is_negative = n < 0
  let abs_n = if is_negative { 0 - n } else { n }

  let sig_result = sig(abs_n, 10)
  let sig_str = str(sig_result)

  return if is_negative { "-" + sig_str } else { sig_str }
}

fn main() {
  let input = args()[0]
  let lines_list = split(input, "\n")
  let vars = {}

  for line_idx in range(0, len(lines_list)) {
    let line = lines_list[line_idx]
    let line_num = line_idx + 1
    let trimmed = trim(line)

    if trimmed == "" {
      continue
    }

    match tokenize(trimmed) {
      ok(tokens) => {
        if len(tokens) < 3 {
          print("error line " + str(line_num) + ": syntax")
          return ok(true)
        }

        let first = tokens[0]
        let second = tokens[1]

        if first.type != "var" or second.type != "eq" {
          print("error line " + str(line_num) + ": syntax")
          return ok(true)
        }

        let var_name = first.value
        let expr_tokens = slice(tokens, 2, len(tokens))

        let p = Parser { tokens: expr_tokens, pos: 0, vars: vars }
        match parseExpr(p) {
          ok(val) => {
            let end_tok = peek(p)
            if end_tok.type != "eof" {
              print("error line " + str(line_num) + ": syntax")
              return ok(true)
            }
            vars[var_name] = val
          }
          err(e) => {
            if startsWith(e, "unknown") {
              let parts = split(e, " ")
              let var_ref = parts[len(parts) - 1]
              print("error line " + str(line_num) + ": unknown variable " + var_ref)
            } else if e == "division by zero" {
              print("error line " + str(line_num) + ": division by zero")
            } else {
              print("error line " + str(line_num) + ": syntax")
            }
            return ok(true)
          }
        }
      }
      err(e) => {
        print("error line " + str(line_num) + ": syntax")
        return ok(true)
      }
    }
  }

  let sorted_names = sort(keys(vars))
  for name in sorted_names {
    let val = vars[name]
    let formatted = formatNumber(val)
    print(name + " = " + formatted)
  }

  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
