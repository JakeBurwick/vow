// Expression parser and evaluator

struct Token {
  type,
  value
}

struct Parser {
  tokens,
  pos,
  variables,
  errorMsg
}

fn tokenize(s) {
  let tokens = []
  let chars = split(s, "")
  let i = 0

  while i < len(chars) {
    let c = chars[i]

    if c == " " or c == "\t" {
      i = i + 1
    } else if c == "(" {
      push(tokens, Token { type: "lparen", value: "(" })
      i = i + 1
    } else if c == ")" {
      push(tokens, Token { type: "rparen", value: ")" })
      i = i + 1
    } else if c == "+" or c == "*" or c == "/" {
      push(tokens, Token { type: "op", value: c })
      i = i + 1
    } else if c == "-" {
      push(tokens, Token { type: "op", value: "-" })
      i = i + 1
    } else if c >= "0" and c <= "9" {
      let numStr = ""
      let hasDot = false
      while i < len(chars) {
        let ch = chars[i]
        if ch >= "0" and ch <= "9" {
          numStr = numStr + ch
          i = i + 1
        } else if ch == "." and not hasDot {
          hasDot = true
          numStr = numStr + ch
          i = i + 1
        } else {
          break
        }
      }
      push(tokens, Token { type: "num", value: numStr })
    } else if c >= "a" and c <= "z" or c >= "A" and c <= "Z" or c == "_" {
      let varName = ""
      while i < len(chars) {
        let ch = chars[i]
        if ch >= "a" and ch <= "z" or ch >= "A" and ch <= "Z" or ch >= "0" and ch <= "9" or ch == "_" {
          varName = varName + ch
          i = i + 1
        } else {
          break
        }
      }
      push(tokens, Token { type: "var", value: varName })
    } else {
      return err("bad char")
    }
  }

  push(tokens, Token { type: "eof", value: "" })
  return ok(tokens)
}

fn peek(p) {
  if p.pos < len(p.tokens) {
    return p.tokens[p.pos]
  }
  return Token { type: "eof", value: "" }
}

fn advance(p) {
  p.pos = p.pos + 1
}

fn parseExpr(p) {
  let left = parseTerm(p)?

  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "+" or tok.value == "-") {
      let op = tok.value
      advance(p)
      let right = parseTerm(p)?
      if op == "+" {
        left = left + right
      } else {
        left = left - right
      }
    } else {
      break
    }
  }

  return ok(left)
}

fn parseTerm(p) {
  let left = parseFactor(p)?

  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "*" or tok.value == "/") {
      let op = tok.value
      advance(p)
      let right = parseFactor(p)?
      if op == "*" {
        left = left * right
      } else {
        if right == 0 {
          return err("div0")
        }
        left = left / right
      }
    } else {
      break
    }
  }

  return ok(left)
}

fn parseFactor(p) {
  let tok = peek(p)

  if tok.type == "op" and tok.value == "-" {
    advance(p)
    let val = parseFactor(p)?
    return ok(0 - val)
  }

  if tok.type == "num" {
    advance(p)
    match num(tok.value) {
      ok(n) => return ok(n)
      err(e) => return err("bad num")
    }
  }

  if tok.type == "var" {
    advance(p)
    let varName = tok.value
    if has(p.variables, varName) {
      return ok(p.variables[varName])
    } else {
      return err("unknown:" + varName)
    }
  }

  if tok.type == "lparen" {
    advance(p)
    let val = parseExpr(p)?
    let close = peek(p)
    if close.type != "rparen" {
      return err("syntax")
    }
    advance(p)
    return ok(val)
  }

  return err("syntax")
}

fn parseAndEvaluate(expr, variables) {
  let trimmed = trim(expr)
  if trimmed == "" {
    return err("empty")
  }

  match tokenize(trimmed) {
    ok(tokens) => {
      let p = Parser { tokens: tokens, pos: 0, variables: variables, errorMsg: "" }
      match parseExpr(p) {
        ok(result) => {
          let final = peek(p)
          if final.type == "eof" {
            return ok(result)
          } else {
            return err("syntax")
          }
        }
        err(e) => {
          if startsWith(e, "unknown:") {
            return err(e)
          } else if e == "div0" {
            return err("div0")
          } else {
            return err("syntax")
          }
        }
      }
    }
    err(e) => {
      return err("syntax")
    }
  }
}

fn formatNumber(n) {
  let isWhole = n == floor(n)
  if isWhole {
    return str(floor(n))
  }

  let absN = if n < 0 { 0 - n } else { n }
  let sign = if n < 0 { "-" } else { "" }

  let str_n = str(absN)
  let e_idx = indexOf(str_n, "e")

  match e_idx {
    ok(idx) => {
      return sign + str_n
    }
    err(_) => {
      let dotIdx = indexOf(str_n, ".")
      match dotIdx {
        ok(idx) => {
          let intPart = slice(str_n, 0, idx)
          let decPart = slice(str_n, idx + 1, len(str_n))

          let sigFigs = intPart + decPart
          let leadingZeros = 0
          if intPart == "0" {
            let i = 0
            while i < len(decPart) and decPart[i] == "0" {
              leadingZeros = leadingZeros + 1
              i = i + 1
            }
          }

          let totalSigs = len(sigFigs) - leadingZeros
          if totalSigs <= 10 {
            let trimmed = trim(str_n)
            return sign + trimmed
          }

          let rounded = round(absN, 10 - (len(intPart) - 1))
          let resultStr = str(rounded)
          let finalTrim = trim(resultStr)
          return sign + finalTrim
        }
        err(_) => {
          return sign + str_n
        }
      }
    }
  }
}

fn main() {
  let input = args()[0]
  let programLines = lines(input)

  let variables = {}
  let lineNum = 0

  for line in programLines {
    lineNum = lineNum + 1
    let trimmed = trim(line)

    if trimmed == "" {
      continue
    }

    let eqIdx = indexOf(trimmed, "=")
    match eqIdx {
      ok(idx) => {
        let nameStr = trim(slice(trimmed, 0, idx))
        let exprStr = trim(slice(trimmed, idx + 1, len(trimmed)))

        if len(nameStr) == 0 {
          print("error line " + str(lineNum) + ": syntax")
          return
        }

        let isValidName = not (nameStr[0] >= "0" and nameStr[0] <= "9")
        if isValidName {
          for c in split(nameStr, "") {
            if not (c >= "a" and c <= "z" or c >= "A" and c <= "Z" or c >= "0" and c <= "9" or c == "_") {
              print("error line " + str(lineNum) + ": syntax")
              return
            }
          }
        } else {
          print("error line " + str(lineNum) + ": syntax")
          return
        }

        match parseAndEvaluate(exprStr, variables) {
          ok(result) => {
            variables[nameStr] = result
          }
          err(e) => {
            let colonIdx = indexOf(e, ":")
            match colonIdx {
              ok(idx) => {
                let prefix = slice(e, 0, idx)
                let suffix = slice(e, idx + 1, len(e))
                if prefix == "unknown" {
                  print("error line " + str(lineNum) + ": unknown variable " + suffix)
                  return
                }
              }
              err(_) => {}
            }

            if e == "unknown" or startsWith(e, "unknown:") {
              print("error line " + str(lineNum) + ": unknown variable ???")
              return
            } else if e == "div0" {
              print("error line " + str(lineNum) + ": division by zero")
              return
            } else {
              print("error line " + str(lineNum) + ": syntax")
              return
            }
          }
        }
      }
      err(_) => {
        print("error line " + str(lineNum) + ": syntax")
        return
      }
    }
  }

  let varNames = sort(keys(variables))
  for name in varNames {
    let val = variables[name]
    print(name + " = " + formatNumber(val))
  }
}

main()
