struct Token {
  type,
  value
}

fn tokenize(s) {
  let tokens = []
  let chars = split(s, "")
  let i = 0
  while i < len(chars) {
    let c = chars[i]
    if c == " " {
      i = i + 1
    } else if c == "(" {
      push(tokens, Token { type: "lparen", value: "(" })
      i = i + 1
    } else if c == ")" {
      push(tokens, Token { type: "rparen", value: ")" })
      i = i + 1
    } else if c == "+" or c == "-" or c == "*" or c == "/" {
      push(tokens, Token { type: "op", value: c })
      i = i + 1
    } else if c >= "0" and c <= "9" {
      let numStr = ""
      while i < len(chars) and ((chars[i] >= "0" and chars[i] <= "9") or chars[i] == ".") {
        numStr = numStr + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "num", value: numStr })
    } else if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" {
      let varStr = ""
      while i < len(chars) and ((chars[i] >= "a" and chars[i] <= "z") or (chars[i] >= "A" and chars[i] <= "Z") or (chars[i] >= "0" and chars[i] <= "9") or chars[i] == "_") {
        varStr = varStr + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "var", value: varStr })
    } else {
      return err("syntax")
    }
  }
  push(tokens, Token { type: "eof", value: "" })
  return ok(tokens)
}

struct Parser {
  tokens,
  pos,
  vars
}

fn peek(p) {
  return p.tokens[p.pos]
}

fn advance(p) {
  p.pos = p.pos + 1
}

fn parseExpr(p) {
  let left = parseTerm(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "+" or tok.value == "-") {
      let op = tok.value
      advance(p)
      let right = parseTerm(p)?
      if op == "+" {
        left = left + right
      } else {
        left = left - right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseTerm(p) {
  let left = parseUnary(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "*" or tok.value == "/") {
      let op = tok.value
      advance(p)
      let right = parseUnary(p)?
      if op == "*" {
        left = left * right
      } else {
        if right == 0 {
          return err("division by zero")
        }
        left = left / right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseUnary(p) {
  let tok = peek(p)
  if tok.type == "op" and tok.value == "-" {
    advance(p)
    let val = parseUnary(p)?
    return ok(0 - val)
  }
  return parseFactor(p)
}

fn parseFactor(p) {
  let tok = peek(p)
  if tok.type == "num" {
    advance(p)
    let val = num(tok.value)?
    return ok(val)
  } else if tok.type == "var" {
    advance(p)
    if has(p.vars, tok.value) {
      return ok(p.vars[tok.value])
    } else {
      return err("unknown variable ${tok.value}")
    }
  } else if tok.type == "lparen" {
    advance(p)
    let val = parseExpr(p)?
    let close = peek(p)
    if close.type != "rparen" {
      return err("syntax")
    }
    advance(p)
    return ok(val)
  } else {
    return err("syntax")
  }
}

fn formatNumber(n) {
  if n == floor(n) {
    return str(floor(n))
  } else {
    let absN = if n < 0 { 0 - n } else { n }
    let rounded = sig(absN, 10)
    if n < 0 {
      return str(0 - rounded)
    } else {
      return str(rounded)
    }
  }
}

fn main() {
  let input = args()[0]
  let lineList = lines(input)
  let vars = {}

  for lineIdx in range(0, len(lineList)) {
    let line = lineList[lineIdx]
    let trimmed = trim(line)

    if len(trimmed) == 0 {
      continue
    }

    if not contains(trimmed, "=") {
      print("error line ${lineIdx + 1}: syntax")
      return ok(true)
    }

    let eqParts = split(trimmed, "=")
    if len(eqParts) != 2 {
      print("error line ${lineIdx + 1}: syntax")
      return ok(true)
    }

    let name = trim(eqParts[0])
    let exprStr = trim(eqParts[1])

    if len(name) == 0 {
      print("error line ${lineIdx + 1}: syntax")
      return ok(true)
    }

    if name[0] >= "0" and name[0] <= "9" {
      print("error line ${lineIdx + 1}: syntax")
      return ok(true)
    }

    let nameValid = true
    for c in split(name, "") {
      if not ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_") {
        nameValid = false
      }
    }

    if not nameValid {
      print("error line ${lineIdx + 1}: syntax")
      return ok(true)
    }

    match tokenize(exprStr) {
      ok(tokens) => {
        let p = Parser { tokens: tokens, pos: 0, vars: vars }
        match parseExpr(p) {
          ok(result) => {
            let final = peek(p)
            if final.type != "eof" {
              print("error line ${lineIdx + 1}: syntax")
              return ok(true)
            }
            vars[name] = result
          }
          err(e) => {
            if startsWith(e, "unknown variable ") {
              let varName = slice(e, 17, len(e))
              print("error line ${lineIdx + 1}: unknown variable ${varName}")
            } else if e == "division by zero" {
              print("error line ${lineIdx + 1}: division by zero")
            } else {
              print("error line ${lineIdx + 1}: syntax")
            }
            return ok(true)
          }
        }
      }
      err(e) => {
        print("error line ${lineIdx + 1}: syntax")
        return ok(true)
      }
    }
  }

  let sortedNames = sort(keys(vars))
  for name in sortedNames {
    let value = vars[name]
    print("${name} = ${formatNumber(value)}")
  }

  return ok(true)
}

match main() {
  ok(_) => {}
  err(e) => print(e)
}
