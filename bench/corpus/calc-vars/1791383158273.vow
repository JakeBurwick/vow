struct Token {
  type,
  value
}

struct Parser {
  tokens,
  pos
}

fn tokenize(s) {
  let tokens = []
  let chars = split(s, "")
  let i = 0

  while i < len(chars) {
    let c = chars[i]
    if c == " " {
      i = i + 1
    } else if c == "(" {
      push(tokens, Token { type: "lparen", value: "(" })
      i = i + 1
    } else if c == ")" {
      push(tokens, Token { type: "rparen", value: ")" })
      i = i + 1
    } else if c == "+" or c == "-" or c == "*" or c == "/" {
      push(tokens, Token { type: "op", value: c })
      i = i + 1
    } else if c >= "0" and c <= "9" {
      let numStr = ""
      while i < len(chars) and ((chars[i] >= "0" and chars[i] <= "9") or chars[i] == ".") {
        numStr = numStr + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "num", value: numStr })
    } else if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" {
      let varName = ""
      while i < len(chars) and ((chars[i] >= "a" and chars[i] <= "z") or (chars[i] >= "A" and chars[i] <= "Z") or (chars[i] >= "0" and chars[i] <= "9") or chars[i] == "_") {
        varName = varName + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "var", value: varName })
    } else {
      return err("syntax")
    }
  }

  push(tokens, Token { type: "eof", value: "" })
  return ok(tokens)
}

fn peek(p) {
  return p.tokens[p.pos]
}

fn advance(p) {
  p.pos = p.pos + 1
}

fn parseAddSub(p, vars) {
  let left = parseMulDiv(p, vars)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "+" or tok.value == "-") {
      let op = tok.value
      advance(p)
      let right = parseMulDiv(p, vars)?
      if op == "+" {
        left = left + right
      } else {
        left = left - right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseMulDiv(p, vars) {
  let left = parseUnary(p, vars)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "*" or tok.value == "/") {
      let op = tok.value
      advance(p)
      let right = parseUnary(p, vars)?
      if op == "*" {
        left = left * right
      } else {
        if right == 0 {
          return err("division by zero")
        }
        left = left / right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseUnary(p, vars) {
  let tok = peek(p)
  if tok.type == "op" and tok.value == "-" {
    advance(p)
    let val = parseUnary(p, vars)?
    return ok(0 - val)
  } else if tok.type == "op" and tok.value == "+" {
    advance(p)
    return parseUnary(p, vars)
  } else {
    return parseFactor(p, vars)
  }
}

fn parseFactor(p, vars) {
  let tok = peek(p)
  if tok.type == "num" {
    advance(p)
    let val = num(tok.value)?
    return ok(val)
  } else if tok.type == "var" {
    advance(p)
    let varName = tok.value
    if has(vars, varName) {
      return ok(vars[varName])
    } else {
      return err("unknown variable ${varName}")
    }
  } else if tok.type == "lparen" {
    advance(p)
    let val = parseAddSub(p, vars)?
    let close = peek(p)
    if close.type != "rparen" {
      return err("syntax")
    }
    advance(p)
    return ok(val)
  } else {
    return err("syntax")
  }
}

fn parseExpr(input, vars) {
  match tokenize(input) {
    ok(tokens) => {
      let p = Parser { tokens: tokens, pos: 0 }
      match parseAddSub(p, vars) {
        ok(result) => {
          let final = peek(p)
          if final.type == "eof" {
            return ok(result)
          } else {
            return err("syntax")
          }
        }
        err(e) => return err(e)
      }
    }
    err(e) => return err(e)
  }
}

fn formatNumber(n) {
  if n == floor(n) {
    return str(n)
  } else {
    let absN = if n < 0 { 0 - n } else { n }
    let s = ""
    if n < 0 {
      s = "-"
    }

    if absN >= 1 {
      let intPart = floor(absN)
      let intStr = str(intPart)
      let intDigits = len(intStr)
      if intDigits >= 10 {
        s = s + slice(intStr, 0, 10)
        return s
      } else {
        let decPart = absN - intPart
        let decPlaces = 10 - intDigits
        let scaled = decPart * 10000000000
        let rounded = round(scaled, 0)
        let decStr = str(floor(rounded))
        while len(decStr) < decPlaces {
          decStr = "0" + decStr
        }
        s = s + intStr + "." + decStr
        let i = len(s) - 1
        while i >= 0 and s[i] == "0" {
          i = i - 1
        }
        if s[i] == "." {
          i = i - 1
        }
        s = slice(s, 0, i + 1)
        return s
      }
    } else {
      s = s + "0."
      let scaled = absN * 10000000000
      let rounded = round(scaled, 0)
      let digStr = str(floor(rounded))
      while len(digStr) < 10 {
        digStr = "0" + digStr
      }
      s = s + digStr
      let i = len(s) - 1
      while i >= 0 and s[i] == "0" {
        i = i - 1
      }
      s = slice(s, 0, i + 1)
      return s
    }
  }
}

let lines = lines(args()[0])
let vars = {}
let lineNum = 0

for line in lines {
  lineNum = lineNum + 1

  if trim(line) == "" {
    continue
  }

  let parts = split(line, "=")
  if len(parts) != 2 {
    print("error line ${lineNum}: syntax")
    return
  }

  let name = trim(parts[0])
  let exprStr = trim(parts[1])

  if name == "" {
    print("error line ${lineNum}: syntax")
    return
  }

  for c in split(name, "") {
    if not ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_") {
      print("error line ${lineNum}: syntax")
      return
    }
  }

  if name[0] >= "0" and name[0] <= "9" {
    print("error line ${lineNum}: syntax")
    return
  }

  match parseExpr(exprStr, vars) {
    ok(result) => {
      vars[name] = result
    }
    err(e) => {
      if startsWith(e, "unknown variable") {
        print("error line ${lineNum}: ${e}")
      } else if e == "division by zero" {
        print("error line ${lineNum}: division by zero")
      } else {
        print("error line ${lineNum}: syntax")
      }
      return
    }
  }
}

let sortedKeys = sort(keys(vars))
for key in sortedKeys {
  let val = vars[key]
  print("${key} = ${formatNumber(val)}")
}
