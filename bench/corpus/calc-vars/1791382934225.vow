fn isValidName(s) {
  if len(s) == 0 {
    return false
  }
  let first = s[0]
  if first >= "0" and first <= "9" {
    return false
  }
  for c in split(s, "") {
    if not ((c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or (c >= "0" and c <= "9") or c == "_") {
      return false
    }
  }
  return true
}

struct Token {
  type,
  value
}

fn tokenize(s) {
  let tokens = []
  let chars = split(s, "")
  let i = 0

  while i < len(chars) {
    let c = chars[i]
    if c == " " {
      i = i + 1
    } else if c == "(" {
      push(tokens, Token { type: "lparen", value: "(" })
      i = i + 1
    } else if c == ")" {
      push(tokens, Token { type: "rparen", value: ")" })
      i = i + 1
    } else if c == "+" or c == "-" or c == "*" or c == "/" {
      push(tokens, Token { type: "op", value: c })
      i = i + 1
    } else if c >= "0" and c <= "9" {
      let num_str = ""
      while i < len(chars) and ((chars[i] >= "0" and chars[i] <= "9") or chars[i] == ".") {
        num_str = num_str + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "num", value: num_str })
    } else if (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_" {
      let var_str = ""
      while i < len(chars) and ((chars[i] >= "a" and chars[i] <= "z") or (chars[i] >= "A" and chars[i] <= "Z") or chars[i] == "_" or (chars[i] >= "0" and chars[i] <= "9")) {
        var_str = var_str + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "var", value: var_str })
    } else {
      return err("syntax")
    }
  }

  push(tokens, Token { type: "eof", value: "" })
  return ok(tokens)
}

struct Parser {
  tokens,
  pos,
  vars
}

fn peek(p) {
  return p.tokens[p.pos]
}

fn advance(p) {
  p.pos = p.pos + 1
}

fn parseExpr(p) {
  let left = parseTerm(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "+" or tok.value == "-") {
      let op = tok.value
      advance(p)
      let right = parseTerm(p)?
      if op == "+" {
        left = left + right
      } else {
        left = left - right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseTerm(p) {
  let left = parseFactor(p)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "*" or tok.value == "/") {
      let op = tok.value
      advance(p)
      let right = parseFactor(p)?
      if op == "*" {
        left = left * right
      } else {
        if right == 0 {
          return err("division by zero")
        }
        left = left / right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseFactor(p) {
  let tok = peek(p)

  if tok.type == "op" and tok.value == "-" {
    advance(p)
    let val = parseFactor(p)?
    return ok(0 - val)
  } else if tok.type == "num" {
    advance(p)
    let val = num(tok.value)?
    return ok(val)
  } else if tok.type == "var" {
    advance(p)
    if has(p.vars, tok.value) {
      return ok(p.vars[tok.value])
    } else {
      return err("unknown variable " + tok.value)
    }
  } else if tok.type == "lparen" {
    advance(p)
    let val = parseExpr(p)?
    let close = peek(p)
    if close.type != "rparen" {
      return err("syntax")
    }
    advance(p)
    return ok(val)
  } else {
    return err("syntax")
  }
}

fn main() {
  let input = args()[0]
  let all_lines = split(input, "\n")
  let vars = {}

  for line_idx in range(0, len(all_lines)) {
    let line = all_lines[line_idx]
    let trimmed = trim(line)

    if len(trimmed) == 0 {
      continue
    }

    match indexOf(trimmed, "=") {
      ok(eq_idx) => {
        let name = trim(slice(trimmed, 0, eq_idx))
        let expr_str = trim(slice(trimmed, eq_idx + 1, len(trimmed)))

        if not isValidName(name) {
          print("error line " + str(line_idx + 1) + ": syntax")
          return ok(true)
        }

        match tokenize(expr_str) {
          ok(tokens) => {
            let p = Parser { tokens: tokens, pos: 0, vars: vars }
            match parseExpr(p) {
              ok(result) => {
                let final = peek(p)
                if final.type == "eof" {
                  vars[name] = result
                } else {
                  print("error line " + str(line_idx + 1) + ": syntax")
                  return ok(true)
                }
              }
              err(e) => {
                if startsWith(e, "unknown variable") {
                  print("error line " + str(line_idx + 1) + ": " + e)
                } else if e == "division by zero" {
                  print("error line " + str(line_idx + 1) + ": division by zero")
                } else {
                  print("error line " + str(line_idx + 1) + ": syntax")
                }
                return ok(true)
              }
            }
          }
          err(e) => {
            print("error line " + str(line_idx + 1) + ": syntax")
            return ok(true)
          }
        }
      }
      err(_) => {
        print("error line " + str(line_idx + 1) + ": syntax")
        return ok(true)
      }
    }
  }

  let sorted_names = sort(keys(vars))
  for name in sorted_names {
    let val = vars[name]
    let is_int = val == floor(val)
    let formatted = if is_int {
      str(floor(val))
    } else {
      str(val)
    }
    print("${name} = ${formatted}")
  }

  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
