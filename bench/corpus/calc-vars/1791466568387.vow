fn isNameStart(c) {
  return (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or c == "_"
}

fn isNameChar(c) {
  return isNameStart(c) or (c >= "0" and c <= "9")
}

struct Token {
  type,
  value
}

fn tokenize(s) {
  let tokens = []
  let chars = split(s, "")
  let i = 0
  while i < len(chars) {
    let c = chars[i]
    if c == " " {
      i = i + 1
    } else if c == "(" {
      push(tokens, Token { type: "lparen", value: "(" })
      i = i + 1
    } else if c == ")" {
      push(tokens, Token { type: "rparen", value: ")" })
      i = i + 1
    } else if c == "+" or c == "-" or c == "*" or c == "/" {
      push(tokens, Token { type: "op", value: c })
      i = i + 1
    } else if c >= "0" and c <= "9" {
      let num_str = ""
      while i < len(chars) and ((chars[i] >= "0" and chars[i] <= "9") or chars[i] == ".") {
        num_str = num_str + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "num", value: num_str })
    } else if isNameStart(c) {
      let name = ""
      while i < len(chars) and isNameChar(chars[i]) {
        name = name + chars[i]
        i = i + 1
      }
      push(tokens, Token { type: "var", value: name })
    } else {
      return err("syntax")
    }
  }
  push(tokens, Token { type: "eof", value: "" })
  return ok(tokens)
}

struct Parser {
  tokens,
  pos
}

fn peek(p) {
  return p.tokens[p.pos]
}

fn advance(p) {
  p.pos = p.pos + 1
}

fn parseExpr(p, vars) {
  let left = parseTerm(p, vars)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "+" or tok.value == "-") {
      let op = tok.value
      advance(p)
      let right = parseTerm(p, vars)?
      if op == "+" {
        left = left + right
      } else {
        left = left - right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseTerm(p, vars) {
  let left = parseFactor(p, vars)?
  while true {
    let tok = peek(p)
    if tok.type == "op" and (tok.value == "*" or tok.value == "/") {
      let op = tok.value
      advance(p)
      let right = parseFactor(p, vars)?
      if op == "*" {
        left = left * right
      } else {
        if right == 0 {
          return err("division by zero")
        }
        left = left / right
      }
    } else {
      break
    }
  }
  return ok(left)
}

fn parseFactor(p, vars) {
  let tok = peek(p)
  if tok.type == "num" {
    advance(p)
    let val = num(tok.value)?
    return ok(val)
  } else if tok.type == "var" {
    advance(p)
    if has(vars, tok.value) {
      return ok(vars[tok.value])
    } else {
      return err("unknown variable ${tok.value}")
    }
  } else if tok.type == "lparen" {
    advance(p)
    let val = parseExpr(p, vars)?
    let close = peek(p)
    if close.type != "rparen" {
      return err("syntax")
    }
    advance(p)
    return ok(val)
  } else if tok.type == "op" and tok.value == "-" {
    advance(p)
    let val = parseFactor(p, vars)?
    return ok(0 - val)
  } else {
    return err("syntax")
  }
}

fn formatNumber(val) {
  if val == floor(val) {
    return str(floor(val))
  } else {
    return str(sig(val, 10))
  }
}

fn processLine(line, lineNum, vars) {
  let trimmed = trim(line)
  if len(trimmed) == 0 { return ok(false) }

  let parts = split(line, "=")
  if len(parts) != 2 {
    return err("error line ${lineNum}: syntax")
  }

  let name = trim(parts[0])
  let exprStr = trim(parts[1])

  if len(name) == 0 or not isNameStart(name[0]) {
    return err("error line ${lineNum}: syntax")
  }
  for i in range(0, len(name)) {
    if not isNameChar(name[i]) {
      return err("error line ${lineNum}: syntax")
    }
  }

  match tokenize(exprStr) {
    ok(tokens) => {
      let p = Parser { tokens: tokens, pos: 0 }
      match parseExpr(p, vars) {
        ok(result) => {
          let final = peek(p)
          if final.type == "eof" {
            vars[name] = result
            return ok(true)
          } else {
            return err("error line ${lineNum}: syntax")
          }
        }
        err(e) => {
          if startsWith(e, "unknown variable") {
            return err("error line ${lineNum}: ${e}")
          } else if e == "division by zero" {
            return err("error line ${lineNum}: division by zero")
          } else {
            return err("error line ${lineNum}: syntax")
          }
        }
      }
    }
    err(e) => {
      return err("error line ${lineNum}: syntax")
    }
  }
}

fn main() {
  let input = args()[0]
  let lines_list = split(input, "\n")

  let vars = {}

  for i in range(0, len(lines_list)) {
    let lineNum = i + 1
    let line = lines_list[i]

    match processLine(line, lineNum, vars) {
      ok(processed) => {
        if not processed {
          continue
        }
      }
      err(e) => {
        print(e)
        return ok(true)
      }
    }
  }

  let names = sort(keys(vars))
  for name in names {
    let val = vars[name]
    print("${name} = ${formatNumber(val)}")
  }

  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
