fn isDigit(c) {
  return c >= "0" and c <= "9"
}

fn isRomanChar(c) {
  return c == "I" or c == "V" or c == "X" or c == "L" or c == "C" or c == "D" or c == "M"
}

fn romanToNum(s) {
  // Check if all chars are valid Roman
  for i in range(0, len(s)) {
    if not isRomanChar(s[i]) {
      return err("invalid")
    }
  }

  // Parse with strict validation
  let total = 0
  let i = 0

  while i < len(s) {
    let c = s[i]

    if c == "M" {
      total = total + 1000
      i = i + 1
    } else if c == "D" {
      if i + 1 < len(s) and (s[i + 1] == "M") {
        return err("invalid")
      }
      total = total + 500
      i = i + 1
    } else if c == "C" {
      if i + 1 < len(s) {
        let next = s[i + 1]
        if next == "M" {
          total = total + 900
          i = i + 2
        } else if next == "D" {
          total = total + 400
          i = i + 2
        } else {
          total = total + 100
          i = i + 1
        }
      } else {
        total = total + 100
        i = i + 1
      }
    } else if c == "L" {
      if i + 1 < len(s) and (s[i + 1] == "C" or s[i + 1] == "D" or s[i + 1] == "M") {
        return err("invalid")
      }
      total = total + 50
      i = i + 1
    } else if c == "X" {
      if i + 1 < len(s) {
        let next = s[i + 1]
        if next == "C" {
          total = total + 90
          i = i + 2
        } else if next == "L" {
          total = total + 40
          i = i + 2
        } else {
          total = total + 10
          i = i + 1
        }
      } else {
        total = total + 10
        i = i + 1
      }
    } else if c == "V" {
      if i + 1 < len(s) and (s[i + 1] == "X" or s[i + 1] == "L" or s[i + 1] == "C" or s[i + 1] == "D" or s[i + 1] == "M") {
        return err("invalid")
      }
      total = total + 5
      i = i + 1
    } else if c == "I" {
      if i + 1 < len(s) {
        let next = s[i + 1]
        if next == "X" {
          total = total + 9
          i = i + 2
        } else if next == "V" {
          total = total + 4
          i = i + 2
        } else {
          total = total + 1
          i = i + 1
        }
      } else {
        total = total + 1
        i = i + 1
      }
    }
  }

  return ok(total)
}

fn numToRoman(n) {
  let result = ""
  let remaining = n

  // Thousands
  let thousands = floor(remaining / 1000)
  let i = 0
  while i < thousands {
    result = result + "M"
    i = i + 1
  }
  remaining = remaining - thousands * 1000

  // Hundreds
  let hundreds = floor(remaining / 100)
  if hundreds == 9 {
    result = result + "CM"
  } else if hundreds >= 5 {
    result = result + "D"
    let j = 0
    while j < hundreds - 5 {
      result = result + "C"
      j = j + 1
    }
  } else if hundreds == 4 {
    result = result + "CD"
  } else {
    let j = 0
    while j < hundreds {
      result = result + "C"
      j = j + 1
    }
  }
  remaining = remaining - hundreds * 100

  // Tens
  let tens = floor(remaining / 10)
  if tens == 9 {
    result = result + "XC"
  } else if tens >= 5 {
    result = result + "L"
    let j = 0
    while j < tens - 5 {
      result = result + "X"
      j = j + 1
    }
  } else if tens == 4 {
    result = result + "XL"
  } else {
    let j = 0
    while j < tens {
      result = result + "X"
      j = j + 1
    }
  }
  remaining = remaining - tens * 10

  // Ones
  let ones = remaining
  if ones == 9 {
    result = result + "IX"
  } else if ones >= 5 {
    result = result + "V"
    let j = 0
    while j < ones - 5 {
      result = result + "I"
      j = j + 1
    }
  } else if ones == 4 {
    result = result + "IV"
  } else {
    let j = 0
    while j < ones {
      result = result + "I"
      j = j + 1
    }
  }

  return ok(result)
}

fn main() {
  let argv = args()
  let input = match get(argv, 0) { ok(s) => s err(e) => "" }

  if input == "" {
    print("error")
    return
  }

  // Check if it's a number (all digits)
  let isNum = true
  for i in range(0, len(input)) {
    if not isDigit(input[i]) {
      isNum = false
      break
    }
  }

  if isNum {
    // Parse as number
    match num(input) {
      ok(n) => {
        // Check for leading zeros
        if len(input) > 1 and input[0] == "0" {
          print("error")
        } else if n < 1 or n > 3999 {
          print("error")
        } else {
          match numToRoman(n) {
            ok(roman) => print(roman)
            err(e) => print("error")
          }
        }
      }
      err(e) => print("error")
    }
  } else {
    // Try to parse as Roman
    match romanToNum(input) {
      ok(n) => {
        // Verify by converting back to Roman and checking it matches
        match numToRoman(n) {
          ok(canonical) => {
            if canonical == input {
              print(str(n))
            } else {
              print("error")
            }
          }
          err(e) => print("error")
        }
      }
      err(e) => print("error")
    }
  }
}

main()
