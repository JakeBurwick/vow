fn main() {
  let log = args()[0]
  let lines = split(log, "\n")

  let errorCount = 0
  let warnCount = 0
  let infoCount = 0
  let malformedCount = 0
  let errorModules = {}

  for line in lines {
    let trimmed = trim(line)
    if trimmed == "" {
      continue
    }

    let parts = split(trimmed, " ")
    if len(parts) < 3 {
      malformedCount = malformedCount + 1
      continue
    }

    let level = parts[0]
    let module = parts[1]

    if level == "ERROR" {
      errorCount = errorCount + 1
      let newCount = match get(errorModules, module) {
        ok(count) => count + 1
        err(_) => 1
      }
      errorModules[module] = newCount
    } else if level == "WARN" {
      warnCount = warnCount + 1
    } else if level == "INFO" {
      infoCount = infoCount + 1
    } else {
      malformedCount = malformedCount + 1
    }
  }

  // Print levels in order: ERROR, WARN, INFO
  if errorCount > 0 {
    print("ERROR: ${errorCount}")
  }
  if warnCount > 0 {
    print("WARN: ${warnCount}")
  }
  if infoCount > 0 {
    print("INFO: ${infoCount}")
  }

  // Find worst module
  if errorCount > 0 {
    let modules = sort(keys(errorModules))
    let maxCount = 0
    for mod in modules {
      let count = errorModules[mod]
      if count > maxCount {
        maxCount = count
      }
    }

    let worst = ""
    for mod in modules {
      let count = errorModules[mod]
      if count == maxCount {
        worst = mod
        break
      }
    }

    print("worst module: ${worst}")
  } else {
    print("worst module: none")
  }

  print("malformed: ${malformedCount}")
}

main()
