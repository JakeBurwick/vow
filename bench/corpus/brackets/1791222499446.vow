fn isOpeningBracket(c) {
  return c == "(" or c == "[" or c == "{"
}

fn isClosingBracket(c) {
  return c == ")" or c == "]" or c == "}"
}

fn matches(open, close) {
  if open == "(" and close == ")" {
    return true
  }
  if open == "[" and close == "]" {
    return true
  }
  if open == "{" and close == "}" {
    return true
  }
  return false
}

fn checkBrackets(s) {
  let stack = []
  let chars = split(s, "")

  for c in chars {
    if isOpeningBracket(c) {
      push(stack, c)
    } else if isClosingBracket(c) {
      match pop(stack) {
        ok(top) => {
          if not matches(top, c) {
            return false
          }
        }
        err(e) => {
          return false
        }
      }
    }
  }

  return len(stack) == 0
}

let args_list = args()
let input = match get(args_list, 0) {
  ok(s) => s
  err(e) => ""
}

if checkBrackets(input) {
  print("yes")
} else {
  print("no")
}
