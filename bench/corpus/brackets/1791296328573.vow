fn isMatching(open, close) {
  if open == "(" {
    return close == ")"
  }
  if open == "[" {
    return close == "]"
  }
  if open == "{" {
    return close == "}"
  }
  return false
}

fn isBalanced(s) {
  let stack = []
  for c in split(s, "") {
    if c == "(" or c == "[" or c == "{" {
      push(stack, c)
    } else if c == ")" or c == "]" or c == "}" {
      match pop(stack) {
        ok(open) => {
          if not isMatching(open, c) {
            return false
          }
        }
        err(_) => {
          return false
        }
      }
    }
  }
  return len(stack) == 0
}

let input = args()[0]
if isBalanced(input) {
  print("yes")
} else {
  print("no")
}
