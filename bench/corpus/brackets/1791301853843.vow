// brackets: check if brackets are balanced and properly nested

fn isBalanced(s) {
  let stack = []
  for c in split(s, "") {
    if c == "(" or c == "[" or c == "{" {
      push(stack, c)
    } else if c == ")" or c == "]" or c == "}" {
      if len(stack) == 0 {
        return false
      }
      match pop(stack) {
        ok(top) => {
          if (c == ")" and top != "(") or (c == "]" and top != "[") or (c == "}" and top != "{") {
            return false
          }
        }
        err(e) => {
          return false
        }
      }
    }
  }
  return len(stack) == 0
}

let input = args()[0]
if isBalanced(input) {
  print("yes")
} else {
  print("no")
}
