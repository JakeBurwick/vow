fn isOpenBracket(c) {
  return c == "(" or c == "[" or c == "{"
}

fn matches(open, close) {
  return (open == "(" and close == ")") or
         (open == "[" and close == "]") or
         (open == "{" and close == "}")
}

fn checkBrackets(s) {
  let stack = []
  let chars = split(s, "")

  for c in chars {
    if isOpenBracket(c) {
      push(stack, c)
    } else {
      if len(stack) == 0 {
        return false
      }
      match pop(stack) {
        ok(top) => {
          if not matches(top, c) {
            return false
          }
        }
        err(e) => return false
      }
    }
  }

  return len(stack) == 0
}

let args_list = args()
let input = match get(args_list, 0) {
  ok(s) => s
  err(e) => ""
}

if checkBrackets(input) {
  print("yes")
} else {
  print("no")
}
