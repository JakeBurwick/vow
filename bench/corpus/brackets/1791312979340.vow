fn isBalanced(s) {
  let stack = []
  let chars = split(s, "")

  for c in chars {
    match c {
      "(" => push(stack, "(")
      "[" => push(stack, "[")
      "{" => push(stack, "{")
      ")" => {
        match pop(stack) {
          ok(v) => {
            if v != "(" {
              return ok(false)
            }
          }
          err(e) => return ok(false)
        }
      }
      "]" => {
        match pop(stack) {
          ok(v) => {
            if v != "[" {
              return ok(false)
            }
          }
          err(e) => return ok(false)
        }
      }
      "}" => {
        match pop(stack) {
          ok(v) => {
            if v != "{" {
              return ok(false)
            }
          }
          err(e) => return ok(false)
        }
      }
      _ => {}
    }
  }

  if len(stack) == 0 {
    return ok(true)
  } else {
    return ok(false)
  }
}

let s = args()[0]
match isBalanced(s) {
  ok(result) => {
    if result {
      print("yes")
    } else {
      print("no")
    }
  }
  err(e) => print("no")
}
