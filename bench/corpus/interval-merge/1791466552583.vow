struct Interval { start, end }

fn parseInterval(s) {
  let parts = split(s, "-")
  if len(parts) != 2 {
    return err("bad interval " + s)
  }

  match int(parts[0]) {
    ok(a) => {
      match int(parts[1]) {
        ok(b) => {
          if a > b {
            return err("bad interval " + s)
          }
          return ok(Interval { start: a, end: b })
        }
        err(e) => return err("bad interval " + s)
      }
    }
    err(e) => return err("bad interval " + s)
  }
}

fn main() {
  let input = args()[0]

  if input == "" {
    print("")
    return ok(true)
  }

  let pieces = split(input, ",")
  let intervals = []

  for piece in pieces {
    match parseInterval(piece) {
      ok(interval) => push(intervals, interval)
      err(e) => {
        print("error: " + e)
        return ok(true)
      }
    }
  }

  intervals = sortBy(intervals, i => i.start)

  // Merge overlapping/touching intervals
  let merged = []

  if len(intervals) > 0 {
    let current = intervals[0]

    for i in range(1, len(intervals)) {
      let next = intervals[i]

      if next.start <= current.end + 1 {
        // Merge
        if next.end > current.end {
          current = Interval { start: current.start, end: next.end }
        }
      } else {
        // No merge
        push(merged, current)
        current = next
      }
    }

    push(merged, current)
  }

  // Format output
  let parts = []
  for interval in merged {
    push(parts, str(interval.start) + "-" + str(interval.end))
  }

  print(join(parts, ","))
  return ok(true)
}

match main() {
  ok(v) => {}
  err(e) => print(e)
}
