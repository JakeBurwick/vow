// Water bills: accounts, usage and billed amount per zone, total, highest usage. Fails loudly on any row it cannot read.
struct Account { id, zone, usage, cost }

fn money(c) { return "${floor(c / 100)}.${padLeft(str(c % 100), 2, "0")}" }

fn bill(u) { return 350 + 120 * min(u, 10) + 205 * max(u - 10, 0) }

fn reading(s) {
  if not matches(s, `^[0-9]+$`) { return err("not a whole number") }
  return int(s)
}

fn report(text) {
  let ls = split(text, "\n")
  if len(ls) > 0 and ls[len(ls) - 1] == "" { ls = slice(ls, 0, len(ls) - 1) }
  if len(ls) == 0 { return err("empty input, no header") }
  if ls[0] != "account,zone,previous,current" { return err("bad header: ${ls[0]}") }
  let rows = []
  let seen = {}
  let n = 1
  for line in slice(ls, 1, len(ls)) {
    n = n + 1
    let f = split(line, ",")
    if len(f) != 4 { return err("line ${n}: expected 4 fields, got ${len(f)}") }
    if f[0] == "" { return err("line ${n}: missing account") }
    if f[1] == "" { return err("line ${n}: missing zone") }
    let prev = match reading(f[2]) { ok(v) => v err(e) => { return err("line ${n}: bad previous reading ${f[2]}") } }
    let cur = match reading(f[3]) { ok(v) => v err(e) => { return err("line ${n}: bad current reading ${f[3]}") } }
    let u = cur - prev
    if u < 0 { return err("line ${n}: current reading ${f[3]} is below the previous reading ${f[2]}") }
    if has(seen, f[0]) { return err("line ${n}: account ${f[0]} appears twice") }
    seen[f[0]] = true
    push(rows, Account { id: f[0], zone: f[1], usage: u, cost: bill(u) })
  }
  if len(rows) == 0 { return err("no accounts, there is no highest usage") }
  let cnt = {}
  let use = {}
  let cost = {}
  let total = 0
  for r in rows {
    cnt[r.zone] = match get(cnt, r.zone) { ok(v) => v err(e) => 0 } + 1
    use[r.zone] = match get(use, r.zone) { ok(v) => v err(e) => 0 } + r.usage
    cost[r.zone] = match get(cost, r.zone) { ok(v) => v err(e) => 0 } + r.cost
    total = total + r.cost
  }
  let out = []
  for z in sort(keys(cnt)) { push(out, "${z} ${cnt[z]} ${use[z]} ${money(cost[z])}") }
  push(out, "total ${money(total)}")
  let top = sortBy(sortBy(rows, r => r.id), r => -r.usage)[0]
  push(out, "highest ${top.id} ${top.usage}")
  return ok(out)
}

let input = match readAll() { ok(t) => t err(e) => "" }
match report(input) {
  ok(out) => { for l in out { print(l) } }
  err(e) => print("error: ${e}")
}
