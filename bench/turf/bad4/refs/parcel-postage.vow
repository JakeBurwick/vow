// Parcel postage: parcels, weight and postage per destination, total, heaviest parcel. Fails loudly on any row it cannot read.
struct Parcel { id, dest, g, cost }

fn grams(s) {
  let m = find(s, `^([0-9]+)(?:\.([0-9]{1,3}))?$`)?
  let frac = 0
  if m[2] != "" { frac = int(padRight(m[2], 3, "0"))? }
  return ok(int(m[1])? * 1000 + frac)
}

fn money(c) { return "${floor(c / 100)}.${padLeft(str(c % 100), 2, "0")}" }

fn kilos(g) { return "${floor(g / 1000)}.${padLeft(str(g % 1000), 3, "0")}" }

fn report(text) {
  let ls = split(text, "\n")
  if len(ls) > 0 and ls[len(ls) - 1] == "" { ls = slice(ls, 0, len(ls) - 1) }
  if len(ls) == 0 { return err("empty input, no header") }
  if ls[0] != "parcel,dest,weight" { return err("bad header: ${ls[0]}") }
  let rows = []
  let n = 1
  for line in slice(ls, 1, len(ls)) {
    n = n + 1
    let f = split(line, ",")
    if len(f) != 3 { return err("line ${n}: expected 3 fields, got ${len(f)}") }
    if f[0] == "" { return err("line ${n}: missing parcel id") }
    if f[1] == "" { return err("line ${n}: missing dest") }
    let g = match grams(f[2]) { ok(v) => v err(e) => { return err("line ${n}: bad weight ${f[2]}") } }
    push(rows, Parcel { id: f[0], dest: f[1], g: g, cost: 400 + 150 * ceil(g / 1000) })
  }
  if len(rows) == 0 { return err("no parcels, there is no heaviest parcel") }
  let cnt = {}
  let wt = {}
  let cost = {}
  let total = 0
  for r in rows {
    cnt[r.dest] = match get(cnt, r.dest) { ok(v) => v err(e) => 0 } + 1
    wt[r.dest] = match get(wt, r.dest) { ok(v) => v err(e) => 0 } + r.g
    cost[r.dest] = match get(cost, r.dest) { ok(v) => v err(e) => 0 } + r.cost
    total = total + r.cost
  }
  let out = []
  for d in sort(keys(cnt)) { push(out, "${d} ${cnt[d]} ${kilos(wt[d])} ${money(cost[d])}") }
  push(out, "total ${money(total)}")
  let top = sortBy(sortBy(rows, r => r.id), r => -r.g)[0]
  push(out, "heaviest ${top.id}")
  return ok(out)
}

let input = match readAll() { ok(t) => t err(e) => "" }
match report(input) {
  ok(out) => { for l in out { print(l) } }
  err(e) => print("error: ${e}")
}
