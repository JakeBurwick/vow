// Parking garage: stays, minutes and fees per plate, total, longest stay. Fails loudly on any line it cannot read.
struct Stay { plate, start, mins }

fn money(c) { return "${floor(c / 100)}.${padLeft(str(c % 100), 2, "0")}" }

fn fee(mins) { return 250 * ceil(mins / 60) }

fn report(text) {
  let ls = split(text, "\n")
  if len(ls) > 0 and ls[len(ls) - 1] == "" { ls = slice(ls, 0, len(ls) - 1) }
  let inside = {}
  let stays = []
  let n = 0
  for line in ls {
    n = n + 1
    let f = split(line, " ")
    if len(f) != 4 { return err("line ${n}: expected 4 fields, got ${len(f)}") }
    if not matches(f[0], `^[0-9]{4}-[0-9]{2}-[0-9]{2}$`) { return err("line ${n}: bad date ${f[0]}") }
    if not matches(f[1], `^([01][0-9]|2[0-3]):[0-5][0-9]$`) { return err("line ${n}: bad time ${f[1]}") }
    let ms = match parseDate("${f[0]}T${f[1]}") { ok(v) => v err(e) => { return err("line ${n}: invalid date ${f[0]}") } }
    let m = ms / 60000
    let plate = f[3]
    if plate == "" { return err("line ${n}: missing plate") }
    if f[2] == "IN" {
      if has(inside, plate) { return err("line ${n}: ${plate} drives in but is already inside") }
      inside[plate] = m
    } else if f[2] == "OUT" {
      if not has(inside, plate) { return err("line ${n}: ${plate} drives out but never drove in") }
      let start = inside[plate]
      let gone = remove(inside, plate)
      if m < start { return err("line ${n}: ${plate} drives out before it drove in") }
      push(stays, Stay { plate: plate, start: start, mins: m - start })
    } else {
      return err("line ${n}: bad event ${f[2]}")
    }
  }
  if len(keys(inside)) > 0 { return err("stay never ended for ${join(sort(keys(inside)), ", ")}") }
  if len(stays) == 0 { return err("no stays, there is no longest stay") }
  let cnt = {}
  let mins = {}
  let cost = {}
  let total = 0
  for s in stays {
    cnt[s.plate] = match get(cnt, s.plate) { ok(v) => v err(e) => 0 } + 1
    mins[s.plate] = match get(mins, s.plate) { ok(v) => v err(e) => 0 } + s.mins
    cost[s.plate] = match get(cost, s.plate) { ok(v) => v err(e) => 0 } + fee(s.mins)
    total = total + fee(s.mins)
  }
  let out = []
  for p in sort(keys(cnt)) { push(out, "${p} ${cnt[p]} ${mins[p]} ${money(cost[p])}") }
  push(out, "total ${money(total)}")
  let best = sortBy(sortBy(sortBy(stays, s => s.plate), s => s.start), s => -s.mins)[0]
  push(out, "longest ${best.plate} ${best.mins}")
  return ok(out)
}

let input = match readAll() { ok(t) => t err(e) => "" }
match report(input) {
  ok(out) => { for l in out { print(l) } }
  err(e) => print("error: ${e}")
}
