// Payroll: pay per employee rounded to the cent, totals and headcount per dept, top earner. Fails loudly on any row it cannot read.
struct Row { emp, dept, pay }

fn hundredths(s) {
  let m = find(s, `^([0-9]+)(?:\.([0-9]{1,2}))?$`)?
  let frac = 0
  if m[2] != "" { frac = int(padRight(m[2], 2, "0"))? }
  return ok(int(m[1])? * 100 + frac)
}

fn money(c) { return "${floor(c / 100)}.${padLeft(str(c % 100), 2, "0")}" }

fn report(text) {
  let ls = split(text, "\n")
  if len(ls) > 0 and ls[len(ls) - 1] == "" { ls = slice(ls, 0, len(ls) - 1) }
  if len(ls) == 0 { return err("empty input, no header") }
  if ls[0] != "employee,dept,hours,rate" { return err("bad header: ${ls[0]}") }
  let rows = []
  let n = 1
  for line in slice(ls, 1, len(ls)) {
    n = n + 1
    let f = split(line, ",")
    if len(f) != 4 { return err("line ${n}: expected 4 fields, got ${len(f)}") }
    if f[0] == "" { return err("line ${n}: missing employee") }
    if f[1] == "" { return err("line ${n}: missing dept") }
    let h = match hundredths(f[2]) { ok(v) => v err(e) => { return err("line ${n}: bad hours ${f[2]}") } }
    let r = match hundredths(f[3]) { ok(v) => v err(e) => { return err("line ${n}: bad rate ${f[3]}") } }
    let p = h * r + 50
    push(rows, Row { emp: f[0], dept: f[1], pay: (p - p % 100) / 100 })
  }
  if len(rows) == 0 { return err("no employees, there is no top earner") }
  let tot = {}
  let cnt = {}
  let total = 0
  for r in rows {
    tot[r.dept] = match get(tot, r.dept) { ok(v) => v err(e) => 0 } + r.pay
    cnt[r.dept] = match get(cnt, r.dept) { ok(v) => v err(e) => 0 } + 1
    total = total + r.pay
  }
  let out = []
  for d in sort(keys(tot)) { push(out, "${d} ${money(tot[d])} ${cnt[d]}") }
  push(out, "total ${money(total)}")
  let top = sortBy(sortBy(rows, r => r.emp), r => -r.pay)[0]
  push(out, "top ${top.emp}")
  return ok(out)
}

let input = match readAll() { ok(t) => t err(e) => "" }
match report(input) {
  ok(out) => { for l in out { print(l) } }
  err(e) => print("error: ${e}")
}
