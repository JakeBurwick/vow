// Help desk log: tickets closed and minutes per agent, open tickets, slowest ticket. Fails loudly on any line it cannot read.
struct Ticket { id, opened, agent, closed, done }
struct Agent { name, n, mins }

fn stamp(s) {
  if not matches(s, `^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$`) { return err("bad time ${s}") }
  let ms = match parseDate(s) { ok(v) => v err(e) => { return err("impossible time ${s}") } }
  return ok(ms / 60000)
}

fn report(text) {
  let ls = split(text, "\n")
  if len(ls) > 0 and ls[len(ls) - 1] == "" { ls = slice(ls, 0, len(ls) - 1) }
  let tickets = {}
  let agents = {}
  let prev = -1
  let started = false
  let n = 0
  for line in ls {
    n = n + 1
    let f = split(line, " ")
    if len(f) < 3 { return err("line ${n}: expected at least 3 fields, got ${len(f)}") }
    let tid = f[1]
    let ev = f[2]
    if ev != "opened" and ev != "assigned" and ev != "closed" { return err("line ${n}: unknown event ${ev}") }
    let want = if ev == "assigned" { 4 } else { 3 }
    if len(f) != want { return err("line ${n}: expected ${want} fields for ${ev}, got ${len(f)}") }
    if tid == "" { return err("line ${n}: missing ticket id") }
    let t = match stamp(f[0]) { ok(v) => v err(e) => { return err("line ${n}: ${e}") } }
    if started and t < prev { return err("line ${n}: time ${f[0]} is earlier than the line before it") }
    started = true
    prev = t
    if ev == "opened" {
      if has(tickets, tid) { return err("line ${n}: ${tid} is opened twice") }
      tickets[tid] = Ticket { id: tid, opened: t, agent: "", closed: 0, done: false }
      continue
    }
    if not has(tickets, tid) { return err("line ${n}: ${tid} was never opened") }
    let tk = tickets[tid]
    if tk.done { return err("line ${n}: ${tid} has an event after it was closed") }
    if ev == "assigned" {
      if f[3] == "" { return err("line ${n}: missing agent") }
      tk.agent = f[3]
      agents[f[3]] = true
    } else {
      if tk.agent == "" { return err("line ${n}: ${tid} is closed without being assigned") }
      tk.closed = t
      tk.done = true
    }
    tickets[tid] = tk
  }
  let closed = filter(values(tickets), tk => tk.done)
  if len(closed) == 0 { return err("no closed tickets, there is no slowest ticket") }
  let out = []
  for a in sort(keys(agents)) {
    let mine = filter(closed, tk => tk.agent == a)
    push(out, "${a} ${len(mine)} ${fold(mine, 0, (s, tk) => s + tk.closed - tk.opened)}")
  }
  push(out, "open ${len(keys(tickets)) - len(closed)}")
  let top = sortBy(sortBy(closed, tk => tk.id), tk => -(tk.closed - tk.opened))[0]
  push(out, "slowest ${top.id} ${top.closed - top.opened}")
  return ok(out)
}

let input = match readAll() { ok(t) => t err(e) => "" }
match report(input) {
  ok(out) => { for l in out { print(l) } }
  err(e) => print("error: ${e}")
}
