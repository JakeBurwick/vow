// the program itself traps on some inputs and loops over steps: each run() has its own budget
fn fib(n) {
  if n < 2 { return n }
  return fib(n - 1) + fib(n - 2)
}
let total = 0
for i in range(0, 2000) { total = total + 1 }
match get(args(), 0) {
  ok(a) => {
    let d = match num(a) { ok(n) => n  err(e) => 1 }
    print(fib(15) / d * 0)
  }
  err(e) => print("fib", fib(15), total)
}
test "a division by zero inside run" { expectEq(run(["0"], ""), "x") }
test "steps reset between runs" {
  expectEq(run([], ""), "fib 610 2000\n")
  expectEq(run([], ""), "fib 610 2000\n")
  expectEq(run(["2"], ""), "0\n")
}
